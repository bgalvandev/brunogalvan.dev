{
  "name": "brunogalvan.dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 3000",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tools": "node --test 'scripts/**/*.spec.mjs'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "og:generate": "node scripts/build/og-image.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "dead-code": "knip",
    "dupes": "jscpd src scripts --config .jscpdrc.json --threshold 0 --ignore \"**/*.spec.*,**/*.test.*\" --no-tips",
    "security:audit": "pnpm audit --audit-level high",
    "check": "pnpm run format:check && pnpm run check:tokens && pnpm run test:tools && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:dist && pnpm run dead-code && pnpm run dupes"
  },
  "dependencies": {
    "astro": "~7.3.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.13.4",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "jscpd": "^5.2.1",
    "knip": "^6.34.0",
    "prettier": "~3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "5.0.0"
  }
}
