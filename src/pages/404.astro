---
import { messages } from '@/i18n/messages';
import { pagePath } from '@/i18n/routes';
import SiteLayout from '@/layouts/site-layout.astro';
const es = messages('es');
const en = messages('en');
---

<SiteLayout
  locale="es"
  title={`404 — ${es.notFound.title}`}
  description={es.notFound.description}
  canonicalPath="/404/"
  noindex
>
  <main id="main" tabindex="-1" class="measure not-found">
    <p class="tag">404</p>
    <h1 class="text-headline">{es.notFound.title}</h1>
    <p class="not-found-text">{es.notFound.description}</p>
    <p class="not-found-text" lang="en">
      {en.notFound.description}
    </p>
    <nav class="tabs" aria-label={es.notFound.navigation}>
      <a class="tab" href={pagePath('home', 'es')} lang="es">
        {es.navigation.home}
      </a>
      <a class="tab" href={pagePath('home', 'en')} lang="en">
        {en.navigation.home}
      </a>
    </nav>
  </main>
</SiteLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding-block: 8rem;
  }
  .not-found h1 {
    margin: 0;
  }
  .not-found-text {
    margin: 0;
    color: var(--muted);
  }
</style>
