---
import { locales, type Locale } from '@/i18n/locales';
import { messages } from '@/i18n/messages';
import { pagePath, segment } from '@/i18n/routes';
import SiteLayout from '@/layouts/site-layout.astro';
import CaseStudyPage, {
  type CaseStudyId,
} from '@/modules/case-study/case-study-page.astro';
import { excerpts } from '@/modules/case-study/excerpts';
// One page per case study and language: /es/proyectos/<slug>/ and
// /en/projects/<slug>/, the parent segment read from its route pair.
export function getStaticPaths() {
  return (Object.keys(excerpts) as CaseStudyId[]).flatMap((id) =>
    locales.map((locale) => ({
      params: { locale, parent: segment('caseStudy', locale), slug: id },
      props: { locale, id },
    })),
  );
}
interface Props {
  locale: Locale;
  id: CaseStudyId;
}
const { locale, id } = Astro.props;
const { meta } = messages(locale).caseStudies[id];
---

<SiteLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonicalPath={pagePath('caseStudy', locale, id)}
  route="caseStudy"
  slug={id}
>
  <CaseStudyPage locale={locale} id={id} />
</SiteLayout>
