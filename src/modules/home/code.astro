---
import Button from '@/components/button.astro';
import CodeWindow from '@/components/code-window.astro';
import Headline from '@/components/headline.astro';
import NumberedSection from '@/components/numbered-section.astro';
import { site } from '@/config/site';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { sectionNumber, sections } from './sections';
import { snippets } from './snippets';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { code } = messages(locale);

const samples = snippets.map((snippet) => ({
  ...snippet,
  ...code.samples[snippet.id],
}));
---

<!-- The language switch is a radio group, so it works without JavaScript: CSS shows the panel whose radio is checked. -->
<NumberedSection
  id="code"
  number={sectionNumber('code')}
  total={sections.length}
  label={code.label}
  locale={locale}
  headingId="code-title"
>
  <div class="code-main">
    <div class="code-stage field-dotted">
      <div class="code-frame ticked">
        <div class="code-windows">
          {samples.map((sample) => (
            <CodeWindow
              code={sample.code}
              lang={sample.lang}
              repository={sample.repository}
              commit={sample.commit}
              path={sample.path}
              class={`code-window-${sample.id}`}
            />
          ))}
        </div>
      </div>
    </div>
    <div class="code-side">
      <div class="code-heading">
        <Headline id="code-title" lines={code.headline} />
        <Button href={site.github} label={code.action} icon="arrow-up-right" />
      </div>
      <fieldset class="code-tabs">
        <legend class="sr-only">{code.tabs}</legend>
        {samples.map((sample, index) => (
          <label class="code-tab">
            <input
              type="radio"
              name="code-sample"
              value={sample.id}
              checked={index === 0}
            />
            <span class="code-tab-title">{sample.title}</span>
            <span class="code-tab-text">{sample.text}</span>
          </label>
        ))}
      </fieldset>
    </div>
  </div>
</NumberedSection>

<style>
  .code-main {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 3rem;
  }
  .code-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40rem;
    padding: 3rem;
  }
  .code-frame {
    width: 100%;
    min-width: 0;
    padding: 1.125rem;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .code-windows {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  /* The checked radio decides which window shows. */
  .code-main:has(input[value='ts']:checked)
    :global(.code-window:not(.code-window-ts)),
  .code-main:has(input[value='php']:checked)
    :global(.code-window:not(.code-window-php)) {
    display: none;
  }
  .code-side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
  }
  .code-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;
  }
  /* The master's vertical process: a dashed track, the checked item marked
     by an accent bar and a square. */
  .code-tabs {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: none;
    border-left: 1px dashed var(--decor);
  }
  .code-tab {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 0 0.75rem 1.75rem;
    cursor: pointer;
  }
  .code-tab input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .code-tab::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 2px;
  }
  .code-tab:has(input:checked)::before {
    background: var(--accent);
  }
  .code-tab:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .code-tab-title {
    color: var(--faint);
    font-size: var(--text-medium);
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
    transition: color 0.2s ease;
  }
  .code-tab:hover .code-tab-title,
  .code-tab:has(input:checked) .code-tab-title {
    color: var(--ink);
  }
  .code-tab-text {
    max-width: 24rem;
    color: var(--faint);
  }
  @media (width < 62rem) {
    .code-main {
      grid-template-columns: 1fr;
    }
    .code-side {
      order: -1;
    }
    .code-stage {
      min-height: auto;
      padding: 1.5rem;
    }
  }
  @media (width < 48rem) {
    .code-stage {
      padding: 0.75rem;
    }
    .code-frame {
      padding: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .code-tab-title {
      transition: none;
    }
  }
</style>
