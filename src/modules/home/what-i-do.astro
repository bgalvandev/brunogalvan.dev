---
import Button from '@/components/button.astro';
import Headline from '@/components/headline.astro';
import NumberedSection from '@/components/numbered-section.astro';
import IsoIcon from '@/components/iso-icon.astro';
import { box, cylinder, extrude } from '@/components/isometric';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { sectionNumber, sections } from './sections';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { whatIDo } = messages(locale);
// One isometric scene per card, in catalog order: stacked layers (a
// platform), two blocks joined (an API between services), a screen on its
// stand (an interface) and a cluster of cylinders (models and their data).
const icons = [
  [
    box(0, 0, 0, 8, 8, 1.6),
    box(0, 0, 2.8, 8, 8, 1.6),
    box(0, 0, 5.6, 8, 8, 1.6),
  ],
  [box(7, 0, 0, 4, 4, 4), box(4, 1.5, 1.5, 3, 1, 1), box(0, 0, 0, 4, 4, 4)],
  [
    box(4, 1, 0, 3, 3, 0.8),
    box(5, 2, 0.8, 1, 1, 2),
    extrude(
      [
        [0, 2.8],
        [11, 2.8],
        [11, 10],
        [0, 10],
      ],
      1.5,
      1,
    ),
  ],
  [
    cylinder(2, 2, 0, 1.8, 4),
    cylinder(6.5, 2, 0, 1.8, 2.5),
    cylinder(2, 6.5, 0, 1.8, 2.5),
    cylinder(6.5, 6.5, 0, 1.8, 5.5),
  ],
];
---

<NumberedSection
  id="what-i-do"
  number={sectionNumber('what-i-do')}
  total={sections.length}
  label={whatIDo.label}
  locale={locale}
  headingId="what-i-do-title"
>
  <div class="value-main">
    <div class="value-heading">
      <Headline id="what-i-do-title" lines={whatIDo.headline} />
      <Button href="#contact" label={whatIDo.action} />
    </div>
    <ol class="value-cards">
      {whatIDo.cards.map((card, index) => (
        <li class="value-card">
          <div class="value-card-content">
            <div class="value-card-top">
              <IsoIcon solids={icons[index] ?? []} class="value-card-icon" />
              <span class="value-card-number" aria-hidden="true">
                <span class="value-card-slashes">//</span>
                {String(index + 1).padStart(3, '0')}
              </span>
            </div>
            <div class="value-card-text">
              <h3 class="value-card-title">{card.title}</h3>
              <div class="value-card-reveal">
                <p class="value-card-description">{card.text}</p>
              </div>
            </div>
          </div>
          <p class="tag">{card.tag}</p>
        </li>
      ))}
    </ol>
  </div>
</NumberedSection>

<style>
  .value-main {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  .value-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
  }
  .value-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .value-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 5rem;
    min-height: 28rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
  }
  .value-card-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .value-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  /* Every drawing sits in the same square, so the titles line up. */
  .value-card :global(.value-card-icon) {
    width: 10rem;
    height: 10rem;
    color: var(--ink);
  }
  /* Without a hover to wait for, the card shows its pixels and its
     description, as the master does below the desktop breakpoint. */
  .value-card :global(.iso-pixel) {
    color: var(--accent);
  }
  .value-card :global(.iso-line) {
    opacity: 0;
  }
  .value-card-number {
    color: var(--muted);
    font-weight: 500;
  }
  .value-card-slashes {
    color: var(--faint);
  }
  .value-card-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .value-card-title {
    margin: 0;
    font-size: var(--text-medium);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
  }
  .value-card-description {
    margin: 0;
    color: var(--muted);
  }
  /* The master's hover, on a desktop with a pointer that can hover: at rest
     a line drawing; on hover the drawing turns to pixels in the accent over
     0.1s, the title takes the accent and the description opens under it over
     0.3s. A keyboard visitor sees every description open, as do touch and
     print, since none of them can hover. */
  @media (width >= 62rem) and (hover: hover) and (pointer: fine) {
    .value-card :global(.iso-line) {
      opacity: 1;
    }
    .value-card :global(.iso-pixel) {
      opacity: 0;
    }
    .value-card-title {
      transition: color 0.3s var(--ease-power1-out);
    }
    .value-card-reveal {
      display: grid;
      grid-template-rows: minmax(0, 0fr);
      overflow: hidden;
      opacity: 0;
      transition:
        grid-template-rows 0.3s var(--ease-power1-out),
        opacity 0.3s var(--ease-power1-out);
    }
    .value-card-description {
      min-height: 0;
    }
    .value-card :global(.iso-icon svg) {
      transition: opacity 0.1s var(--ease-power1-out);
    }
    .value-card:hover .value-card-title {
      color: var(--accent);
    }
    .value-card:hover .value-card-reveal,
    :global(:root:has(:focus-visible)) .value-card-reveal {
      grid-template-rows: minmax(0, 1fr);
      opacity: 1;
    }
    .value-card:hover :global(.iso-line) {
      opacity: 0;
    }
    .value-card:hover :global(.iso-pixel) {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .value-card-title,
    .value-card-reveal,
    .value-card :global(.iso-icon svg) {
      transition: none;
    }
  }
  @media print {
    .value-card-reveal {
      grid-template-rows: minmax(0, 1fr);
      opacity: 1;
    }
  }
  .value-card .tag {
    margin: 0;
  }
  @media (width < 62rem) {
    .value-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (width < 48rem) {
    .value-heading {
      flex-direction: column;
    }
    .value-cards {
      grid-template-columns: 1fr;
    }
    .value-card {
      gap: 2rem;
      min-height: auto;
    }
    .value-card :global(.value-card-icon) {
      width: 7.5rem;
      height: 7.5rem;
    }
  }
</style>
