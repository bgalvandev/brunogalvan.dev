---
// The master's core capabilities, for the stack: three layers as a radio
// group down the left, each opening its tags, its square and its description
// when chosen; the chosen layer's diagram on a dotted pane to the right; and
// a row of three cards below, the first carrying the toolchain as two rows of
// logo chips moving in opposite directions. The group works without
// JavaScript: CSS opens the chosen layer and shows its diagram.
import Headline from '@/components/headline.astro';
import NumberedSection from '@/components/numbered-section.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import TechLogo from '@/components/tech-logo.astro';
import { marks } from '@/components/tech-marks';
import { stack } from '@/data/stack';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import StackDiagram from './stack-diagram.astro';
import { sectionNumber, sections } from './sections';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = messages(locale).stack;
const kinds = ['interfaces', 'services', 'ai'] as const;
// The tools with a mark of their own, split into the two rows of chips:
// the building side above, the running side below.
const withMark = (tools: readonly string[]) =>
  tools.filter((tool) => marks.has(tool));
const rows = [
  withMark([...stack.frontend, ...stack.backend, ...stack.ai]),
  withMark([...stack.data, ...stack.architecture, ...stack.platform]),
];
// Two outline icons in pixels: a ring and two overlapping squares.
const ring = [
  '....####....',
  '..##....##..',
  '.#........#.',
  '.#........#.',
  '#..........#',
  '#..........#',
  '#..........#',
  '#..........#',
  '.#........#.',
  '.#........#.',
  '..##....##..',
  '....####....',
];
const squares = [
  '########....',
  '#......#....',
  '#......#....',
  '#...########',
  '#...#..#...#',
  '#...#..#...#',
  '#...#..#...#',
  '#...#..#...#',
  '########...#',
  '....#......#',
  '....#......#',
  '....########',
];
---

<NumberedSection
  id="stack"
  number={sectionNumber('stack')}
  total={sections.length}
  label={t.label}
  locale={locale}
  headingId="stack-title"
  class="section-deep stack"
  band
>
  <div class="cap">
    <div class="cap-top">
      <div class="cap-left">
        <fieldset class="cap-tabs">
          <legend class="sr-only">{t.tabsLabel}</legend>
          {t.tabs.map((tab, index) => (
            <label class="cap-tab">
              <input
                type="radio"
                name="stack-layer"
                value={kinds[index]}
                checked={index === 0}
              />
              <span class="cap-tab-top">
                <span class="cap-tab-tags">
                  {tab.tags.map((tag) => (
                    <span class="cap-tag">{tag}</span>
                  ))}
                </span>
              </span>
              <span class="cap-tab-main">
                <span class="cap-tab-dot" aria-hidden="true" />
                <span class="cap-tab-title">{tab.title}</span>
                <span class="cap-tab-line" aria-hidden="true" />
                <span class="cap-tab-number" aria-hidden="true">
                  // {String(index + 1).padStart(3, '0')}
                </span>
              </span>
              <span class="cap-tab-bottom">
                <span class="cap-tab-text">{tab.text}</span>
              </span>
            </label>
          ))}
        </fieldset>
        <Headline id="stack-title" lines={t.headline} />
      </div>
      <div class="cap-pane field-dotted" aria-hidden="true">
        {kinds.map((kind) => (
          <StackDiagram
            kind={kind}
            locale={locale}
            class={`cap-diagram cap-diagram-${kind}`}
          />
        ))}
      </div>
    </div>
    <div class="cap-gap" aria-hidden="true"></div>
    <div class="cap-cards">
      <div class="cap-card cap-card-toolchain">
        <div class="cap-card-text">
          <h3 class="cap-card-title">{t.cards.toolchain.title}</h3>
          <p class="cap-card-description">{t.cards.toolchain.text}</p>
        </div>
        <div class="cap-chips" aria-hidden="true">
          {rows.map((row, index) => (
            <div
              class:list={['cap-chip-row', { 'cap-chip-reverse': index > 0 }]}
            >
              {[0, 1].map(() => (
                <ul class="cap-chip-group">
                  {row.map((tool) => (
                    <li class="cap-chip">
                      <TechLogo name={tool} />
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="cap-card">
        <div class="cap-card-text">
          <h3 class="cap-card-title">{t.cards.typed.title}</h3>
          <p class="cap-card-description">{t.cards.typed.text}</p>
        </div>
        <PixelIcon rows={ring} class="cap-card-icon" />
      </div>
      <div class="cap-card">
        <div class="cap-card-text">
          <h3 class="cap-card-title">{t.cards.tested.title}</h3>
          <p class="cap-card-description">{t.cards.tested.text}</p>
        </div>
        <PixelIcon rows={squares} class="cap-card-icon" />
      </div>
    </div>
  </div>
</NumberedSection>

<style>
  /* As in the master, the eyebrow runs over the left column only and the
     pane rises beside it: the room's body is the grid, and the wrappers step
     aside so their parts sit in it. */
  .cap,
  .cap-top {
    display: contents;
  }
  @media (width >= 62rem) {
    .stack > :global(.section-body) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0;
    }
    .stack > :global(.section-body > .eyebrow) {
      grid-area: 1 / 1;
    }
    .cap-left {
      grid-area: 2 / 1;
    }
    .cap-pane {
      grid-area: 1 / 2 / 3 / 3;
      margin-top: 0.625rem;
    }
    .cap-gap {
      grid-area: 3 / 1 / 4 / 3;
    }
    .cap-cards {
      grid-area: 4 / 1 / 5 / 3;
    }
  }
  .cap-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 5rem;
    padding: 5rem 3rem 5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .cap-tabs {
    display: flex;
    flex-direction: column;
    min-height: 20rem;
    margin: 0;
    padding: 0;
    border: none;
  }
  .cap-tab {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-block: 1rem;
    color: var(--faint);
    cursor: pointer;
    transition: color 0.35s ease;
  }
  .cap-tab input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .cap-tab:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .cap-tab:hover,
  .cap-tab:has(input:checked) {
    color: var(--ink);
  }
  /* The chosen layer opens over 0.4s from a slow start, as the master's
     tab does: its tags drop in above the title, its square slides in and
     pushes the title right, and its description opens below. */
  .cap-tab-top,
  .cap-tab-bottom {
    display: grid;
    grid-template-rows: minmax(0, 0fr);
    overflow: hidden;
    transition: grid-template-rows 0.4s var(--ease-power1-in);
  }
  .cap-tab:has(input:checked) .cap-tab-top,
  .cap-tab:has(input:checked) .cap-tab-bottom {
    grid-template-rows: minmax(0, 1fr);
  }
  .cap-tab-tags {
    display: flex;
    gap: 0.5rem;
    min-height: 0;
  }
  .cap-tab:has(input:checked) .cap-tab-tags {
    padding-bottom: 0.5rem;
  }
  .cap-tag {
    padding: 0.2em 0;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }
  .cap-tab-main {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .cap-tab-dot {
    flex: none;
    align-self: center;
    width: 0;
    height: 0.5rem;
    overflow: hidden;
    background: var(--accent);
    transition: width 0.4s var(--ease-power1-in);
  }
  .cap-tab:has(input:checked) .cap-tab-dot {
    width: 0.5rem;
  }
  .cap-tab-dot {
    margin-right: -0.5rem;
  }
  .cap-tab-title {
    font-size: var(--text-medium);
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
  }
  .cap-tab-line {
    flex: 1;
    border-bottom: 1px dashed var(--line);
  }
  .cap-tab-number {
    font-weight: 400;
  }
  .cap-tab-text {
    min-height: 0;
    max-width: 26.5rem;
    padding-top: 0.75rem;
    color: var(--faint);
  }
  /* The pane: one diagram per layer in the same place, the chosen one
     faded in, on dots 16px apart, as the master's videos draw them. */
  .cap-pane {
    display: grid;
    place-items: center;
    min-height: 40rem;
    padding: 3rem 1.5rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-left: 1px solid var(--line);
    background-size: 16px;
  }
  .cap-pane :global(.cap-diagram) {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s;
  }
  .cap:has(input[value='interfaces']:checked) :global(.cap-diagram-interfaces),
  .cap:has(input[value='services']:checked) :global(.cap-diagram-services),
  .cap:has(input[value='ai']:checked) :global(.cap-diagram-ai) {
    opacity: 1;
    visibility: visible;
  }
  /* The cards: the toolchain under the tabs, two short ones under the pane,
     sharing the room's rules. */
  /* The master's junction: a 2rem strip between the pane and the cards,
     the pane's edge running on down through it to the cards. */
  .cap-gap {
    height: 2rem;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(var(--line), var(--line)) 50% 0 / 1px 100%
      no-repeat;
  }
  .cap-cards {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    border-right: 1px solid var(--line);
  }
  .cap-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 18rem;
    padding: 1.5rem;
    border-bottom: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .cap-card-toolchain {
    padding-inline: 0;
    overflow: hidden;
  }
  .cap-card-toolchain .cap-card-text {
    padding-inline: 1.5rem 0;
  }
  .cap-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cap-card-title {
    margin: 0;
    font-size: var(--text-medium);
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
  }
  .cap-card-description {
    max-width: 22rem;
    margin: 0;
    color: var(--faint);
  }
  /* A 64px box, the drawing about 53px inside it, as the master's. */
  .cap-card :global(.cap-card-icon) {
    align-self: flex-end;
    width: 4rem;
    padding: 0.333rem;
    color: var(--faint);
  }
  /* Two rows of logo chips, one moving left and one right, about 72px a
     second; they stop with the pause control and without motion. */
  .cap-chips {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .cap-chip-row {
    display: flex;
    width: max-content;
    animation: cap-chips 40s linear infinite;
  }
  .cap-chip-reverse {
    animation-direction: reverse;
  }
  :global(html[data-motion='paused']) .cap-chip-row {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .cap-chip-row {
      animation: none;
    }
    .cap-tab,
    .cap-tab-top,
    .cap-tab-bottom,
    .cap-tab-dot,
    .cap-pane :global(.cap-diagram) {
      transition: none;
    }
  }
  .cap-chip-group {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0.5rem 0 0;
    list-style: none;
  }
  .cap-chip {
    display: flex;
    align-items: center;
    height: 3rem;
    padding-inline: 1rem;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 1rem;
  }
  @keyframes cap-chips {
    to {
      transform: translateX(-50%);
    }
  }
  /* Below the desktop breakpoint the master leads with the headline, then
     the layers, the pane and the cards, with no junction strip. */
  @media (width < 62rem) {
    .cap-top {
      grid-template-columns: minmax(0, 1fr);
    }
    .cap-left {
      padding: var(--space-small) 0 2rem;
      border-bottom: none;
    }
    .cap-left :global(.headline) {
      order: -1;
    }
    /* The master's pane is square below the desktop breakpoint, its video
       filling it (at half size on a phone). */
    .cap-pane {
      aspect-ratio: 1;
      min-height: 0;
      border-right: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }
    .cap-gap {
      display: none;
    }
    .cap-cards {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .cap-card-toolchain {
      grid-column: 1 / -1;
    }
    .cap-card:nth-child(2) {
      border-left: none;
    }
  }
  /* A diagram is drawn for the desktop pane; a narrower pane shows it
     smaller rather than rearranged. On a phone the two short cards share a
     row above the toolchain, each its drawing, title and line, as the
     master's do. */
  @media (width < 48rem) {
    .cap-pane {
      padding: 0.75rem;
    }
    .cap-pane :global(.dia) {
      zoom: 0.7;
    }
    .cap-card-toolchain {
      order: 1;
    }
    .cap-card,
    .cap-card:nth-child(2) {
      justify-content: flex-start;
      gap: 0.5rem;
      min-height: auto;
      border-left: 1px solid var(--line);
    }
    .cap-card :global(.cap-card-icon) {
      order: -1;
      align-self: flex-start;
      width: 2rem;
      margin-bottom: 1rem;
      padding: 0.167rem;
    }
    .cap-card-title {
      font-size: var(--text-body);
      letter-spacing: var(--text-body--letter-spacing);
    }
    .cap-card-description {
      font-size: var(--text-label);
    }
    .cap-card-text {
      gap: 0.5rem;
    }
  }
  @media (width < 30rem) {
    .cap-pane :global(.dia) {
      zoom: 0.55;
    }
    .cap-card {
      padding: 1rem;
    }
    .cap-card-toolchain {
      padding-inline: 0;
    }
    .cap-card-toolchain .cap-card-text {
      padding-inline: 1rem 0;
    }
  }
</style>
