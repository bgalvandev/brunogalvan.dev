---
import Headline from '@/components/headline.astro';
import NumberedSection from '@/components/numbered-section.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import { stack } from '@/data/stack';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { sectionNumber, sections } from './sections';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = messages(locale).stack;
// One bitmap per group: a pointer in a window, a rack, stacked discs, a
// spark, three layers and a checked box.
const icons = {
  frontend: [
    '############',
    '#..........#',
    '############',
    '#..........#',
    '#...#......#',
    '#...##.....#',
    '#...###....#',
    '#...####...#',
    '#...##.....#',
    '#....#.....#',
    '#..........#',
    '############',
  ],
  backend: [
    '############',
    '#.##.....#.#',
    '#..........#',
    '############',
    '#..........#',
    '#.##.....#.#',
    '#..........#',
    '############',
    '#..........#',
    '#.##.....#.#',
    '#..........#',
    '############',
  ],
  data: [
    '..########..',
    '.#........#.',
    '.##########.',
    '.#........#.',
    '.#........#.',
    '.##########.',
    '.#........#.',
    '.#........#.',
    '.##########.',
    '.#........#.',
    '.#........#.',
    '..########..',
  ],
  ai: [
    '.....##.....',
    '.....##.....',
    '....#..#....',
    '...#....#...',
    '..#......#..',
    '##........##',
    '##........##',
    '..#......#..',
    '...#....#...',
    '....#..#....',
    '.....##.....',
    '.....##.....',
  ],
  architecture: [
    '############',
    '#..........#',
    '############',
    '............',
    '..########..',
    '..#......#..',
    '..########..',
    '............',
    '....####....',
    '....#..#....',
    '....####....',
    '............',
  ],
  platform: [
    '############',
    '#..........#',
    '#.........##',
    '#........#.#',
    '#.......#..#',
    '#.#....#...#',
    '#..#..#....#',
    '#...##.....#',
    '#..........#',
    '#..........#',
    '#..........#',
    '############',
  ],
} as const satisfies Record<keyof typeof stack, readonly string[]>;
const groups = (Object.keys(stack) as (keyof typeof stack)[]).map(
  (group, index) => ({
    id: group,
    number: String(index + 1).padStart(3, '0'),
    title: t.groups[group],
    tools: stack[group],
    icon: icons[group],
  }),
);
---

<NumberedSection
  id="stack"
  number={sectionNumber('stack')}
  total={sections.length}
  label={t.label}
  locale={locale}
  headingId="stack-title"
  band
>
  <div class="stack-main">
    <Headline id="stack-title" lines={t.headline} />
    <ul class="stack-grid">
      {groups.map((group) => (
        <li class="stack-cell">
          <div class="stack-cell-top">
            <h3 class="stack-cell-title">
              <span class="stack-cell-dot" aria-hidden="true" />
              {group.title}
            </h3>
            <span class="stack-cell-line" aria-hidden="true" />
            <span class="stack-cell-number" aria-hidden="true">
              // {group.number}
            </span>
          </div>
          <ul class="stack-tools">
            {group.tools.map((tool) => (
              <li class="tag">{tool}</li>
            ))}
          </ul>
          <PixelIcon rows={group.icon} class="stack-cell-icon" />
        </li>
      ))}
    </ul>
  </div>
</NumberedSection>

<style>
  .stack-main {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  /* Cells share their rules: the grid draws the top and left, each cell its
     right and bottom. */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .stack-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 18rem;
    padding: 1.5rem 1.5rem 6.5rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stack-cell-top {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .stack-cell-title {
    display: flex;
    align-items: baseline;
    margin: 0;
    font-size: var(--text-medium);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
  }
  .stack-cell-dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    background: var(--accent);
    align-self: center;
  }
  .stack-cell-line {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dashed var(--decor);
  }
  .stack-cell-number {
    color: var(--muted);
    white-space: nowrap;
  }
  .stack-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stack-cell :global(.stack-cell-icon) {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    width: 3.5rem;
    color: var(--faint);
  }
  @media (width < 62rem) {
    .stack-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (width < 48rem) {
    .stack-grid {
      grid-template-columns: 1fr;
    }
    .stack-cell {
      min-height: auto;
    }
  }
</style>
