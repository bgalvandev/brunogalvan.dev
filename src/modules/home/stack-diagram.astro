---
import PixelIcon from '@/components/pixel-icon.astro';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
// The three diagrams of the Stack room, drawn in HTML where the master plays
// three videos, each looping in two seconds:
// - interfaces: the master's first video, sized as its pane shows it: two
//   boxes with a bracket behind each, joined to the core, and a channel
//   running down to what is rendered, which lights as the channel arrives,
//   then the rows light one by one;
// - services: the master's third video: from the core the layers of a
//   request come up one by one, each crossed in turn;
// - ai: the master's second video: a card at work widens while a card of
//   documents rises beside it, the documents coming one by one as a bar
//   runs, the core sliding in and the join appearing on the card's corner.
// At the heart of each, the core: a black square holding a code glyph.
// Decoration: the tab beside it carries the words. Every loop is CSS, stops
// with the pause control and is off under reduced motion, where each diagram
// shows its finished state.
interface Props {
  kind: 'interfaces' | 'services' | 'ai';
  locale: Locale;
  class?: string;
}
const { kind, locale, class: className } = Astro.props;
const { diagram } = messages(locale).stack;
// Seven-cell pixel glyphs for the rows.
const glyphs = {
  calendar: [
    '#######',
    '#.#.#.#',
    '#######',
    '#.....#',
    '#.#.#.#',
    '#.....#',
    '#######',
  ],
  receipt: [
    '#######',
    '#.....#',
    '#.###.#',
    '#.....#',
    '#.##..#',
    '#.....#',
    '#.#.#.#',
  ],
  editor: [
    '#######',
    '#.....#',
    '#.###.#',
    '#.....#',
    '#.####.',
    '#.....#',
    '#######',
  ],
  form: [
    '#######',
    '#.....#',
    '#######',
    '.......',
    '#######',
    '#.....#',
    '#######',
  ],
  query: [
    '..###..',
    '.#...#.',
    '#..#..#',
    '#.###.#',
    '#..#..#',
    '.#...#.',
    '..###..',
  ],
  check: [
    '.......',
    '......#',
    '.....#.',
    '#...#..',
    '.#.#...',
    '..#....',
    '.......',
  ],
  server: [
    '#######',
    '#.#...#',
    '#######',
    '#.#...#',
    '#######',
    '#.#...#',
    '#######',
  ],
  window: [
    '#######',
    '#######',
    '#.....#',
    '#.....#',
    '#.....#',
    '#.....#',
    '#######',
  ],
  page: [
    '#####..',
    '#...##.',
    '#....##',
    '#.....#',
    '#.....#',
    '#.....#',
    '#######',
  ],
  code: ['..#...#..', '.#.....#.', '#.......#', '.#.....#.', '..#...#..'],
  chevron: [
    '.......',
    '.......',
    '#.....#',
    '.#...#.',
    '..#.#..',
    '...#...',
    '.......',
  ],
  ring: [
    '..###..',
    '.#...#.',
    '#.....#',
    '#..#..#',
    '#.....#',
    '.#...#.',
    '..###..',
  ],
  layer: [
    '...#...',
    '.##.##.',
    '#.....#',
    '.##.##.',
    '#..#..#',
    '.##.##.',
    '...#...',
  ],
} as const;
const screenIcons = [
  glyphs.calendar,
  glyphs.receipt,
  glyphs.editor,
  glyphs.form,
];
const state = ['Next.js', 'TanStack Query', 'React Hook Form', 'Zod'];
const stateIcons = [glyphs.window, glyphs.query, glyphs.form, glyphs.check];
// The rendered cells carry finer glyphs, thirteen cells a side, so their
// strokes are as light as the master's signal icons.
const outputIcons = [
  [
    '#############',
    '#...........#',
    '#.##........#',
    '#...........#',
    '#############',
    '#...........#',
    '#.##........#',
    '#...........#',
    '#############',
    '#...........#',
    '#.##........#',
    '#...........#',
    '#############',
  ],
  [
    '#############',
    '#.#.#.......#',
    '#############',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#############',
  ],
  [
    '.########....',
    '.#......##...',
    '.#......#.#..',
    '.#......#..#.',
    '.#......####.',
    '.#.........#.',
    '.#.........#.',
    '.#.........#.',
    '.#.........#.',
    '.#.........#.',
    '.#.........#.',
    '.#.........#.',
    '.###########.',
  ],
];
const layerIcons = [glyphs.window, glyphs.check, glyphs.layer, glyphs.server];
---

<div class:list={['dia', `dia-${kind}`, className]}>
  {kind === 'interfaces' && (
    <>
      {[
        {
          side: 'left',
          label: diagram.screens,
          items: diagram.screenItems,
          icons: screenIcons,
        },
        {
          side: 'right',
          label: diagram.state,
          items: state,
          icons: stateIcons,
        },
      ].map((box) => (
        <div class={`dia-box dia-${box.side}`}>
          <p class="dia-label">{box.label}</p>
          <ul class="dia-list">
            {box.items.map((item, index) => (
              <li class="dia-item">
                <PixelIcon rows={box.icons[index] ?? []} class="dia-glyph" />
                {item}
              </li>
            ))}
            <li class="dia-more">
              <span />
              <span />
              <span />
            </li>
          </ul>
        </div>
      ))}
      <div class="dia-core">
        <PixelIcon rows={glyphs.code} class="dia-core-glyph" />
        <span class="dia-flow" />
      </div>
      <div class="dia-out">
        <p class="dia-label">{diagram.output}</p>
        <div class="dia-signals">
          <span class="dia-end" />
          {outputIcons.map((icon, index) => (
            <>
              {index > 0 && <span class="dia-dot" />}
              <span class="dia-cell">
                <PixelIcon rows={icon} class="dia-glyph" />
              </span>
            </>
          ))}
          <span class="dia-end" />
        </div>
      </div>
    </>
  )}
  {kind === 'services' && (
    <>
      <div class="dia-core">
        <PixelIcon rows={glyphs.code} class="dia-core-glyph" />
      </div>
      <span class="dia-stem" />
      <ol class="dia-rows">
        {diagram.layers.map((layer, index) => (
          <li class="dia-row">
            <PixelIcon rows={layerIcons[index] ?? []} class="dia-glyph" />
            <span class="dia-row-name">{layer.name}</span>
            <span class="dia-row-format">{layer.format}</span>
          </li>
        ))}
      </ol>
    </>
  )}
  {kind === 'ai' && (
    <>
      <div class="dia-card dia-card-main">
        <span class="dia-skeleton" />
        <span class="dia-skeleton" />
        <span class="dia-skeleton" />
        <p class="dia-status">
          <span class="dia-spinner" />
          <span class="dia-status-text">{diagram.translating}</span>
        </p>
        <p class="dia-foot">
          <PixelIcon rows={glyphs.chevron} class="dia-glyph" />
          ES
          <PixelIcon name="arrow-right" class="dia-arrow" />
          EN
        </p>
        <div class="dia-core dia-core-small">
          <PixelIcon rows={glyphs.code} class="dia-core-glyph" />
        </div>
      </div>
      <div class="dia-card dia-card-docs">
        <p class="dia-count">
          <PixelIcon rows={glyphs.ring} class="dia-glyph" />
          {diagram.documentsLabel}
          <span class="dia-count-number">{diagram.documents.length}</span>
        </p>
        <ul class="dia-docs">
          {diagram.documents.map((document) => (
            <li class="dia-doc">
              <PixelIcon rows={glyphs.page} class="dia-glyph" />
              {document}
            </li>
          ))}
        </ul>
        <span class="dia-track">
          <span class="dia-progress" />
        </span>
        <span class="dia-pop">
          <PixelIcon rows={glyphs.page} />
        </span>
      </div>
    </>
  )}
</div>

<style>
  /* Shared pieces: a bordered box with a mono label, a list of rows with a
     pixel glyph each, and the core, a code glyph in a black square. */
  .dia {
    --dia-loop: 2s;
    position: relative;
    width: 100%;
    max-width: 34rem;
    color: var(--faint);
    font-size: 0.9375rem;
  }
  .dia-label {
    margin: 0 0 0.75rem;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
  }
  /* A box only covers the pane's dots, as the master's do: same ground. */
  .dia-box,
  .dia-out,
  .dia-card,
  .dia-row {
    border: 1px solid var(--line);
    background: var(--field);
  }
  .dia-box {
    padding: 1rem;
  }
  .dia-list,
  .dia-chips,
  .dia-rows,
  .dia-docs {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dia-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    white-space: nowrap;
  }
  .dia :global(.dia-glyph) {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
  }
  .dia-core {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border: 1px solid var(--surface);
    background: var(--core);
    color: var(--ink);
  }
  .dia-core :global(.dia-core-glyph) {
    width: 1.75rem;
    height: auto;
  }

  /* Interfaces, measured from the master's first video as its pane shows
     it: boxes 151px wide and 249px tall, a bracket 32px deep behind each,
     30px short of its box at either end, a join of 35px to a core of 94px,
     and a channel of 10px down to a box of 301 by 124. */
  .dia-interfaces {
    --box-h: 15.5625rem;
    --core-size: 5.875rem;
    --bracket: 2rem;
    --join: 2.1875rem;
    --drop: 4.25rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: var(--box-h) var(--drop) auto;
    column-gap: calc(var(--bracket) + var(--join));
    align-items: center;
    width: max-content;
    max-width: none;
  }
  .dia-interfaces .dia-box {
    position: relative;
    grid-row: 1;
    align-self: stretch;
    min-width: 9.4375rem;
    padding: 1.1875rem 1rem 0;
  }
  .dia-interfaces .dia-left {
    grid-column: 1;
  }
  .dia-interfaces .dia-right {
    grid-column: 3;
  }
  .dia-interfaces .dia-label {
    margin-bottom: 0.4375rem;
  }
  /* A row stands 40px, as the master's do; its words are a size under
     the master's so the state box's longest name keeps the master's
     proportions. A row still dark keeps a grey that passes contrast, where
     the master's nearly vanish, and lights to ink. */
  .dia-interfaces .dia-item {
    gap: 0.5rem;
    padding-block: 0.75rem;
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.1;
  }
  .dia-interfaces :global(.dia-glyph) {
    width: 1.0625rem;
    height: 1.0625rem;
  }
  /* The row still loading: three small squares. */
  .dia-more {
    display: flex;
    gap: 0.3125rem;
    padding-block: 0.875rem;
  }
  .dia-more span {
    width: 0.1875rem;
    height: 0.1875rem;
    background: currentColor;
    color: var(--decor);
  }
  /* The bracket behind each box: a line standing a bracket's depth from the
     box, and the two arms that tie it back. */
  .dia-interfaces .dia-box::before,
  .dia-interfaces .dia-box::after {
    content: '';
    position: absolute;
    top: 1.875rem;
    bottom: 1.875rem;
  }
  .dia-interfaces .dia-box::before {
    width: 1px;
    background: var(--decor);
  }
  .dia-interfaces .dia-box::after {
    width: var(--bracket);
    border-block: 1px solid var(--decor);
  }
  .dia-left::before {
    left: calc(100% + var(--bracket) - 1px);
  }
  .dia-left::after {
    left: 100%;
    transform-origin: 100% 50%;
  }
  .dia-right::before {
    right: calc(100% + var(--bracket) - 1px);
  }
  .dia-right::after {
    right: 100%;
    transform-origin: 0 50%;
  }
  .dia-interfaces .dia-core {
    grid-area: 1 / 2;
    width: var(--core-size);
    height: var(--core-size);
  }
  .dia-interfaces .dia-core :global(.dia-core-glyph) {
    width: 2.5rem;
  }
  /* The joins: a rule from the core to each bracket. */
  .dia-interfaces .dia-core::before,
  .dia-interfaces .dia-core::after {
    content: '';
    position: absolute;
    top: 50%;
    width: var(--join);
    border-top: 1px solid var(--decor);
  }
  .dia-interfaces .dia-core::before {
    right: calc(100% + 1px);
    transform-origin: 100% 50%;
  }
  .dia-interfaces .dia-core::after {
    left: calc(100% + 1px);
    transform-origin: 0 50%;
  }
  /* The channel: an accent rule on either edge over a dark accent ground,
     its breaks travelling down, from the core to the box below. */
  .dia-flow {
    position: absolute;
    top: calc(100% + 1px);
    left: calc(50% - 0.3125rem);
    width: 0.625rem;
    height: calc((var(--box-h) - var(--core-size)) / 2 + var(--drop) - 1px);
    background: linear-gradient(
      90deg,
      var(--accent) 0 2px,
      color-mix(in srgb, var(--accent) 22%, transparent) 2px calc(100% - 2px),
      var(--accent) calc(100% - 2px)
    );
    mask-image: repeating-linear-gradient(
      to bottom,
      #000 0 2.25rem,
      transparent 2.25rem 2.5rem
    );
    transform-origin: 50% 0;
  }
  .dia-out {
    grid-area: 3 / 1 / 4 / 4;
    justify-self: center;
    width: 18.8125rem;
    padding: 1.25rem 0 1.125rem;
    border-color: var(--accent);
  }
  .dia-out .dia-label {
    margin-bottom: 1.375rem;
    text-align: center;
  }
  /* A square at each end, three cells, and a dot between two cells. */
  .dia-signals {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
  }
  .dia-end {
    width: 0.375rem;
    height: 0.375rem;
    margin-inline: 1rem;
    background: var(--decor);
  }
  .dia-signals {
    color: var(--accent);
  }
  .dia-cell {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--line);
  }
  .dia-dot {
    width: 0.25rem;
    height: 0.25rem;
    background: currentColor;
  }
  .dia-cell :global(.dia-glyph) {
    width: 1.625rem;
    height: 1.625rem;
  }

  /* Services, measured from the master's third video: a core of 94px, a
     stem of 55px, and rows of 312 by 68, 18px apart, each with its glyph in
     a square of 43px and its format on a chip. The row being crossed takes
     the accent, with a square either side; a stem joins each row reached to
     the one above. */
  .dia-services {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .dia-services .dia-core {
    width: 5.875rem;
    height: 5.875rem;
  }
  .dia-services .dia-core :global(.dia-core-glyph) {
    width: 2.5rem;
  }
  .dia-stem {
    width: 2px;
    height: 3.4375rem;
    background: var(--accent);
    transform-origin: 50% 0;
  }
  .dia-rows {
    gap: 1.125rem;
    width: 19.5rem;
  }
  .dia-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 4.25rem;
    padding-inline: 0.8125rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .dia-row :global(.dia-glyph) {
    box-sizing: border-box;
    width: 2.6875rem;
    height: 2.6875rem;
    padding: 0.875rem;
    border: 1px solid var(--line);
  }
  .dia-row-format {
    margin-left: auto;
    padding: 0.2em 0.25em;
    background: var(--surface);
    color: var(--row-mark, var(--faint));
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
  }
  .dia-row::before,
  .dia-row::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.375rem;
    height: 0.375rem;
    background: var(--accent);
    opacity: var(--row-dot, 0);
    transform: translateY(-50%);
  }
  .dia-row::before {
    right: calc(100% + 0.8125rem);
  }
  .dia-row::after {
    left: calc(100% + 0.8125rem);
  }
  /* The stem from the row above, across the gap. */
  .dia-row + .dia-row .dia-row-name::before {
    content: '';
    position: absolute;
    bottom: calc(100% + 1px);
    left: calc(50% - 1px);
    width: 2px;
    height: 1.125rem;
    background: var(--accent);
  }
  .dia-row:last-child {
    --row-mark: var(--accent);
    --row-dot: 1;
    color: var(--accent);
  }

  /* AI, measured from the master's second video: a card at work 388 by
     258, its core of 78px at the top right, and a card of documents 253 by
     125 over its lower right, with the join, a square of 51px, on that
     card's corner. */
  /* As tall as the finished pair; the documents rise into it from below. */
  .dia-ai {
    position: relative;
    width: 29.1875rem;
    height: 20rem;
  }
  .dia-card-main {
    position: absolute;
    top: 0;
    left: 12.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
    width: 24.25rem;
    height: 16.125rem;
    padding: 1.6875rem 1.625rem 1.5rem;
    transform: translateX(-50%);
  }
  .dia-skeleton {
    height: 1.375rem;
    background: var(--surface);
  }
  .dia-skeleton:nth-child(1) {
    width: 48%;
  }
  .dia-skeleton:nth-child(2) {
    width: 33%;
  }
  .dia-skeleton:nth-child(3) {
    width: 65%;
  }
  .dia-status,
  .dia-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    white-space: nowrap;
  }
  .dia-status {
    margin-top: 1rem;
    color: var(--muted);
  }
  .dia-foot {
    gap: 0.375rem;
    margin-top: auto;
    color: var(--faint);
  }
  .dia-foot :global(.dia-arrow) {
    width: 0.625rem;
    height: 0.625rem;
  }
  /* Eight spokes, turning by steps. */
  .dia-spinner {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    background:
      linear-gradient(var(--muted), var(--muted)) 50% 0 / 2px 30% no-repeat,
      linear-gradient(var(--muted), var(--muted)) 50% 100% / 2px 30% no-repeat,
      linear-gradient(var(--muted), var(--muted)) 0 50% / 30% 2px no-repeat,
      linear-gradient(var(--muted), var(--muted)) 100% 50% / 30% 2px no-repeat;
  }
  .dia-core-small {
    position: absolute;
    top: 1.6875rem;
    right: 0.875rem;
    width: 4.875rem;
    height: 4.875rem;
  }
  .dia-core-small :global(.dia-core-glyph) {
    width: 2rem;
  }
  .dia-card-docs {
    position: absolute;
    top: 12.1875rem;
    left: 13.375rem;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 15.8125rem;
    height: 7.8125rem;
    padding: 1rem;
  }
  .dia-count {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.375rem;
    margin: 0;
    color: var(--muted);
  }
  .dia-count-number {
    padding: 0 0.25em;
    background: var(--surface);
  }
  .dia-docs {
    flex-direction: row;
    gap: 0.25rem;
    margin-top: auto;
  }
  .dia-doc {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.4375rem;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-label);
  }
  .dia-doc :global(.dia-glyph) {
    width: 0.625rem;
    height: 0.625rem;
  }
  /* The progress: an accent bar along a grey track. */
  .dia-track {
    height: 2px;
    margin-top: 0.625rem;
    background: var(--line);
  }
  .dia-progress {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
  }
  /* The join sits on the card's corner, a square of the accent at its own
     lower left. */
  .dia-pop {
    position: absolute;
    top: -1.625rem;
    left: -1.5625rem;
    display: grid;
    place-items: center;
    width: 3.1875rem;
    height: 3.1875rem;
    border: 1px solid var(--line);
    background: var(--field);
    color: var(--accent);
  }
  .dia-pop::after {
    content: '';
    position: absolute;
    bottom: -0.1875rem;
    left: -0.1875rem;
    width: 0.375rem;
    height: 0.375rem;
    background: var(--accent);
  }
  .dia-pop :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* The loops. Every rule above is the finished state, which is what shows
     without motion; the keyframes below only play it out. */
  @media (prefers-reduced-motion: no-preference) {
    /* The master's first video, over two seconds: the joins leave the core,
       the bracket lines stand up from their middles and their arms reach
       back to the boxes, while the channel runs down; as it arrives the box
       below takes the accent and the rows light one by one, then all of it
       starts again. */
    .dia-interfaces .dia-core::before,
    .dia-interfaces .dia-core::after {
      animation: dia-join var(--dia-loop) linear infinite;
    }
    .dia-interfaces .dia-box::before {
      animation: dia-stand var(--dia-loop) linear infinite;
    }
