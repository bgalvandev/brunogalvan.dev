---
import AppWindow from '@lucide/astro/icons/app-window';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Boxes from '@lucide/astro/icons/boxes';
import Calendar from '@lucide/astro/icons/calendar';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import CircleCheck from '@lucide/astro/icons/circle-check';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import Database from '@lucide/astro/icons/database';
import FileCode from '@lucide/astro/icons/file-code';
import FilePenLine from '@lucide/astro/icons/file-pen-line';
import FileText from '@lucide/astro/icons/file-text';
import Globe from '@lucide/astro/icons/globe';
import Loader from '@lucide/astro/icons/loader';
import Receipt from '@lucide/astro/icons/receipt';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import TextCursorInput from '@lucide/astro/icons/text-cursor-input';
import PixelIcon from '@/components/pixel-icon.astro';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
// The three diagrams of the Stack room, drawn in HTML so they follow the
// theme and stay sharp at any size, each looping in two seconds:
// - interfaces: two boxes with a bracket behind each, joined to the core,
//   and a channel running down to what is rendered, which lights as the
//   channel arrives, then the rows light one by one;
// - services: from the core the layers of a request come up one by one,
//   each crossed in turn;
// - ai: a card at work widens while a card of documents rises beside it,
//   the documents coming one by one as a bar runs, the core sliding in and
//   the join appearing on the card's corner.
// At the heart of each, the core: a black square holding an asterisk that
// turns once a loop. Rows carry line icons; what a diagram delivers is drawn
// in pixels and takes the accent. Decoration: the tab beside it carries the
// words. Every loop is CSS, stops with the pause control and is off under
// reduced motion, where each diagram shows its finished state.
interface Props {
  kind: 'interfaces' | 'services' | 'ai';
  locale: Locale;
  class?: string;
}
const { kind, locale, class: className } = Astro.props;
const { diagram } = messages(locale).stack;
// The core's asterisk on a 36px square: two bars across it and two shorter
// ones on the diagonals, 4px thick.
const asterisk = [
  { length: 36, angle: 0 },
  { length: 36, angle: 90 },
  { length: 28, angle: 45 },
  { length: 28, angle: 135 },
]
  .map(
    ({ length, angle }) =>
      `<rect x="${18 - length / 2}" y="16" width="${length}" height="4" transform="rotate(${angle} 18 18)" />`,
  )
  .join('');
// The join's page, in pixels.
const page = [
  '#####..',
  '#...##.',
  '#....##',
  '#.....#',
  '#.....#',
  '#.....#',
  '#######',
];
type Icon = typeof Calendar;
// Each entry beside its icon, in order.
const withIcons = <T,>(entries: readonly T[], icons: readonly Icon[]) =>
  entries.flatMap((entry, index) => {
    const Icon = icons[index];
    return Icon ? [{ entry, Icon }] : [];
  });
const screens = withIcons(diagram.screenItems, [
  Calendar,
  Receipt,
  FilePenLine,
  TextCursorInput,
]);
const state = withIcons(
  ['Next.js', 'TanStack Query', 'React Hook Form', 'Zod'],
  [AppWindow, RefreshCw, ClipboardList, ShieldCheck],
);
// The rendered cells carry pixel glyphs thirteen cells a side, a pixel a cell
// while they wait and two once they are delivered.
const outputIcons = [
  [
    '#############',
    '#...........#',
    '#.##........#',
    '#...........#',
    '#############',
    '#...........#',
    '#.##........#',
    '#...........#',
    '#############',
    '#...........#',
    '#.##........#',
    '#...........#',
    '#############',
  ],
  [
    '#############',
    '#.#.#.......#',
    '#############',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#...........#',
    '#############',
  ],
  [
    '.########....',
    '.#......##...',
    '.#......#.#..',
    '.#......#..#.',
    '.#......####.',
    '.#.........#.',
    '.#.........#.',
    '.#.........#.',
    '.#.........#.',
    '.#.........#.',
    '.#.........#.',
    '.#.........#.',
    '.###########.',
  ],
];
const layers = withIcons(diagram.layers, [Globe, FileCode, Boxes, Database]);
---

<div class:list={['dia', `dia-${kind}`, className]}>
  {kind === 'interfaces' && (
    <>
      {[
        { side: 'left', label: diagram.screens, items: screens },
        { side: 'right', label: diagram.state, items: state },
      ].map((box) => (
        <div class={`dia-box dia-${box.side}`}>
          <p class="dia-label">{box.label}</p>
          <ul class="dia-list">
            {box.items.map((item) => (
              <li class="dia-item">
                <item.Icon class="dia-glyph" />
                {item.entry}
              </li>
            ))}
            <li class="dia-more">
              <span />
              <span />
              <span />
            </li>
          </ul>
        </div>
      ))}
      <div class="dia-core">
        <svg
          class="dia-core-glyph"
          viewBox="0 0 36 36"
          fill="currentColor"
          set:html={asterisk}
        />
        <span class="dia-flow" />
      </div>
      <div class="dia-out">
        <p class="dia-label">{diagram.output}</p>
        <div class="dia-signals">
          <span class="dia-end" />
          {outputIcons.map((icon, index) => (
            <>
              {index > 0 && <span class="dia-dot" />}
              <span class="dia-cell">
                <PixelIcon rows={icon} class="dia-glyph" />
              </span>
            </>
          ))}
          <span class="dia-end" />
        </div>
      </div>
    </>
  )}
  {kind === 'services' && (
    <>
      <div class="dia-core">
        <svg
          class="dia-core-glyph"
          viewBox="0 0 36 36"
          fill="currentColor"
          set:html={asterisk}
        />
      </div>
      <span class="dia-stem" />
      <ol class="dia-rows">
        {layers.map((layer) => (
          <li class="dia-row">
            <layer.Icon class="dia-glyph" />
            <span class="dia-row-name">{layer.entry.name}</span>
            <span class="dia-row-format">{layer.entry.format}</span>
          </li>
        ))}
      </ol>
    </>
  )}
  {kind === 'ai' && (
    <>
      <div class="dia-card dia-card-main">
        <span class="dia-skeleton" />
        <span class="dia-skeleton" />
        <span class="dia-skeleton" />
        <p class="dia-status">
          <Loader class="dia-spinner" />
          <span class="dia-status-text">{diagram.translating}</span>
        </p>
        <p class="dia-foot">
          <ChevronDown class="dia-glyph" />
          ES
          <ArrowRight class="dia-arrow" />
          EN
        </p>
        <div class="dia-core dia-core-small">
          <svg
            class="dia-core-glyph"
            viewBox="0 0 36 36"
            fill="currentColor"
            set:html={asterisk}
          />
        </div>
      </div>
      <div class="dia-card dia-card-docs">
        <p class="dia-count">
          <CircleCheck class="dia-glyph" />
          {diagram.documentsLabel}
          <span class="dia-count-number">{diagram.documents.length}</span>
        </p>
        <ul class="dia-docs">
          {diagram.documents.map((document) => (
            <li class="dia-doc">
              <FileText class="dia-glyph" />
              {document}
            </li>
          ))}
        </ul>
        <span class="dia-track">
          <span class="dia-progress" />
        </span>
        <span class="dia-pop">
          <PixelIcon rows={page} />
        </span>
      </div>
    </>
  )}
</div>

<style>
  /* Shared pieces: a bordered box with a mono label, a list of rows with a
     line icon each, and the core, an asterisk in a black square. */
  .dia {
    --dia-loop: 2s;
    position: relative;
    width: 100%;
    max-width: 34rem;
    color: var(--faint);
    font-size: 0.9375rem;
  }
  .dia-label {
    margin: 0 0 0.75rem;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
  }
  /* A box only covers the pane's dots: it takes the same ground. */
  .dia-box,
  .dia-out,
  .dia-card,
  .dia-row {
    border: 1px solid var(--line);
    background: var(--field);
  }
  .dia-box {
    padding: 1rem;
  }
  .dia-list,
  .dia-chips,
  .dia-rows,
  .dia-docs {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dia-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    white-space: nowrap;
  }
  .dia :global(.dia-glyph) {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
  }
  /* Line icons: a stroke of 2.25 on their 24-unit grid, 1.5px at the rows'
     16px, scaling with the icon when a narrow pane shows the diagram
     smaller. */
  .dia :global(.lucide) {
    stroke-width: 2.25;
  }
  .dia-core {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border: 1px solid var(--surface);
    background: var(--core);
    color: var(--ink);
  }
  /* The asterisk, 36px across. */
  .dia-core :global(.dia-core-glyph) {
    width: 2.25rem;
    height: auto;
  }

  /* Interfaces: boxes 151px wide and 249px tall, a bracket 30px deep
     behind each, 30px short of its box at either end, a join of 35px on to
     a core of 96px, and a channel of 10px down to a box of 301 by 124. */
  .dia-interfaces {
    --box-h: 15.5625rem;
    --core-size: 6rem;
    --bracket: 1.875rem;
    --join: 2.1875rem;
    --drop: 4.25rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: var(--box-h) var(--drop) auto;
    column-gap: calc(var(--bracket) + var(--join));
    align-items: center;
    width: max-content;
    max-width: none;
  }
  .dia-interfaces .dia-box {
    position: relative;
    grid-row: 1;
    align-self: stretch;
    min-width: 9.4375rem;
    padding: 1.1875rem 1rem 0;
  }
  .dia-interfaces .dia-left {
    grid-column: 1;
  }
  .dia-interfaces .dia-right {
    grid-column: 3;
  }
  .dia-interfaces .dia-label {
    margin-bottom: 0.4375rem;
  }
  /* A row stands 40px; its words are set at 14px so the state box's
     longest name fits the box. A row still dark keeps a grey that passes
     contrast, and lights to ink. */
  .dia-interfaces .dia-item {
    gap: 0.5rem;
    padding-block: 0.75rem;
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.1;
  }
  .dia-interfaces :global(.dia-glyph) {
    width: 1rem;
    height: 1rem;
  }
  /* The row still loading: three small squares. */
  .dia-more {
    display: flex;
    gap: 0.1875rem;
    padding-block: 0.875rem;
  }
  .dia-more span {
    width: 0.1875rem;
    height: 0.1875rem;
    background: currentColor;
    color: var(--decor);
  }
  /* The bracket behind each box: a line standing a bracket's depth from the
     box, and the two arms that tie it back. */
  .dia-interfaces .dia-box::before,
  .dia-interfaces .dia-box::after {
    content: '';
    position: absolute;
    top: 1.875rem;
    bottom: 1.875rem;
  }
  .dia-interfaces .dia-box::before {
    width: 1px;
    background: var(--decor);
  }
  .dia-interfaces .dia-box::after {
    width: var(--bracket);
    border-block: 1px solid var(--decor);
  }
  .dia-left::before {
    left: calc(100% + var(--bracket) - 1px);
  }
  .dia-left::after {
    left: 100%;
    transform-origin: 100% 50%;
  }
  .dia-right::before {
    right: calc(100% + var(--bracket) - 1px);
  }
  .dia-right::after {
    right: 100%;
    transform-origin: 0 50%;
  }
  .dia-interfaces .dia-core {
    grid-area: 1 / 2;
    width: var(--core-size);
    height: var(--core-size);
  }
  /* The joins: a rule from the core across the bracket to each box. */
  .dia-interfaces .dia-core::before,
  .dia-interfaces .dia-core::after {
    content: '';
    position: absolute;
    top: 50%;
    width: calc(var(--bracket) + var(--join));
    border-top: 1px solid var(--decor);
  }
  .dia-interfaces .dia-core::before {
    right: calc(100% + 1px);
    transform-origin: 100% 50%;
  }
  .dia-interfaces .dia-core::after {
    left: calc(100% + 1px);
    transform-origin: 42% 50%;
  }
  /* The channel: two accent rules 3px wide and 4px apart, from the core to
     the box below, each broken where its next stretch begins: the left once,
     at 62%, the right twice, at 24% and 52%. */
  .dia-flow {
    position: absolute;
    top: calc(100% + 1px);
    left: calc(50% - 0.3125rem);
    width: 0.625rem;
    height: calc((var(--box-h) - var(--core-size)) / 2 + var(--drop) - 1px);
  }
  .dia-flow::before,
  .dia-flow::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
  }
  .dia-flow::before {
    left: 0;
    background: linear-gradient(
      var(--accent) 0 62.3%,
      transparent 62.3% 64.9%,
      var(--accent) 64.9%
    );
  }
  .dia-flow::after {
    right: 0;
    background: linear-gradient(
      var(--accent) 0 23.8%,
      transparent 23.8% 26.5%,
      var(--accent) 26.5% 51.7%,
      transparent 51.7% 54.3%,
      var(--accent) 54.3%
    );
  }
  .dia-out {
    grid-area: 3 / 1 / 4 / 4;
    justify-self: center;
    width: 18.8125rem;
    padding: 1rem 0 1.125rem;
    border-color: var(--accent);
  }
  .dia-out .dia-label {
    margin-bottom: 1.375rem;
    text-align: center;
  }
  /* A square at each end, three cells, and a dot between two cells. */
  .dia-signals {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
  }
  .dia-end {
    width: 0.375rem;
    height: 0.375rem;
    margin-inline: 1rem;
    background: var(--decor);
  }
  .dia-signals {
    color: var(--accent);
  }
  .dia-cell {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--line);
  }
  .dia-dot {
    width: 0.25rem;
    height: 0.25rem;
    background: currentColor;
  }
  .dia-cell :global(.dia-glyph) {
    width: 1.625rem;
    height: 1.625rem;
  }

  /* Services: a core of 96px, a stem of 53px, and rows of 312 by 68, 18px
     apart, each with its icon in a square of 43px and its format on a
     chip. The row being crossed takes the accent, with a square either
     side; a stem joins each row reached to the one above. */
  .dia-services {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .dia-services .dia-core {
    width: 6rem;
    height: 6rem;
  }
  .dia-stem {
    width: 2px;
    height: 3.3125rem;
    background: var(--accent);
    transform-origin: 50% 0;
  }
  .dia-rows {
    gap: 1.125rem;
    width: 19.5rem;
  }
  /* Registered, so a crossing fades in and out rather than jumping. */
  @property --row-mark {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --row-dot {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
  .dia-row {
    --row-mark: var(--faint);
    --row-dot: 0;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 4.25rem;
    padding-inline: 0.8125rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .dia-row :global(.dia-glyph) {
    box-sizing: border-box;
    width: 2.6875rem;
    height: 2.6875rem;
    padding: 0.875rem;
    border: 1px solid var(--line);
  }
  .dia-row-format {
    margin-left: auto;
    padding: 0.2em 0.25em;
    background: var(--surface);
    color: var(--row-mark);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
  }
  .dia-row::before,
  .dia-row::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.375rem;
    height: 0.375rem;
    background: var(--accent);
    opacity: var(--row-dot);
    transform: translateY(-50%);
  }
  .dia-row::before {
    right: calc(100% + 0.8125rem);
  }
  .dia-row::after {
    left: calc(100% + 0.8125rem);
  }
  /* The stem from the row above, across the gap. */
  .dia-row + .dia-row .dia-row-name::before {
    content: '';
    position: absolute;
    bottom: calc(100% + 1px);
    left: calc(50% - 1px);
    width: 2px;
    height: 1.125rem;
    background: var(--accent);
  }
  .dia-row:last-child {
    --row-mark: var(--accent);
    --row-dot: 1;
    color: var(--accent);
  }

  /* AI: a card at work 388 by 258, its core of 78px at the top right, and
     a card of documents 253 by 125 over its lower right, with the join, a
     square of 51px, on that card's corner. */
  /* As tall as the finished pair; the documents rise into it from below. */
  .dia-ai {
    position: relative;
    width: 29.1875rem;
    height: 20rem;
  }
  .dia-card-main {
    position: absolute;
    top: 0;
    left: 12.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
    width: 24.25rem;
    height: 16.125rem;
    padding: 1.6875rem 1.625rem 1.5rem;
    transform: translateX(-50%);
  }
  .dia-skeleton {
    height: 1.375rem;
    background: var(--surface);
  }
  .dia-skeleton:nth-child(1) {
    width: 48%;
  }
  .dia-skeleton:nth-child(2) {
    width: 33%;
  }
  .dia-skeleton:nth-child(3) {
    width: 65%;
  }
  .dia-status,
  .dia-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    white-space: nowrap;
  }
  .dia-status {
    margin-top: 1rem;
    color: var(--muted);
  }
  .dia-status-text {
    transform-origin: 0 50%;
  }
  .dia-foot {
    gap: 0.375rem;
    margin-top: auto;
    color: var(--faint);
  }
  .dia-foot :global(.dia-arrow) {
    width: 0.625rem;
    height: 0.625rem;
  }
  /* Eight spokes, turning once a loop. */
  .dia :global(.dia-spinner) {
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .dia-core-small {
    position: absolute;
    top: 1.6875rem;
    right: 0.875rem;
    width: 4.875rem;
    height: 4.875rem;
  }
  .dia-card-docs {
    position: absolute;
    top: 12.1875rem;
    left: 13.375rem;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 15.8125rem;
    height: 7.8125rem;
    padding: 1rem;
  }
  .dia-count {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.375rem;
    margin: 0;
    color: var(--muted);
  }
  .dia-count-number {
    padding: 0 0.25em;
    background: var(--surface);
  }
  .dia-docs {
    flex-direction: row;
    gap: 0.25rem;
    margin-top: auto;
  }
  /* The document just handled is the brightest; those after it wait in the
     tertiary grey. */
  .dia-doc {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.4375rem;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-label);
  }
  .dia-doc + .dia-doc {
    color: var(--faint);
  }
  .dia-doc :global(.dia-glyph) {
    width: 0.625rem;
    height: 0.625rem;
  }
  /* The progress: an accent bar along a grey track. */
  .dia-track {
    height: 2px;
    margin-top: 0.625rem;
    background: var(--line);
  }
  .dia-progress {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
  }
  /* The join sits on the card's corner, a square of the accent at its own
     lower left. */
  .dia-pop {
    position: absolute;
    top: -1.625rem;
    left: -1.5625rem;
    display: grid;
    place-items: center;
    width: 3.1875rem;
    height: 3.1875rem;
    border: 1px solid var(--line);
    background: var(--field);
    color: var(--accent);
  }
  .dia-pop::after {
    content: '';
    position: absolute;
    bottom: -0.1875rem;
    left: -0.1875rem;
    width: 0.375rem;
    height: 0.375rem;
    background: var(--accent);
  }
  .dia-pop :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* The loops. Every rule above is the finished state, which is what shows
     without motion; the keyframes below only play it out. */
  @media (prefers-reduced-motion: no-preference) {
    /* Every core's asterisk turns once a loop, against the clock. */
    .dia-core :global(.dia-core-glyph) {
      animation: dia-turn var(--dia-loop) linear infinite;
    }
    /* Interfaces, over two seconds: the joins leave the core for the boxes,
       the bracket lines stand up from their middles and their arms reach
       back to the boxes, while the channel's two rules run down a stretch
       at a time; as they arrive the box below takes the accent, its cells
       double and take it too, and the rows light one by one, then all of
       it starts again. */
    .dia-interfaces .dia-core::before {
      animation: dia-join-left var(--dia-loop) linear infinite;
    }
    .dia-interfaces .dia-core::after {
      animation: dia-join-right var(--dia-loop) linear infinite;
    }
    .dia-interfaces .dia-box::before {
      animation: dia-stand var(--dia-loop) linear infinite;
    }
    .dia-interfaces .dia-box::after {
