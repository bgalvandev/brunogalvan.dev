---
import { Image } from 'astro:assets';
import portrait from '@/assets/bruno-galvan.png';
import PageSection from '@/components/page-section.astro';
import { site } from '@/config/site';
import type { Locale } from '@/i18n/locales';
import { messages } from '@/i18n/messages';
interface Props {
  locale: Locale;
}
const { about, home } = messages(Astro.props.locale);
---

<PageSection id="about" index="05" label={about.heading}>
  <div class="about-layout">
    <figure class="portrait">
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt={about.portraitAlt}
          widths={[220, 440]}
          sizes="(min-width: 52rem) 220px, 55vw"
          loading="lazy"
        />
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
      <figcaption class="portrait-caption">
        {site.name} · {home.location}
      </figcaption>
    </figure>
    <div>
      <div class="prose">
        {about.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <dl class="facts">
        {Object.values(about.facts).map((fact) => (
          <div>
            <dt class="fact-label">{fact.label}</dt>
            <dd class="fact-value">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</PageSection>
