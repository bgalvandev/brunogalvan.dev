---
import PageSection from '@/components/page-section.astro';
import type { Locale } from '@/i18n/locales';
import { messages } from '@/i18n/messages';
interface Props {
  locale: Locale;
}
const { about } = messages(Astro.props.locale);
---

<PageSection total="07" id="about" index="06" label={about.heading}>
  <div class="prose">
    {about.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
</PageSection>
