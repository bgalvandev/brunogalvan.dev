---
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { sections, type SectionId } from './sections';
// The page's spine, in the right gutter from the desktop breakpoint: every
// numbered room by its number, its label sliding out on hover or focus, the
// room in view marked with the accent, and a line that fills as the page is
// read. It fits the gutter because only the numbers stand; each link's name
// is its number and label, set once so no reader runs the two together. The links work without JavaScript; the script
// only marks the room in view. The fill is a scroll-driven animation, drawn
// only where the browser supports one.
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = messages(locale);
const labels: Record<SectionId, string> = {
  'what-i-do': t.whatIDo.label,
  numbers: t.numbers.label,
  stack: t.stack.label,
  method: t.method.label,
  code: t.code.label,
  projects: t.projects.label,
  experience: t.experience.label,
};
---

<nav class="rail" aria-label={t.navigation.sections}>
  <span class="rail-track" aria-hidden="true">
    <span class="rail-fill"></span>
  </span>
  <ol class="rail-list">
    {sections.map((id, index) => {
      const number = String(index + 1).padStart(2, '0');
      return (
        <li>
          <a
            class="rail-link"
            href={`#${id}`}
            aria-label={`${number} ${labels[id]}`}
            data-rail-link
          >
            <span class="rail-number">{number}</span>
            <span class="rail-label" aria-hidden="true">
              {labels[id]}
            </span>
          </a>
        </li>
      );
    })}
  </ol>
</nav>
<script>
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'),
  ];
  const rooms = links.flatMap(
    (link) => document.getElementById(link.hash.slice(1)) ?? [],
  );
  // The room crossing the middle of the viewport is the one being read.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of links) {
          if (link.hash === `#${entry.target.id}`) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        }
      }
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  rooms.forEach((room) => observer.observe(room));
</script>

<style>
  .rail {
    display: none;
  }
  @media (width >= 62rem) {
    .rail {
      position: fixed;
      top: 50%;
      right: 0.75rem;
      z-index: 800;
      display: flex;
      gap: 0.5rem;
      padding: 0.5rem;
      border: 1px solid var(--line);
      background: var(--paper);
      transform: translateY(-50%);
    }
  }
  .rail-track {
    position: relative;
    width: 1px;
    background: var(--line);
  }
  .rail-fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: 50% 0;
  }
  /* Longhands on purpose: animation-timeline cannot be set through the
     animation shorthand, so the two must never be merged into one. */
  @supports (animation-timeline: scroll()) {
    .rail-fill {
      animation-name: rail-fill;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes rail-fill {
    to {
      transform: scaleY(1);
    }
  }
  .rail-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rail-link {
    position: relative;
    display: block;
    padding: 0.125rem 0.25rem;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--text-small--letter-spacing);
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .rail-link[aria-current] {
    color: var(--accent);
  }
  /* The label slides out to the left, over the gutter, on hover or focus. */
  .rail-label {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.75rem);
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--ink);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(0.5rem, -50%);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .rail-link:hover .rail-label,
  .rail-link:focus-visible .rail-label {
    opacity: 1;
    transform: translate(0, -50%);
  }
  .rail-link:hover {
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .rail-link,
    .rail-label {
      transition: none;
    }
  }
</style>
