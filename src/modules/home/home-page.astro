---
import SiteFooter from '@/components/site-footer.astro';
import SiteHeader from '@/components/site-header.astro';
import TechSprite from '@/components/tech-sprite.astro';
import type { Locale } from '@/i18n/locales';
import Contact from './contact.astro';
import Experience from './experience.astro';
import Hero from './hero.astro';
import Code from './code.astro';
import Method from './method.astro';
import Numbers from './numbers.astro';
import Projects from './projects.astro';
import SectionRail from './section-rail.astro';
import Stack from './stack.astro';
import WhatIDo from './what-i-do.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<SiteHeader locale={locale} route="home" />
<TechSprite />
<SectionRail locale={locale} />
<main id="main" tabindex="-1">
  <Hero locale={locale} />
  <WhatIDo locale={locale} />
  <Numbers locale={locale} />
  <Stack locale={locale} />
  <Method locale={locale} />
  <Code locale={locale} />
  <Projects locale={locale} />
  <Experience locale={locale} />
  <Contact locale={locale} />
</main>
<SiteFooter locale={locale} />
