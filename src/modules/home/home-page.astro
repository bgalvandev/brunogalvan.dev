---
import SiteFooter from '@/components/site-footer.astro';
import SiteHeader from '@/components/site-header.astro';
import type { Locale } from '@/i18n/locales';
import ProjectsSection from '@/modules/projects/projects-section.astro';
import AboutSection from './about-section.astro';
import ExperienceSection from './experience-section.astro';
import Figures from './figures.astro';
import MethodSection from './method-section.astro';
import Hero from './hero.astro';
import Marquee from './marquee.astro';
import StackSection from './stack-section.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<SiteHeader locale={locale} route="home" />
<main id="main" tabindex="-1">
  <Hero locale={locale} />
  <Marquee />
  <Figures locale={locale} />
  <ExperienceSection locale={locale} />
  <ProjectsSection locale={locale} />
  <StackSection locale={locale} />
  <MethodSection locale={locale} />
  <AboutSection locale={locale} />
</main>
<SiteFooter locale={locale} />
