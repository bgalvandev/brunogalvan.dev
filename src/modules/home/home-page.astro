---
import SiteFooter from '@/components/site-footer.astro';
import SiteHeader from '@/components/site-header.astro';
import type { Locale } from '@/i18n/locales';
import Contact from './contact.astro';
import Hero from './hero.astro';
import WhatIDo from './what-i-do.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<SiteHeader locale={locale} route="home" contactHref="#contact" />
<main id="main" tabindex="-1">
  <Hero locale={locale} />
  <WhatIDo locale={locale} />
  <Contact locale={locale} />
</main>
<SiteFooter locale={locale} />
