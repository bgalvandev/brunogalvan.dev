---
// The closing room: a line of words above and below, running in opposite
// directions, a dark gridded band, and a light card with a square at each
// corner, whose bracketed word cycles like the hero's. The email and
// profiles live in the footer, once.
import Button from '@/components/button.astro';
import Marquee from '@/components/marquee.astro';
import PixelField from '@/components/pixel-field.astro';
import { site } from '@/config/site';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
interface Props {
  locale: Locale;
}
const { contact } = messages(Astro.props.locale);
const [first, second] = contact.headline;
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <Marquee items={contact.marquee} variant="text" />
  <div class="band contact-band">
    <PixelField rows={27} />
    <div class="measure contact-layout">
      <div class="unband contact-card">
        <span class="contact-corners" aria-hidden="true"></span>
        <div class="contact-top">
          <p class="tag">{contact.label}</p>
          <h2
            id="contact-title"
            class="contact-heading text-display"
            aria-label={`${first} ${contact.fragments[0]}. ${second}`}
          >
            <span aria-hidden="true" data-reveal data-reveal-duration="0.6">
              <span class="contact-line">{first}</span>
              <span class="contact-line pixel-highlight" data-reveal-skip>
                {[
                  '[',
                  <span
                    data-typewriter
                    data-typewriter-words={contact.fragments.join('|')}
                    data-typewriter-delay="2"
                  >
                    {contact.fragments[0]}
                  </span>,
                  ']',
                ]}
              </span>
              <span class="contact-line">{second}</span>
            </span>
          </h2>
        </div>
        <Button href={`mailto:${site.email}`} label={contact.action} />
      </div>
    </div>
  </div>
  <Marquee items={contact.marquee} variant="text" reverse />
</section>

<style>
  .contact {
    border-top: 1px solid var(--line);
  }
  .contact-band {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    background: var(--paper);
  }
  .contact-layout {
    position: relative;
    padding-block: var(--space-large);
    pointer-events: none;
  }
  .contact-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: 30rem;
    padding: 2.5rem;
    pointer-events: auto;
  }
  .contact-corners {
    position: absolute;
    inset: 0.5rem;
    pointer-events: none;
    background:
      linear-gradient(var(--ink), var(--ink)) 0 0 / 1.5rem 1.5rem no-repeat,
      linear-gradient(var(--ink), var(--ink)) 100% 0 / 1.5rem 1.5rem no-repeat,
      linear-gradient(var(--ink), var(--ink)) 0 100% / 1.5rem 1.5rem no-repeat,
      linear-gradient(var(--ink), var(--ink)) 100% 100% / 1.5rem 1.5rem
        no-repeat;
  }
  .contact-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .contact-top .tag {
    align-self: center;
    margin: 0;
    color: var(--faint);
    font-size: var(--text-small);
    letter-spacing: var(--text-small--letter-spacing);
  }
  .contact-heading {
    margin: 0;
    text-align: center;
  }
  .contact-line {
    display: block;
  }
  @media (width < 48rem) {
    .contact-card {
      justify-content: flex-start;
      min-height: auto;
      padding: 3rem 1.5rem;
    }
  }
  /* On a phone the heading is set to the band's width, 13% of it, its word
     as large as the rest, and the card padded 4rem by 1rem. */
  @media (width < 30rem) {
    .contact-card {
      padding: 4rem 1rem;
    }
    .contact-heading {
      font-size: 13cqw;
    }
  }
</style>
