---
import PageSection from '@/components/page-section.astro';
import type { Locale } from '@/i18n/locales';
import { messages } from '@/i18n/messages';
import { formatPeriod, positions } from './experience';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { experience } = messages(locale);
---

<PageSection id="experience" index="01" label={experience.heading}>
  <div class="timeline">
    {positions.map((position) => {
      const entry = experience.items[position.id];
      return (
        <article class="position">
          <div class="position-head">
            <h3 class="position-role">{entry.role}</h3>
            <p class="position-period">
              {formatPeriod(position, locale, experience.present)}
            </p>
          </div>
          <p class="position-company">{position.company}</p>
          <p class="position-summary">{entry.summary}</p>
        </article>
      );
    })}
  </div>
</PageSection>
