---
import Glyph from '@/components/glyph.astro';
import PageSection from '@/components/page-section.astro';
import TagList from '@/components/tag-list.astro';
import type { Locale } from '@/i18n/locales';
import { messages } from '@/i18n/messages';
import { stack } from './stack';
interface Props {
  locale: Locale;
}
const { stack: catalog } = messages(Astro.props.locale);
---

<PageSection total="07" id="stack" index="04" label={catalog.heading}>
  <div class="capabilities">
    {stack.map((group, index) => (
      <article class="capability">
        <p class="capability-index" aria-hidden="true">
          //{String(index + 1).padStart(3, '0')}
        </p>
        <Glyph name={group.id} />
        <h3 class="capability-name">{catalog.groups[group.id]}</h3>
        <TagList items={group.items} />
      </article>
    ))}
  </div>
</PageSection>
