---
// As in the master, the four cards sit in a sticky frame inside a tall room and
// the scroll draws each process line in turn. That only happens while motion
// runs (data-steps is the hook); otherwise every card shows complete.
import Button from '@/components/button.astro';
import Headline from '@/components/headline.astro';
import NumberedSection from '@/components/numbered-section.astro';
import IsoIcon from '@/components/iso-icon.astro';
import { box, extrude } from '@/components/isometric';
import { site } from '@/config/site';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { sectionNumber, sections } from './sections';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { method } = messages(locale);
// One isometric scene per rule, drawn in pixels: a block inside a walled
// boundary, one small block raised on a row of tiles, a gate and a page with
// its lines.
const icons = [
  [
    box(0, 0, 0, 11, 1.5, 1.8),
    box(0, 1.5, 0, 1.5, 8, 1.8),
    box(4, 4, 0, 3, 3, 3.5),
    box(9.5, 1.5, 0, 1.5, 8, 1.8),
    box(0, 9.5, 0, 11, 1.5, 1.8),
  ],
  [
    box(0, 0, 0, 4.5, 4.5, 1.4),
    box(5.5, 0, 0, 4.5, 4.5, 1.4),
    box(0, 5.5, 0, 4.5, 4.5, 1.4),
    box(5.5, 5.5, 0, 4.5, 4.5, 1.4),
    box(6.75, 6.75, 1.4, 2, 2, 2),
  ],
  [
    box(0, 0, 0, 2, 2, 7),
    box(3.5, 0, 0, 2, 2, 2),
    box(7, 0, 0, 2, 2, 7),
    box(0, 0, 7, 9, 2, 2),
  ],
  [
    extrude(
      [
        [0, 0],
        [7, 0],
        [7, 7],
        [5, 9],
        [0, 9],
      ],
      0,
      1.4,
    ),
    box(1, 1.4, 5.8, 4, 0.6, 0.9),
    box(1, 1.4, 3.8, 5, 0.6, 0.9),
    box(1, 1.4, 1.8, 5, 0.6, 0.9),
  ],
];
---

<NumberedSection
  id="method"
  number={sectionNumber('method')}
  total={sections.length}
  label={method.label}
  locale={locale}
  headingId="method-title"
  class="method"
  data-steps
>
  <div class="method-main">
    <div class="method-heading">
      <Headline id="method-title" lines={method.headline} />
      <Button href={site.repository} label={method.action} />
    </div>
    <ol class="method-cards">
      {method.rules.map((rule, index) => (
        <li class="method-card" data-step>
          <div class="method-card-top">
            <span class="method-card-number" aria-hidden="true">
              // {String(index + 1).padStart(3, '0')}
            </span>
            <p class="method-card-text">{rule.text}</p>
          </div>
          <div class="method-card-process field-dotted" aria-hidden="true">
            <span class="method-card-line" data-step-line />
            <span class="method-card-dot" />
          </div>
          <div class="method-card-bottom">
            <h3 class="method-card-title">{rule.title}</h3>
            <IsoIcon
              solids={icons[index] ?? []}
              columns={16}
              align="xMaxYMax"
              class="method-card-icon"
            />
          </div>
        </li>
      ))}
    </ol>
  </div>
</NumberedSection>

<style>
  .method-main {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  .method-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
  }
  .method-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    min-height: 24rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--line);
  }
  /* The process strips line up across the row; the title block sinks to the
     bottom however many lines it takes. */
  .method-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: 1rem;
    border-inline: 1px solid var(--line);
  }
  .method-card-top,
  .method-card-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-inline: 1rem;
  }
  .method-card-bottom {
    margin-top: auto;
  }
  .method-card-top {
    justify-content: space-between;
    min-height: 8.5rem;
  }
  .method-card-number {
    color: var(--accent);
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .method-card-text {
    margin: 0;
    color: var(--muted);
    transition: opacity 0.2s ease;
  }
  /* The process strip: a dotted track, an accent line and a square that
     leads it. */
  .method-card-process {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: 1.5rem;
    padding-block: 0.5rem;
    background-size: 7.88px;
  }
  .method-card-line {
    align-self: stretch;
    width: 100%;
    max-width: calc(100% - 0.75rem);
    background: var(--accent);
  }
  .method-card-dot {
    flex: none;
    height: 100%;
    aspect-ratio: 1;
    background: var(--accent);
  }
  .method-card-title {
    margin: 0;
    color: var(--accent);
    font-size: var(--text-medium);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
    transition: color 0.2s ease;
  }
  /* A reached card shows its drawing as pixels; one not reached yet shows it
     as lines, and the swap is instant, as in the master. */
  .method-card :global(.method-card-icon) {
    align-self: flex-end;
    width: 5rem;
    height: 5rem;
    color: var(--accent);
  }
  .method-card :global(.iso-line) {
    visibility: hidden;
  }
  /* While the scroll drives it, a card not reached yet is quiet, as in the
     master: its description waits unseen (a screen reader still reads it),
     its drawing is a pale line drawing, and its number and title dim to a
     colour that still passes contrast, where the master drops them to 30%. */
  .method[data-scrubbing] {
    height: 200vh;
  }
  .method[data-scrubbing] :global(.section-body) {
    position: sticky;
    top: 10vh;
  }
  .method[data-scrubbing] .method-card:not(.is-active) .method-card-number,
  .method[data-scrubbing] .method-card:not(.is-active) .method-card-title {
    color: var(--faint);
  }
  .method[data-scrubbing] .method-card:not(.is-active) .method-card-text {
    opacity: 0;
  }
  .method[data-scrubbing] .method-card:not(.is-active) .method-card-title {
    font-weight: 400;
  }
  .method[data-scrubbing]
    .method-card:not(.is-active)
    :global(.method-card-icon) {
    color: var(--decor);
  }
  .method[data-scrubbing] .method-card:not(.is-active) :global(.iso-line) {
    visibility: visible;
  }
  .method[data-scrubbing] .method-card:not(.is-active) :global(.iso-pixel) {
    visibility: hidden;
  }
  .method[data-scrubbing] .method-card:not(.is-active) .method-card-dot {
    opacity: 0;
  }
  @media (width < 62rem) {
    .method-cards {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 0;
    }
    .method-card {
      border-bottom: 1px solid var(--line);
    }
  }
  @media (width < 48rem) {
    .method-heading {
      flex-direction: column;
    }
    .method-cards {
      grid-template-columns: 1fr;
      border-bottom: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .method-card-number,
    .method-card-text,
    .method-card-title,
    .method-card :global(.method-card-icon) {
      transition: none;
    }
  }
</style>
