---
import Headline from '@/components/headline.astro';
import Button from '@/components/button.astro';
import NumberedSection from '@/components/numbered-section.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import { site } from '@/config/site';
import { figures } from '@/data/figures';
import { projects } from '@/data/projects';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { pagePath } from '@/i18n/routes';
import { sectionNumber, sections } from './sections';
// The statement on the left, its button and a paragraph at its foot; the
// project cards on the right, two to a row, the third across the row below.
// Rules run down from the eyebrow to the cards' edges and on below them. A
// card that leads somewhere (its case study, else its code) is one link and
// hovers; a project with no public code is plain text.
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = messages(locale).projects;
const caseLabels = messages(locale).caseStudy;
const counts = figures(new Date());
const headline = t.headline.map((line) =>
  line
    .replace('{total}', String(counts.projects))
    .replace('{public}', String(counts.publicProjects)),
);
const cards = projects.map((project, index) => {
  const caseStudy = 'caseStudy' in project && project.caseStudy;
  const link = caseStudy
    ? {
        href: pagePath('caseStudy', locale, project.id),
        label: caseLabels.read,
        name: caseLabels.readOf.replace('{name}', project.name),
      }
    : project.repository
      ? {
          href: project.repository,
          label: t.code,
          name: t.codeOf.replace('{name}', project.name),
        }
      : null;
  return {
    ...project,
    link,
    number: String(index + 1).padStart(3, '0'),
    kindLabel: t.kinds[project.kind],
    line: t.items[project.id],
  };
});
---

<NumberedSection
  id="projects"
  number={sectionNumber('projects')}
  total={sections.length}
  label={t.label}
  locale={locale}
  headingId="projects-title"
  class="projects"
>
  <div class="projects-rules" aria-hidden="true">
    <span></span>
    <span></span>
    <span class="projects-corner"></span>
  </div>
  <div class="projects-main">
    <div class="projects-left">
      <Headline id="projects-title" lines={headline} />
      <div class="projects-intro">
        <Button
          href={`${site.github}?tab=repositories`}
          label={t.action}
          icon="arrow-up-right"
        />
        <p class="projects-text">{t.intro}</p>
      </div>
    </div>
    <div class="projects-right">
      <ul class="projects-grid">
        {cards.map((card) => {
          const Body = card.link ? 'a' : 'div';
          return (
            <li
              class:list={['project-card', { 'project-card-link': card.link }]}
            >
              <Body
                class="project-card-body"
                href={card.link?.href}
                aria-label={card.link?.name}
              >
                <div class="project-card-top">
                  <div class="project-card-heading">
                    <h3 class="project-card-title">{card.name}</h3>
                    <ul class="project-card-tags">
                      {card.technologies.map((technology) => (
                        <li class="project-card-tag">{technology}</li>
                      ))}
                    </ul>
                    <p class="project-card-line">{card.line}</p>
                  </div>
                  <div class="project-card-meta">
                    <span class="project-card-number" aria-hidden="true">
                      <span class="project-card-slashes">//</span> {card.number}
                    </span>
                    <span class="tag">{card.kindLabel}</span>
                  </div>
                </div>
                <div class="project-card-bottom">
                  <div
                    class="project-card-cover field-dotted"
                    aria-hidden="true"
                  >
                    <div class="project-card-sheet">
                      <span class="project-card-sheet-name">{card.name}</span>
                      <span class="project-card-sheet-kind">
                        {card.kindLabel}
                      </span>
                    </div>
                  </div>
                  <div class="project-card-action">
                    {card.link ? (
                      <>
                        <span class="project-card-arrow" aria-hidden="true">
                          <PixelIcon name="arrow-up-right" />
                          <PixelIcon name="arrow-up-right" />
                        </span>
                        <span>{card.link.label}</span>
                      </>
                    ) : (
                      <span class="project-card-private">{t.private}</span>
                    )}
                  </div>
                </div>
                <span class="project-card-border" aria-hidden="true" />
                <span class="project-card-bar" aria-hidden="true" />
              </Body>
            </li>
          );
        })}
      </ul>
      <div class="projects-rules projects-rules-bottom" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
    </div>
  </div>
</NumberedSection>

<style>
  .projects > :global(.section-body) {
    gap: 0;
  }
  /* The rules under the eyebrow: a 2rem strip that rises 10px into the
     eyebrow's row, its quarters ruled where the cards' edges fall, closed on
     the right with a small square at its top corner. */
  .projects-rules {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    height: 2rem;
    margin-top: -0.625rem;
    border-right: 1px solid var(--line);
  }
  .projects-rules > span:nth-child(1) {
    grid-column: 3;
  }
  .projects-rules > span:not(.projects-corner) {
    border-left: 1px solid var(--line);
  }
  .projects-corner {
    position: absolute;
    inset: -0.2rem -0.2rem auto auto;
    width: 0.4rem;
    aspect-ratio: 1;
    background: var(--line);
  }
  .projects-rules-bottom {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 0;
  }
  .projects-rules-bottom > span:nth-child(1) {
    grid-column: auto;
  }
  .projects-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 37.5rem;
    border-bottom: 1px solid var(--line);
  }
  .projects-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0 1rem 2rem 0;
  }
  .projects-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 1.5rem;
    max-width: 26rem;
  }
  .projects-text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.3;
  }
  .projects-right {
    display: flex;
    flex-direction: column;
  }
  /* Two cards to a row sharing their middle rule; the third runs across the
     row below. */
  .projects-grid {
    display: grid;
    flex: 1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-card {
    display: flex;
  }
  .project-card:nth-child(odd):not(:last-child) .project-card-body {
    border-right-style: none;
  }
  .project-card:nth-child(n + 3) .project-card-body {
    border-top-style: none;
  }
  .project-card:nth-child(odd):last-child {
    grid-column: 1 / -1;
  }
  .project-card-body {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .project-card-top {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 13rem;
    padding: 1.5rem 1.5rem 0;
  }
  .project-card-heading {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .project-card-title {
    margin: 0;
    font-size: var(--text-medium);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
  }
  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-card-tag {
    padding-block: 0.2em;
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }
  .project-card-line {
    margin: 0;
    color: var(--muted);
  }
  .project-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .project-card-meta .tag {
    margin: 0;
  }
  .project-card-number {
    color: var(--muted);
    font-weight: 500;
  }
  .project-card-slashes {
    opacity: 0.5;
  }
  .project-card-bottom {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.5rem;
    overflow: hidden;
  }
  /* The cover: a sheet nine tenths of the card wide, square, sunk to the
     cover's foot so its top shows. */
  .project-card-cover {
    position: relative;
    flex: 1;
    min-height: 12rem;
    margin-inline: 1px;
    overflow: hidden;
    background-size: 12.6px;
  }
  .project-card-sheet {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 90%;
    aspect-ratio: 1;
    margin-inline: auto;
    padding: 1.5rem;
    border: 1px solid var(--line);
    background: var(--paper);
    transform: translateY(30%);
  }
  .project-card-link .project-card-sheet {
    transition: transform 0.2s var(--ease-power1-out);
  }
  /* The card across the row keeps the sheet of a card in a column. */
  @media (width >= 30rem) {
    .project-card:nth-child(odd):last-child .project-card-sheet {
      width: 45%;
    }
  }
  .project-card-sheet-name {
    color: var(--ink);
    font-family: var(--font-pixel);
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: -0.06em;
    overflow-wrap: anywhere;
  }
  .project-card-sheet-kind {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
  }
  /* The line button at the card's foot: an arrow on the left, the label on
     the right, over a rule. */
  .project-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3rem;
    padding: 0.5rem 1.5rem;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
  }
  .project-card-private {
    margin-left: auto;
    color: var(--faint);
  }
  .project-card-arrow {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    overflow: hidden;
  }
  .project-card-arrow :global(svg) {
    position: absolute;
    inset: 0.2rem;
    transition: transform 0.2s var(--ease-power1-out);
  }
  .project-card-arrow :global(svg:last-child) {
    transform: translate(-150%, 150%);
  }
  .project-card-border {
    position: absolute;
    inset: -1px;
    z-index: 2;
    border: 1px solid var(--accent);
    opacity: 0;
    pointer-events: none;
  }
  .project-card-bar {
    position: absolute;
    inset: auto 0 -1px;
    z-index: 2;
    width: 0;
    height: 4px;
    background: var(--accent);
  }
  /* The hover, on a desktop: over 0.2s the card takes the accent, its frame
     closes, its bar grows, its arrow steps out and its sheet rises. */
  @media (width >= 62rem) {
    .project-card-link .project-card-body {
      transition: color 0.2s var(--ease-power1-out);
    }
    .project-card-link .project-card-border {
      transition: opacity 0.2s var(--ease-power1-out);
    }
    .project-card-link .project-card-bar {
      transition: width 0.2s var(--ease-power1-out);
    }
    .project-card-link .project-card-body:hover,
    .project-card-link .project-card-body:focus-visible {
      color: var(--accent);
    }
    .project-card-body:hover .project-card-border,
    .project-card-body:focus-visible .project-card-border {
      opacity: 1;
    }
    .project-card-body:hover .project-card-bar,
    .project-card-body:focus-visible .project-card-bar {
      width: 100%;
    }
    .project-card-body:hover .project-card-sheet,
    .project-card-body:focus-visible .project-card-sheet {
      transform: translateY(3rem);
    }
    .project-card-body:hover .project-card-arrow :global(svg:first-child),
    .project-card-body:focus-visible
      .project-card-arrow
      :global(svg:first-child) {
      transform: translate(150%, -150%);
    }
    .project-card-body:hover .project-card-arrow :global(svg:last-child),
    .project-card-body:focus-visible
      .project-card-arrow
      :global(svg:last-child) {
      transform: none;
    }
  }
  /* A card that leads nowhere never hovers. */
  .project-card:not(.project-card-link) .project-card-border,
  .project-card:not(.project-card-link) .project-card-bar {
    display: none;
  }
  @media (width < 62rem) {
    .projects > :global(.section-body) {
      gap: var(--space-tiny);
    }
    .projects-rules:not(.projects-rules-bottom) {
      display: none;
    }
    .projects-main {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
    }
    .projects-left {
      justify-content: flex-start;
      gap: 2.5rem;
      padding-right: 0;
    }
    .projects-intro {
      gap: 2rem;
    }
    .project-card-cover {
      flex: 0 auto;
      min-height: 20rem;
    }
  }
  @media (width < 48rem) {
    .projects-left {
      gap: var(--space-small);
    }
    .projects-intro {
      gap: 1rem;
    }
    .projects-text {
      font-size: var(--text-body);
    }
    .project-card-sheet {
      inset: 0;
      margin: auto;
      transform: none;
    }
  }
  @media (width < 30rem) {
    .projects-rules-bottom {
      display: none;
    }
    .projects-grid {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .project-card:nth-child(odd):not(:last-child) .project-card-body {
      border-right-style: solid;
    }
    .project-card:nth-child(n + 3) .project-card-body {
      border-top-style: solid;
    }
    .project-card-top {
      min-height: auto;
    }
    .project-card-heading {
      gap: 0.5rem;
    }
    .project-card-title {
      font-size: 1.25rem;
    }
    .project-card-cover {
      min-height: 10rem;
    }
    .project-card-bottom {
      gap: 0;
    }
    .project-card-sheet {
      inset: 1.5rem 0 auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card-sheet,
    .project-card-body,
    .project-card-border,
    .project-card-bar,
    .project-card-arrow :global(svg) {
      transition: none !important;
    }
  }
</style>
