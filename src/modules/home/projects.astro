---
import Headline from '@/components/headline.astro';
import Button from '@/components/button.astro';
import NumberedSection from '@/components/numbered-section.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import { site } from '@/config/site';
import { figures } from '@/data/figures';
import { projects } from '@/data/projects';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { pagePath } from '@/i18n/routes';
import { sectionNumber, sections } from './sections';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = messages(locale).projects;
const caseLabels = messages(locale).caseStudy;
const counts = figures(new Date());
const headline = t.headline.map((line) =>
  line
    .replace('{total}', String(counts.projects))
    .replace('{public}', String(counts.publicProjects)),
);
// The featured project leads; the numbers follow the order shown.
const cards = [...projects]
  .sort(
    (a, b) =>
      Number('featured' in b && b.featured) -
      Number('featured' in a && a.featured),
  )
  .map((project, index) => {
    const caseStudy = 'caseStudy' in project && project.caseStudy;
    // A card follows its case study when there is one, else its code.
    const primary = caseStudy
      ? {
          href: pagePath('caseStudy', locale, project.id),
          label: caseLabels.read,
          name: caseLabels.readOf.replace('{name}', project.name),
        }
      : project.repository
        ? {
            href: project.repository,
            label: t.code,
            name: t.codeOf.replace('{name}', project.name),
          }
        : null;
    return {
      ...project,
      caseStudy,
      primary,
      featured: 'featured' in project && project.featured,
      number: String(index + 1).padStart(3, '0'),
      kindLabel: t.kinds[project.kind],
      line: t.items[project.id],
    };
  });
---

<NumberedSection
  id="projects"
  number={sectionNumber('projects')}
  total={sections.length}
  label={t.label}
  locale={locale}
  headingId="projects-title"
>
  <div class="projects-main">
    <div class="projects-heading">
      <Headline id="projects-title" lines={headline} />
      <Button
        href={`${site.github}?tab=repositories`}
        label={t.action}
        icon="arrow-up-right"
      />
    </div>
    <ul class="projects-grid">
      {cards.map((card) => (
        <li
          class:list={[
            'project-card',
            {
              'project-card-featured': card.featured,
              'project-card-linked': card.repository,
            },
          ]}
        >
          <div class="project-card-top">
            <div class="project-card-heading">
              <h3 class="project-card-title">{card.name}</h3>
              <ul class="project-card-tags">
                {card.technologies.map((technology) => (
                  <li class="project-card-tag">{technology}</li>
                ))}
              </ul>
            </div>
            <p class="project-card-line">{card.line}</p>
            <div class="project-card-meta">
              <span class="project-card-number" aria-hidden="true">
                <span class="project-card-slashes">//</span> {card.number}
              </span>
              <span class="tag">{card.kindLabel}</span>
            </div>
          </div>
          <div class="project-card-cover field-dotted" aria-hidden="true">
            <span class="project-card-cover-name">{card.name}</span>
          </div>
          <div class="project-card-links">
            {card.primary ? (
              <a
                class="project-card-link project-card-primary"
                href={card.primary.href}
                aria-label={card.primary.name}
              >
                <span class="project-card-arrow" aria-hidden="true">
                  <PixelIcon name="arrow-up-right" />
                  <PixelIcon name="arrow-up-right" />
                </span>
                {card.primary.label}
              </a>
            ) : (
              <span class="project-card-link project-card-private">
                {t.private}
              </span>
            )}
            <span class="project-card-secondary">
              {card.caseStudy && card.repository && (
                <a
                  class="project-card-link"
                  href={card.repository}
                  aria-label={t.codeOf.replace('{name}', card.name)}
                >
                  {t.code}
                  <PixelIcon
                    name="arrow-up-right"
                    class="project-card-demo-icon"
                  />
                </a>
              )}
              {card.demo && (
                <a
                  class="project-card-link"
                  href={card.demo}
                  aria-label={t.demoOf.replace('{name}', card.name)}
                >
                  {t.demo}
                  <PixelIcon
                    name="arrow-up-right"
                    class="project-card-demo-icon"
                  />
                </a>
              )}
            </span>
          </div>
          <span class="project-card-border" aria-hidden="true" />
          <span class="project-card-bar" aria-hidden="true" />
        </li>
      ))}
    </ul>
  </div>
</NumberedSection>

<style>
  .projects-main {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  .projects-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
  }
  /* Three columns: the featured project takes the first row, its text beside
     its cover, and the other three fill the row below. */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The master's document card: 1rem between the text and the cover, 1.5rem
     between the cover and the link row. */
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid var(--line);
    color: var(--ink);
    transition: color 0.3s ease;
  }
  .project-card-featured {
    grid-column: 1 / -1;
  }
  @media (width >= 62rem) {
    .project-card-featured {
      gap: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      grid-template-rows: minmax(0, 1fr) auto;
    }
    .project-card-featured .project-card-cover {
      grid-row: 1 / span 2;
      grid-column: 2;
      min-height: 22rem;
      margin: 0;
      border-left: 1px solid var(--line);
    }
    .project-card-featured .project-card-links {
      grid-column: 1;
    }
  }
  .project-card-top {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 13rem;
    padding: 1.5rem 1.5rem 0;
  }
  .project-card-heading {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .project-card-title {
    margin: 0;
    font-size: var(--text-medium);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
  }
  .project-card-featured .project-card-title {
    font-size: var(--text-large);
  }
  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-card-tag {
    padding: 0.2em 0;
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .project-card-line {
    margin: 0;
    color: var(--muted);
  }
  .project-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .project-card-meta .tag {
    align-self: auto;
  }
  .project-card-number {
    color: var(--muted);
    font-weight: 500;
  }
  .project-card-slashes {
    opacity: 0.5;
  }
  /* A cover generated from the name, chosen from captures on 2026-09-22
     over cards with no image: no screenshot may be published, and the cover
     keeps the master's document-card rhythm. */
  .project-card-cover {
    background-size: 12.61px;
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-height: 9rem;
    margin: 0 1px 0.5rem;
    overflow: hidden;
  }
  .project-card-cover-name {
    padding-inline: 1rem;
    color: var(--ink);
    font-family: var(--font-pixel);
    font-size: var(--text-large);
    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
    transition: transform 0.3s ease;
  }
  .project-card-featured .project-card-cover-name {
    font-size: var(--text-display);
  }
  .project-card-links {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: space-between;
    margin-top: auto;
    border-top: 1px solid var(--line);
  }
  .project-card-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3rem;
    padding: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
  }
  .project-card-private {
    color: var(--faint);
  }
  .project-card :global(.project-card-demo-icon) {
    width: 0.625rem;
    height: 0.625rem;
  }
  .project-card-arrow {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    overflow: hidden;
  }
  .project-card-arrow :global(svg) {
    position: absolute;
    inset: 0.125rem;
    transition: transform 0.3s ease;
  }
  .project-card-arrow :global(svg:last-child) {
    transform: translate(-150%, 150%);
  }
  /* The whole card follows its code link: the link's box stretches over the
     card, the demo link sits above it. */
  .project-card-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .project-card-secondary {
    display: flex;
  }
  .project-card-links a:not(.project-card-primary) {
    position: relative;
    z-index: 2;
  }
  .project-card-border {
    position: absolute;
    inset: -1px;
    z-index: 2;
    border: 1px solid var(--accent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  /* A card that leads somewhere stands on an ink rule; on hover the rule
     fills with a 4px accent bar, as the master's document cards do. */
  .project-card-linked {
    border-bottom-color: var(--ink);
  }
  .project-card-bar {
    position: absolute;
    bottom: -1px;
    left: -1px;
    z-index: 2;
    width: 0;
    height: 4px;
    background: var(--accent);
    pointer-events: none;
    transition: width 0.3s ease;
  }
  .project-card-linked:hover .project-card-bar,
  .project-card-linked:focus-within .project-card-bar {
    width: calc(100% + 2px);
  }
  .project-card-linked:hover,
  .project-card-linked:focus-within {
    color: var(--accent);
  }
  .project-card-linked:hover .project-card-border,
  .project-card-linked:focus-within .project-card-border {
    opacity: 1;
  }
  .project-card-linked:hover .project-card-cover-name {
    transform: translateY(-2rem);
  }
  .project-card-linked:hover .project-card-arrow :global(svg:first-child) {
    transform: translate(150%, -150%);
  }
  .project-card-linked:hover .project-card-arrow :global(svg:last-child) {
    transform: none;
  }
  @media (width < 62rem) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .project-card:last-child {
      grid-column: span 2;
    }
  }
  @media (width < 48rem) {
    .projects-heading {
      flex-direction: column;
      gap: var(--space-small);
    }
    .project-card-cover-name {
      font-size: var(--text-medium);
    }
    .project-card-link {
      padding-inline: 1rem;
    }
    .project-card-featured .project-card-cover-name {
      font-size: var(--text-large);
    }
    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .project-card-featured,
    .project-card:last-child {
      grid-column: auto;
    }
  }
  /* On a phone the master's document cards stand 2rem apart, their titles
     a step down and their pictures at least 10rem tall. */
  @media (width < 30rem) {
    .projects-grid {
      gap: 2rem;
    }
    .project-card-top {
      min-height: auto;
    }
    .project-card-heading {
      gap: 0.5rem;
    }
    .project-card-title {
      font-size: 1.25rem;
    }
    .project-card-featured .project-card-title {
      font-size: var(--text-medium);
    }
    .project-card-cover {
      min-height: 10rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card-border,
    .project-card-bar,
    .project-card-cover-name,
    .project-card-arrow :global(svg) {
      transition: none;
    }
  }
</style>
