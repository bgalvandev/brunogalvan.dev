---
import Button from '@/components/button.astro';
import Logo from '@/components/logo.astro';
import PixelField from '@/components/pixel-field.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import { site } from '@/config/site';
import TechLogo from '@/components/tech-logo.astro';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { hero, identity, positioning } = messages(locale);
// The scroll cue: a stepped arrow 7 cells by 8, one pixel a cell.
const scrollArrow = [
  '...#...',
  '...#...',
  '...#...',
  '...#...',
  '#..#..#',
  '.#.#.#.',
  '..###..',
  '...#...',
];
// The logo row: six tools of the current stack, each with a published mark,
// standing still in six cells on a desktop and running as a band below it
// (the owner's choice on 2026-11-10). The row is drawn twice so the band can
// loop; the copy shows only while it runs.
const tools = [
  'React',
  'TypeScript',
  'Node.js',
  'Fastify',
  'PostgreSQL',
  'Astro',
] as const;
---

<section class="section hero" aria-labelledby="hero-title">
  <div class="band hero-band">
    <PixelField />
    <div class="measure hero-band-content">
      <p class="hero-name">
        <Logo class="hero-name-text" />
        <span class="hero-name-tag">{identity.location}</span>
      </p>
      <p class="hero-scroll label" aria-hidden="true">
        <span>{hero.scroll}</span>
        <PixelIcon rows={scrollArrow} class="hero-scroll-icon" />
      </p>
    </div>
  </div>
  <div class="hero-body">
    <div class="measure hero-top">
      <h1
        id="hero-title"
        class="hero-heading text-display"
        aria-label={hero.spoken}
      >
        <span
          class="hero-visual"
          aria-hidden="true"
          data-reveal
          data-reveal-duration="0.6"
        >
          <span class="hero-line">{hero.greeting}</span>
          {/* The typed fragment flows with its brackets, so on a phone the
              line wraps where the words fall, the closing bracket included. */}
          <span
            class="hero-line hero-fragment pixel-highlight"
            data-reveal-skip
          >
            {[
              '[ ',
              <span
                data-typewriter
                data-typewriter-words={hero.fragments.join('|')}
                data-typewriter-delay="2"
              >
                {hero.fragments[0]}
              </span>,
              ' ]',
            ]}
          </span>
          <span class="hero-line">{hero.closing}</span>
        </span>
      </h1>
      <div class="hero-content">
        <p class="hero-summary">{hero.line}</p>
        <div class="hero-actions">
          <Button href="#projects" label={hero.primary} icon="arrow-down" />
          <Button
            href={`mailto:${site.email}`}
            label={hero.secondary}
            variant="line"
          />
        </div>
      </div>
    </div>
    <div class="measure hero-main">
      <div class="hero-logos" aria-hidden="true">
        {[0, 1].map((copy) => (
          <ul class:list={['hero-logos-row', { 'hero-logos-copy': copy }]}>
            {tools.map((tool) => (
              <li class="hero-logo">
                <TechLogo name={tool} />
              </li>
            ))}
          </ul>
        ))}
      </div>
      <div class="hero-positioning field-dotted">
        <p class="hero-positioning-main">
          <span class="sr-only">{positioning.spoken}</span>
          <span class="hero-positioning-bracket" aria-hidden="true">
            &gt;
          </span>
          <span class="hero-positioning-text" aria-hidden="true" data-reveal>
            {positioning.parts.map((part, index) => (
              <>
                <span class="hero-positioning-step">
                  <span class="hero-positioning-part">{part}</span>
                  {index === 0 && (
                    <svg class="hero-positioning-glyph" viewBox="0 0 10 10">
                      <path d="M0 4.4h8.3v1.2H0zM5.3 1.1l.85-.85L10 5 6.15 9.75 5.3 8.9 8.3 5z" />
                    </svg>
                  )}
                  {index === 1 && (
                    <svg
                      class="hero-positioning-glyph hero-positioning-squares"
                      viewBox="0 0 63 28"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M0 0h24v24H0zm1 1v22h22V1zM24 4h4v24H4v-4h20zM35 4h24v24H35zm1 1v22h22V5zM39 0h24v24h-4V4H39z"
                      />
                    </svg>
                  )}
                </span>
                {index < positioning.parts.length - 1 && ' '}
              </>
            ))}
          </span>
          <span class="hero-positioning-bracket" aria-hidden="true">
            &lt;
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  /* The dark room fills what the statement leaves of the first screen and
     sticks while the statement scrolls over it. */
  .hero-band {
    position: sticky;
    top: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    min-height: 40vh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
  }
  .hero-band-content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }
  .hero-name {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin: 0;
  }
  .hero-name :global(.hero-name-text) {
    font-size: var(--text-large);
  }
  /* The version chip: a lighter block than the band, its text kept light
     enough to pass contrast. */
  .hero-name-tag {
    padding: 0.1em 0.25em;
    background: var(--decor);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1.3rem;
    text-transform: uppercase;
  }
  .hero-scroll {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--faint);
    font-size: var(--text-small);
    font-weight: 400;
    line-height: 1.3rem;
    letter-spacing: -0.05rem;
  }
  /* The arrow is drawn 7 by 8 in a 12px box. */
  .hero-scroll :global(.hero-scroll-icon) {
    width: 0.75rem;
    height: 0.75rem;
    padding: 0.125rem 0.15625rem;
  }
  .hero-body {
    position: relative;
    z-index: 2;
    padding-bottom: var(--space-large);
    background: var(--paper);
  }
  .hero-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-block: var(--space-small) var(--space-medium);
  }
  /* The heading holds its lines whole, at least 43rem wide, until a phone
     lets it wrap. */
  .hero-heading {
    min-width: 43rem;
    margin: 0;
    white-space: nowrap;
  }
  .hero-visual,
  .hero-line {
    display: block;
  }
  /* The greeting and the closing break between their words evenly when a
     phone wraps them, so no line ends on a word by itself. */
  .hero-line:not(.hero-fragment) {
    text-wrap: balance;
  }
  .hero-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    max-width: 27.5rem;
    margin-left: auto;
    padding-block: 0.75rem;
  }
  .hero-summary {
    margin: 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .hero-main {
    position: relative;
    z-index: 2;
    padding-bottom: var(--space-large);
  }
  /* The logo row: six cells in a closed box, 132px tall, on a desktop. */
  .hero-logos-row {
    display: flex;
    height: 8.25rem;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-right-style: none;
    list-style: none;
  }
  .hero-logos-copy {
    display: none;
  }
  .hero-logo {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: 100%;
    border-right: 1px solid var(--line);
    color: var(--muted);
    font-size: 1.125rem;
  }
  .hero-positioning {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 17.5rem;
    padding: 2rem;
  }
  /* The brackets stand apart from the words, 3% of the row away. */
  .hero-positioning-main {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3%;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-large);
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
  }
  .hero-positioning-bracket {
    padding-bottom: 0.125em;
  }
  /* Each part keeps the glyph after it, so a line ends on a glyph and never
     starts with one. The glyphs are drawn rather than taken from a system
     font, so the arrow and the two shadowed squares look the same on every
     device. */
  .hero-positioning-step {
    white-space: nowrap;
  }
  /* Drawn to their box's edges, so a box snapped to the device grid must not
     clip their last hairline. */
  .hero-positioning-glyph {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-left: 0.4em;
    overflow: visible;
    fill: var(--ink);
    vertical-align: -0.02em;
  }
  /* The squares: each fills the capital height, a hairline square of 0.6em
     with a shadow 0.1em deep, on a grid of 0.025em. */
  .hero-positioning-squares {
    width: 1.575em;
    height: 0.7em;
    margin-left: 0.6em;
    vertical-align: baseline;
  }
  .hero-positioning-part {
    color: var(--accent);
  }
  /* Below the desktop breakpoint the band is half the screen tall, the name
     gone to the header bar and the scroll cue at its foot; the logo row runs
     as a band of cells three tenths of the screen wide (half on a phone),
     and the row and the positioning run edge to edge. */
  @media (width < 62rem) {
    .hero-band {
      flex: 0 auto;
      justify-content: flex-end;
      min-height: 50vh;
    }
    .hero-band-content {
      margin-bottom: 1rem;
    }
    .hero-name {
      display: none;
    }
    .hero-main {
      width: 100%;
    }
    .hero-logos {
      display: flex;
      overflow: hidden;
    }
    .hero-logos-row {
      flex: none;
      height: 7rem;
      border-bottom-style: none;
    }
    .hero-logos-copy {
      display: flex;
    }
    .hero-logo {
      flex: none;
      width: 30vw;
      border-bottom: 1px solid var(--line);
    }
    /* Both rows move their own width every 10 seconds, so the band never
       shows an end; the pause control and reduced motion stop it. */
    .hero-logos-row {
      animation: hero-logos 10s linear infinite;
    }
    :global(html[data-motion='paused']) .hero-logos-row {
      animation-play-state: paused;
    }
  }
  @media (width < 62rem) and (prefers-reduced-motion: reduce) {
    .hero-logos-row {
      animation: none;
    }
  }
  @keyframes hero-logos {
    to {
      transform: translateX(-100%);
    }
  }
  /* Below the tablet breakpoint a line too long for the screen wraps
     rather than pushing the page sideways; one that fits holds whole. */
  @media (width < 48rem) {
    .hero-band {
      height: 17.5rem;
    }
    .hero-heading {
      min-width: auto;
      white-space: normal;
    }
    .hero-content {
      max-width: none;
    }
    .hero-logo {
      width: 50vw;
    }
    .hero-positioning-main {
      font-size: var(--text-medium);
    }
  }
  @media (width < 30rem) {
    .hero-band-content {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 2rem;
    }
    .hero-top {
      flex-flow: column;
      justify-content: flex-start;
    }
    .hero-heading {
      width: 100%;
      min-width: 20rem;
    }
    .hero-content {
      flex: 0 auto;
      margin-left: 0;
    }
    .hero-actions {
      display: flex;
      flex-direction: column;
    }
    .hero-main {
      overflow: hidden;
    }
    .hero-positioning {
      padding: 1rem;
    }
    .hero-positioning-bracket {
      display: none;
    }
  }
</style>
