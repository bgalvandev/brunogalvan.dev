---
import { site } from '@/config/site';
import type { Locale } from '@/i18n/locales';
import { messages } from '@/i18n/messages';
import CodePortrait from './code-portrait.astro';
import { yearsOfExperience } from './experience';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { home, contact } = messages(locale);
// Resolved when the site is built, so a deploy keeps the figure honest.
const intro = home.intro.replace('{years}', String(yearsOfExperience()));
---

<div class="hero">
  <div class="hero-beam" aria-hidden="true"></div>
  <svg class="hero-grid" aria-hidden="true" focusable="false">
    <defs>
      <pattern
        id="lattice"
        width="96"
        height="96"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M0 0H96M0 0V96"
          stroke="currentColor"
          stroke-width="1"
          opacity="0.5"
        ></path>
        <path
          d="M48 44v8M44 48h8"
          stroke="currentColor"
          stroke-width="1"
        ></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#lattice)"></rect>
  </svg>
  <div class="measure hero-layout">
    <div class="enter">
      <h1 class="hero-headline">{home.headline}</h1>
      <p class="hero-intro">{intro}</p>
      <div class="hero-actions">
        <a class="action action-primary" href={`mailto:${site.email}`}>
          {home.actions.email}
        </a>
        <a class="action" href="#projects">
          {home.actions.work}
        </a>
        <a class="action" href={site.github} rel="me">
          {contact.github}
        </a>
      </div>
    </div>
    <div class="hero-plate">
      <CodePortrait locale={locale} />
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</div>

<script>
  // The portrait resolves out of noise, one row after another, the way an
  // image loader settles. Then it keeps breathing: a handful of glyphs flicker
  // and come back, so the panel reads as code still being written rather than
  // a picture of code. Without this script the panel simply fades in.
  const POOL = '{}()[]<>/\\=+-*;:.,_|#$&@%!?01';
  const noise = (length: number) => {
    let out = '';
    for (let i = 0; i < length; i += 1) {
      out += POOL[Math.floor(Math.random() * POOL.length)];
    }
    return out;
  };

  function resolvePortrait() {
    const svg = document.querySelector<SVGSVGElement>('.code-portrait');
    if (!svg || svg.dataset['resolved']) return;
    svg.dataset['resolved'] = 'on';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const rows = Array.from(svg.querySelectorAll('text')).map((row) => {
      const spans = Array.from(row.querySelectorAll('tspan'));
      return {
        spans,
        truth: spans.map((span) => span.textContent ?? ''),
        length: spans.reduce(
          (sum, span) => sum + (span.textContent?.length ?? 0),
          0,
        ),
        shown: -1,
      };
    });
    const every = rows.flatMap((row) => row.spans);

    const ROW_STEP = 22;
    const SETTLE = 560;
    const started = performance.now();

    function paint(row: (typeof rows)[number], revealed: number) {
      let cursor = 0;
      row.spans.forEach((span, index) => {
        const text = row.truth[index] ?? '';
        const end = cursor + text.length;
        if (end <= revealed) {
          if (span.textContent !== text) span.textContent = text;
        } else if (cursor >= revealed) {
          span.textContent = noise(text.length);
        } else {
          span.textContent =
            text.slice(0, revealed - cursor) + noise(end - revealed);
        }
        cursor = end;
      });
    }

    function frame(now: number) {
      let running = false;
      rows.forEach((row, index) => {
        const progress = (now - started - index * ROW_STEP) / SETTLE;
        const revealed =
          progress >= 1
            ? row.length
            : Math.max(0, Math.floor(progress * row.length));
        if (progress < 1) running = true;
        if (revealed === row.shown && progress < 1) return;
        row.shown = revealed;
        paint(row, revealed);
      });
      if (running) requestAnimationFrame(frame);
      else breathe();
    }

    let timer = 0;
    function breathe() {
      window.clearInterval(timer);
      timer = window.setInterval(() => {
        for (let i = 0; i < 10; i += 1) {
          const span = every[Math.floor(Math.random() * every.length)];
          if (!span) continue;
          const settled = span.textContent ?? '';
          span.textContent = noise(settled.length);
          window.setTimeout(() => {
            span.textContent = settled;
          }, 110);
        }
      }, 320);
    }

    requestAnimationFrame(frame);
  }

  resolvePortrait();
  document.addEventListener('astro:page-load', resolvePortrait);
</script>
