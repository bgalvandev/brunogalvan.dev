---
import { site } from '@/config/site';
import type { Locale } from '@/i18n/locales';
import { messages } from '@/i18n/messages';
import { yearsOfExperience } from './experience';
interface Props {
  locale: Locale;
}
const { home, contact } = messages(Astro.props.locale);
// Resolved when the site is built, so a deploy keeps the figure honest.
const intro = home.intro.replace('{years}', String(yearsOfExperience()));
---

<div class="hero">
  <div class="hero-beam" aria-hidden="true"></div>
  <svg class="hero-grid" aria-hidden="true" focusable="false">
    <defs>
      <pattern
        id="lattice"
        width="96"
        height="96"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M0 0H96M0 0V96"
          stroke="currentColor"
          stroke-width="1"
          opacity="0.5"
        ></path>
        <path
          d="M48 44v8M44 48h8"
          stroke="currentColor"
          stroke-width="1"
        ></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#lattice)"></rect>
  </svg>
  <svg class="grain" aria-hidden="true" focusable="false">
    <filter id="grain-filter">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.9"
        numOctaves="3"
      ></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
    <rect
      width="100%"
      height="100%"
      filter="url(#grain-filter)"
      opacity="0.28"
    ></rect>
  </svg>
  <div class="enter">
    <p class="hero-meta">
      <span>{home.role}</span>
      <span class="hero-dot" aria-hidden="true"></span>
      <span>{home.location}</span>
    </p>
    <h1 class="hero-headline">{home.headline}</h1>
    <p class="hero-intro">{intro}</p>
    <div class="hero-actions">
      <a class="action action-primary" href={`mailto:${site.email}`}>
        {home.actions.email}
      </a>
      <a class="action" href="#projects">
        {home.actions.work}
      </a>
      <a class="action" href={site.github} rel="me">
        {contact.github}
      </a>
    </div>
  </div>
</div>
