---
import Button from '@/components/button.astro';
import Logo from '@/components/logo.astro';
import Marquee from '@/components/marquee.astro';
import { marks } from '@/components/tech-marks';
import PixelField from '@/components/pixel-field.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import { site } from '@/config/site';
import { stack } from '@/data/stack';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { hero, identity, positioning } = messages(locale);
// The scroll cue: a stepped arrow 7 cells by 8, one pixel a cell.
const scrollArrow = [
  '...#...',
  '...#...',
  '...#...',
  '...#...',
  '#..#..#',
  '.#.#.#.',
  '..###..',
  '...#...',
];
// The toolchain band carries every tool the record names that has a mark of
// its own, as a carousel (the owner's choice) of logo cells.
const tools = Object.values(stack)
  .flat()
  .filter((tool) => marks.has(tool));
---

<section class="section hero" aria-labelledby="hero-title">
  <div class="band hero-band">
    <PixelField />
    <div class="measure hero-band-content">
      <p class="hero-name">
        <Logo class="hero-name-text" />
        <span class="hero-name-tag">{identity.location}</span>
      </p>
      <p class="hero-scroll label" aria-hidden="true">
        <span>{hero.scroll}</span>
        <PixelIcon rows={scrollArrow} class="hero-scroll-icon" />
      </p>
    </div>
  </div>
  <div class="hero-body">
    <div class="measure hero-top">
      <h1
        id="hero-title"
        class="hero-heading text-display"
        aria-label={hero.spoken}
      >
        <span
          class="hero-visual"
          aria-hidden="true"
          data-reveal
          data-reveal-duration="0.6"
        >
          <span class="hero-line">{hero.greeting}</span>
          <span
            class="hero-line hero-fragment pixel-highlight"
            data-reveal-skip
            data-typewriter-line
          >
            {/* Arrays, so no whitespace creeps between the brackets and the
                word the script types. Behind the typed word the whole word
                stands unseen in the same cell, so the line takes its full
                height before the first letter and nothing below moves while
                it types; the script swaps the unseen word with each one. */}
            <span>
              {[
                '[\u00a0',
                <span
                  data-typewriter
                  data-typewriter-words={hero.fragments.join('|')}
                  data-typewriter-delay="2"
                >
                  {hero.fragments[0]}
                </span>,
                '\u00a0]',
              ]}
            </span>
            {hero.fragments.map((word, index) => (
              <span
                class="hero-fragment-ghost"
                data-typewriter-ghost
                hidden={index > 0}
              >
                {[
                  '[\u00a0',
                  <span class="hero-fragment-word">{word}</span>,
                  '\u00a0]',
                ]}
              </span>
            ))}
          </span>
          <span class="hero-line">{hero.closing}</span>
        </span>
      </h1>
      <div class="hero-content">
        <p class="hero-summary">{hero.line}</p>
        <div class="hero-actions">
          <Button href="#projects" label={hero.primary} icon="arrow-down" />
          <Button
            href={`mailto:${site.email}`}
            label={hero.secondary}
            variant="line"
          />
        </div>
      </div>
    </div>
    <div class="measure hero-main">
      <Marquee items={tools} variant="logos" />
      <div class="hero-positioning field-dotted">
        <p class="hero-positioning-text">
          <span class="sr-only">{positioning.spoken}</span>
          <span aria-hidden="true" data-reveal>
            <span class="hero-positioning-bracket">&gt;</span>
            {positioning.parts.map((part, index) => (
              <>
                <span class="hero-positioning-step">
                  <span class="hero-positioning-part">{part}</span>
                  {index === 0 && (
                    <svg class="hero-positioning-glyph" viewBox="0 0 10 10">
                      <path d="M0 4.4h8.3v1.2H0zM5.3 1.1l.85-.85L10 5 6.15 9.75 5.3 8.9 8.3 5z" />
                    </svg>
                  )}
                  {index === 1 && (
                    <svg
                      class="hero-positioning-glyph hero-positioning-squares"
                      viewBox="0 0 63 28"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M0 0h24v24H0zm1 1v22h22V1zM24 4h4v24H4v-4h20zM35 4h24v24H35zm1 1v22h22V5zM39 0h24v24h-4V4H39z"
                      />
                    </svg>
                  )}
                </span>
                {index < positioning.parts.length - 1 && ' '}
              </>
            ))}
            <span class="hero-positioning-bracket">&lt;</span>
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  /* The dark room sticks while the statement scrolls over it. */
  .hero-band {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 40vh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
  }
  .hero-band-content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3rem;
  }
  .hero-name {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin: 0;
  }
  .hero-name :global(.hero-name-text) {
    font-size: var(--text-large);
  }
  /* The version chip: a lighter block than the band, its text kept light
     enough to pass contrast. */
  .hero-name-tag {
    padding: 0.1em 0.25em;
    background: var(--decor);
    color: var(--muted);
    line-height: 1.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--text-small--letter-spacing);
    text-transform: uppercase;
  }
  .hero-scroll {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--faint);
    font-size: var(--text-small);
    font-weight: 400;
    line-height: 1.3rem;
    letter-spacing: var(--text-small--letter-spacing);
  }
  /* The arrow is drawn 7 by 8 in a 12px box. */
  .hero-scroll :global(.hero-scroll-icon) {
    width: 0.75rem;
    height: 0.75rem;
    padding: 0.125rem 0.15625rem;
  }
  .hero-body {
    position: relative;
    z-index: 1;
    padding-bottom: calc(2 * var(--space-large));
    background: var(--paper);
  }
  .hero-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-block: var(--space-small) var(--space-medium);
  }
  .hero-heading {
    margin: 0;
    min-width: min(43rem, 100%);
  }
  .hero-visual,
  .hero-line {
    display: block;
  }
  /* On a narrow phone the greeting breaks between its sentences, as the
     headlines do, rather than leaving a word alone at a line's end. */
  .hero-line {
    text-wrap: balance;
  }
  .hero-fragment {
    display: grid;
  }
  .hero-fragment > * {
    grid-area: 1 / 1;
  }
  .hero-fragment-ghost {
    visibility: hidden;
  }
  /* The typed word's cursor, so a ghost wraps where the word will. */
  .hero-fragment-word::after {
    content: '\2060';
    margin-left: 2px;
    padding-left: 0.55em;
  }
  .hero-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    max-width: 27.5rem;
    margin-left: auto;
    padding-block: 0.75rem;
  }
  .hero-summary {
    margin: 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .hero-positioning {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 17.5rem;
    padding: 2rem;
  }
  .hero-positioning-text {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-large);
    line-height: var(--text-large--line-height);
    letter-spacing: var(--text-large--letter-spacing);
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }
  /* Each part keeps the glyph after it, so a line ends on a glyph and never
     starts with one. The glyphs are drawn rather than taken from a system
     font, so the arrow and the two shadowed squares look the same on every
     device. */
  .hero-positioning-step {
    white-space: nowrap;
  }
  /* Drawn to their box's edges, so a box snapped to the device grid must not
     clip their last hairline. */
  .hero-positioning-glyph {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-left: 0.4em;
    overflow: visible;
    fill: var(--ink);
    vertical-align: -0.02em;
  }
  /* The squares: each fills the capital height, a hairline square of 0.6em
     with a shadow 0.1em deep, on a grid of 0.025em. */
  .hero-positioning-squares {
    width: 1.575em;
    height: 0.7em;
    margin-left: 0.6em;
    vertical-align: baseline;
  }
  .hero-positioning-part {
    color: var(--accent);
  }
  /* The brackets keep 0.5em from their words so the longer line still
     holds to one row, and lift 2px. */
  .hero-positioning-bracket {
    position: relative;
    top: -0.0625em;
    margin-inline: 0.5em;
  }
  /* Below the desktop breakpoint the band is half the screen tall, the name
     gone to the header bar, and the scroll cue at its foot on the left; the
     logo row and the positioning run edge to edge. */
  @media (width < 62rem) {
    .hero-band {
      justify-content: flex-end;
      min-height: 50vh;
    }
    .hero-band-content {
      padding-block: 0 1rem;
    }
    .hero-name {
      display: none;
    }
    .hero-content {
      margin-left: 0;
    }
    .hero-main {
      width: 100%;
    }
  }
  @media (width < 48rem) {
    .hero-positioning-text {
      font-size: var(--text-medium);
    }
    /* The fragment may take two lines; its brackets hold to its words. */
    .hero-fragment {
      white-space: normal;
    }
  }
  @media (width < 30rem) {
    .hero-positioning {
      padding: 1rem;
    }
    .hero-positioning-bracket {
      display: none;
    }
    .hero-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
