---
import Button from '@/components/button.astro';
import Marquee from '@/components/marquee.astro';
import PixelField from '@/components/pixel-field.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import { site } from '@/config/site';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { stack } from '@/data/stack';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { hero, identity, positioning } = messages(locale);
const tools = Object.values(stack).flat();
---

<section class="section hero" aria-labelledby="hero-title">
  <div class="band hero-band">
    <PixelField />
    <div class="measure hero-band-content">
      <p class="hero-name">
        <span class="hero-name-text">{site.name}</span>
        <span class="hero-name-tag">{identity.location}</span>
      </p>
      <p class="hero-scroll label" aria-hidden="true">
        <span>{hero.scroll}</span>
        <PixelIcon name="arrow-down" class="hero-scroll-icon" />
      </p>
    </div>
  </div>
  <div class="hero-body">
    <div class="measure hero-top">
      <h1
        id="hero-title"
        class="hero-heading text-display"
        aria-label={hero.spoken}
      >
        <span
          class="hero-visual"
          aria-hidden="true"
          data-reveal
          data-reveal-duration="0.6"
        >
          <span class="hero-line">{hero.greeting}</span>
          <span
            class="hero-line hero-fragment pixel-highlight"
            data-reveal-skip
          >
            {'[\u00a0'}
            <span data-typewriter>{hero.fragment}</span>
            {'\u00a0]'}
          </span>
          <span class="hero-line">{hero.closing}</span>
        </span>
      </h1>
      <div class="hero-content">
        <p class="hero-summary">{hero.line}</p>
        <div class="hero-actions">
          <Button href="#projects" label={hero.primary} icon="arrow-down" />
          <Button
            href={`mailto:${site.email}`}
            label={hero.secondary}
            variant="line"
          />
        </div>
      </div>
    </div>
    <div class="measure hero-main">
      <Marquee items={tools} />
      <div class="hero-positioning field-dotted">
        <p class="hero-positioning-text">
          <span class="sr-only">{positioning.spoken}</span>
          <span aria-hidden="true" data-reveal>
            <span class="hero-positioning-bracket">&gt;</span>
            {positioning.parts.map((part, index) => (
              <>
                <span class="hero-positioning-step">
                  <span class="hero-positioning-part">{part}</span>
                  {index < positioning.parts.length - 1 && ' →'}
                </span>
                {index < positioning.parts.length - 1 && ' '}
              </>
            ))}
            <span class="hero-positioning-bracket">&lt;</span>
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  /* The dark room sticks while the statement scrolls over it. */
  .hero-band {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 40vh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
  }
  .hero-band-content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 4rem 2rem;
  }
  .hero-name {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin: 0;
  }
  .hero-name-text {
    font-size: var(--text-large);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .hero-name-tag {
    padding: 0.1em 0.25em;
    background: var(--surface);
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--text-small--letter-spacing);
    text-transform: uppercase;
  }
  .hero-scroll {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--faint);
    font-size: var(--text-small);
  }
  .hero-scroll :global(.hero-scroll-icon) {
    width: 0.75rem;
    height: 0.75rem;
  }
  .hero-body {
    position: relative;
    z-index: 1;
    padding-bottom: 5rem;
    background: var(--paper);
  }
  .hero-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3rem 4rem;
  }
  .hero-heading {
    margin: 0;
    min-width: min(43rem, 100%);
  }
  .hero-visual,
  .hero-line {
    display: block;
  }
  .hero-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    max-width: 27.5rem;
    margin-left: auto;
    padding-block: 0.75rem;
  }
  .hero-summary {
    margin: 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .hero-positioning {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 17.5rem;
    padding: 2rem;
  }
  .hero-positioning-text {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-large);
    line-height: var(--text-large--line-height);
    letter-spacing: var(--text-label--letter-spacing);
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }
  /* Each part keeps its arrow, so a line ends on an arrow and never starts
     with one. */
  .hero-positioning-step {
    white-space: nowrap;
  }
  .hero-positioning-part {
    color: var(--accent);
  }
  .hero-positioning-bracket {
    margin-inline: 0.5em;
  }
  @media (width < 62rem) {
    .hero-content {
      margin-left: 0;
    }
  }
  @media (width < 48rem) {
    .hero-positioning-text {
      font-size: var(--text-medium);
    }
  }
  @media (width < 30rem) {
    /* On a phone the fragment may take two lines, and keeps room for both so
       nothing below moves while it types. The brackets hold to its words. */
    .hero-fragment {
      min-height: calc(2em * var(--text-display--line-height));
      white-space: normal;
    }
    .hero-positioning {
      padding: 1rem;
    }
    .hero-positioning-bracket {
      display: none;
    }
    .hero-positioning-text {
      font-size: 1.125rem;
    }
    .hero-actions {
      grid-template-columns: 1fr;
    }
    .hero-scroll {
      display: none;
    }
  }
</style>
