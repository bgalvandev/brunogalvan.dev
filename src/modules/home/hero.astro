---
import Button from '@/components/button.astro';
import Logo from '@/components/logo.astro';
import Marquee from '@/components/marquee.astro';
import { marks } from '@/components/tech-marks';
import PixelField from '@/components/pixel-field.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import { site } from '@/config/site';
import { stack } from '@/data/stack';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { hero, identity, positioning } = messages(locale);
// The master's scroll cue: a stepped arrow 7 cells by 8, one pixel a cell.
const scrollArrow = [
  '...#...',
  '...#...',
  '...#...',
  '...#...',
  '#..#..#',
  '.#.#.#.',
  '..###..',
  '...#...',
];
// The toolchain band carries every tool the record names that has a mark of
// its own, as a carousel (the owner's choice), in the master's cells.
const tools = Object.values(stack)
  .flat()
  .filter((tool) => marks.has(tool));
---

<section class="section hero" aria-labelledby="hero-title">
  <div class="band hero-band">
    <PixelField />
    <div class="measure hero-band-content">
      <p class="hero-name">
        <Logo class="hero-name-text" />
        <span class="hero-name-tag">{identity.location}</span>
      </p>
      <p class="hero-scroll label" aria-hidden="true">
        <span>{hero.scroll}</span>
        <PixelIcon rows={scrollArrow} class="hero-scroll-icon" />
      </p>
    </div>
  </div>
  <div class="hero-body">
    <div class="measure hero-top">
      <h1
        id="hero-title"
        class="hero-heading text-display"
        aria-label={hero.spoken}
      >
        <span
          class="hero-visual"
          aria-hidden="true"
          data-reveal
          data-reveal-duration="0.6"
        >
          <span class="hero-line">{hero.greeting}</span>
          <span
            class="hero-line hero-fragment pixel-highlight"
            data-reveal-skip
          >
            {/* An array, so no whitespace creeps between the brackets and
                the word the script types. */}
            {[
              '[\u00a0',
              <span
                data-typewriter
                data-typewriter-words={hero.fragments.join('|')}
              >
                {hero.fragments[0]}
              </span>,
              '\u00a0]',
            ]}
          </span>
          <span class="hero-line">{hero.closing}</span>
        </span>
      </h1>
      <div class="hero-content">
        <p class="hero-summary">{hero.line}</p>
        <div class="hero-actions">
          <Button href="#projects" label={hero.primary} icon="arrow-down" />
          <Button
            href={`mailto:${site.email}`}
            label={hero.secondary}
            variant="line"
          />
        </div>
      </div>
    </div>
    <div class="measure hero-main">
      <Marquee items={tools} variant="logos" />
      <div class="hero-positioning field-dotted">
        <p class="hero-positioning-text">
          <span class="sr-only">{positioning.spoken}</span>
          <span aria-hidden="true" data-reveal>
            <span class="hero-positioning-bracket">&gt;</span>
            {positioning.parts.map((part, index) => (
              <>
                <span class="hero-positioning-step">
                  <span class="hero-positioning-part">{part}</span>
                  {index === 0 && (
                    <svg class="hero-positioning-glyph" viewBox="0 0 10 10">
                      <path d="M0 4.4h8.3v1.2H0zM5.3 1.1l.85-.85L10 5 6.15 9.75 5.3 8.9 8.3 5z" />
                    </svg>
                  )}
                  {index === 1 && (
                    <svg
                      class="hero-positioning-glyph hero-positioning-squares"
                      viewBox="0 0 21 10"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M0 1h8v8H0zm.9.9v6.2h6.2V1.9zM8 2h1v8H1V9h7zM12 2h8v8h-8zm.9.9v6.2h6.2V2.9zM13 1V0h8v9h-1V1z"
                      />
                    </svg>
                  )}
                </span>
                {index < positioning.parts.length - 1 && ' '}
              </>
            ))}
            <span class="hero-positioning-bracket">&lt;</span>
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  /* The dark room sticks while the statement scrolls over it. */
  .hero-band {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 40vh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
  }
  .hero-band-content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3rem;
  }
  .hero-name {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin: 0;
  }
  .hero-name :global(.hero-name-text) {
    font-size: var(--text-large);
  }
  /* The master's version chip: a lighter block than the band, its text kept
     light enough to pass contrast. */
  .hero-name-tag {
    padding: 0.1em 0.25em;
    background: var(--decor);
    color: var(--muted);
    line-height: 1.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--text-small--letter-spacing);
    text-transform: uppercase;
  }
  .hero-scroll {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--faint);
    font-size: var(--text-small);
    font-weight: 400;
    line-height: 1.3rem;
    letter-spacing: var(--text-small--letter-spacing);
  }
  /* The master's arrow is drawn 7 by 8 in a 12px box. */
  .hero-scroll :global(.hero-scroll-icon) {
    width: 0.75rem;
    height: 0.75rem;
    padding: 0.125rem 0.15625rem;
  }
  .hero-body {
    position: relative;
    z-index: 1;
    padding-bottom: 10rem;
    background: var(--paper);
  }
  .hero-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3rem 4rem;
  }
  .hero-heading {
    margin: 0;
    min-width: min(43rem, 100%);
  }
  .hero-visual,
  .hero-line {
    display: block;
  }
  .hero-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    max-width: 27.5rem;
    margin-left: auto;
    padding-block: 0.75rem;
  }
  .hero-summary {
    margin: 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .hero-positioning {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 17.5rem;
    padding: 2rem;
  }
  .hero-positioning-text {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-large);
    line-height: var(--text-large--line-height);
    letter-spacing: var(--text-large--letter-spacing);
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }
  /* Each part keeps the glyph after it, so a line ends on a glyph and never
     starts with one. The glyphs are drawn, where the master borrows an arrow
     and two shadowed squares from whatever system font has them. */
  .hero-positioning-step {
    white-space: nowrap;
  }
  .hero-positioning-glyph {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-left: 0.4em;
    fill: var(--ink);
    vertical-align: -0.02em;
  }
  .hero-positioning-squares {
    width: 1.3em;
    height: 0.62em;
  }
  .hero-positioning-part {
    color: var(--accent);
  }
  /* The master sets its brackets 3% of the line from its shorter words;
     these keep 0.5em so the longer line still holds to one row. Both lift
     them 2px. */
  .hero-positioning-bracket {
    position: relative;
    top: -0.0625em;
    margin-inline: 0.5em;
  }
  @media (width < 62rem) {
    .hero-content {
      margin-left: 0;
    }
  }
  @media (width < 48rem) {
    .hero-positioning-text {
      font-size: var(--text-medium);
    }
  }
  @media (width < 30rem) {
    /* On a phone the fragment may take two lines, and keeps room for both so
       nothing below moves while it types. The brackets hold to its words. */
    .hero-fragment {
      min-height: calc(2em * var(--text-display--line-height));
      white-space: normal;
    }
    .hero-positioning {
      padding: 1rem;
    }
    .hero-positioning-bracket {
      display: none;
    }
    .hero-positioning-text {
      font-size: 1.125rem;
    }
    .hero-actions {
      grid-template-columns: 1fr;
    }
    .hero-scroll {
      display: none;
    }
  }
</style>
