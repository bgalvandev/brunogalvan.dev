---
import Button from '@/components/button.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import { site } from '@/config/site';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { hero, identity } = messages(locale);
---

<section class="section hero" aria-labelledby="hero-title">
  <div class="band hero-band">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="measure hero-band-content">
      <p class="hero-name">
        <span class="hero-name-text">{site.name}</span>
        <span class="hero-name-tag">{identity.location}</span>
      </p>
      <p class="hero-scroll label" aria-hidden="true">
        <span>{hero.scroll}</span>
        <PixelIcon name="arrow-down" class="hero-scroll-icon" />
      </p>
    </div>
  </div>
  <div class="hero-body">
    <div class="measure hero-top">
      <h1 id="hero-title" class="hero-heading text-display">
        <span class="sr-only">{hero.spoken}</span>
        <span class="hero-visual" aria-hidden="true">
          <span class="hero-line">{hero.greeting}</span>
          <span class="hero-line hero-highlight">
            [ <span class="hero-fragment">{hero.fragment}</span>
            <span class="hero-cursor"></span> ]
          </span>
          <span class="hero-line">{hero.closing}</span>
        </span>
      </h1>
      <div class="hero-content">
        <p class="hero-summary">{hero.line}</p>
        <div class="hero-actions">
          <Button href={`mailto:${site.email}`} label={hero.primary} />
          <Button
            href={site.github}
            label={hero.secondary}
            variant="line"
            icon="arrow-up-right"
            rel="me"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The dark room sticks while the statement scrolls over it. */
  .hero-band {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 40vh;
    overflow: hidden;
    container-type: inline-size;
    background: var(--paper);
    color: var(--ink);
  }
  /* A static grid of square cells, one thirtieth of the width each. */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: calc(100cqw / 30) calc(100cqw / 30);
  }
  .hero-band-content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 4rem 2rem;
  }
  .hero-name {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin: 0;
  }
  .hero-name-text {
    font-size: var(--text-large);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .hero-name-tag {
    padding: 0.1em 0.25em;
    background: var(--surface);
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--text-small--letter-spacing);
    text-transform: uppercase;
  }
  .hero-scroll {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--faint);
    font-size: var(--text-small);
  }
  .hero-scroll :global(.hero-scroll-icon) {
    width: 0.75rem;
    height: 0.75rem;
  }
  .hero-body {
    position: relative;
    z-index: 1;
    background: var(--paper);
  }
  .hero-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3rem 5rem;
  }
  .hero-heading {
    margin: 0;
    min-width: min(43rem, 100%);
  }
  .hero-visual,
  .hero-line {
    display: block;
  }
  .hero-highlight {
    color: var(--accent);
    font-family: var(--font-pixel);
    letter-spacing: 0;
    white-space: nowrap;
  }
  .hero-cursor {
    display: inline-block;
    width: 0.55em;
    height: 0.9em;
    margin-left: 0.05em;
    background: currentColor;
    vertical-align: -0.05em;
  }
  .hero-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    max-width: 27.5rem;
    margin-left: auto;
    padding-block: 0.75rem;
  }
  .hero-summary {
    margin: 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (width < 62rem) {
    .hero-content {
      margin-left: 0;
    }
  }
  @media (width < 30rem) {
    .hero-actions {
      grid-template-columns: 1fr;
    }
    .hero-scroll {
      display: none;
    }
  }
</style>
