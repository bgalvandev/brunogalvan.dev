---
import type { Locale } from '@/i18n/locales';
import { messages } from '@/i18n/messages';
import Workstation from './workstation.astro';
interface Props {
  locale: Locale;
}
const { room } = messages(Astro.props.locale);
---

<!-- A band that bleeds edge to edge: the page changes world here, and the only
     thing in it is the drawing of the place the rest of the page comes from. -->
<section class="section room-band band-shade" aria-labelledby="room-heading">
  <div class="measure">
    <h2 class="section-head" id="room-heading">
      <span class="section-tag" aria-hidden="true">
        [N.03/07]
      </span>
      <span class="section-rule" aria-hidden="true"></span>
      <span class="section-name">
        <span aria-hidden="true">&gt;</span>
        {room.heading}
      </span>
      <span class="section-rule section-rule-run" aria-hidden="true"></span>
    </h2>
    <div class="section-body room-layout">
      <p class="room-line">{room.line}</p>
      <div class="room-figure reveal">
        <Workstation />
      </div>
    </div>
  </div>
</section>
