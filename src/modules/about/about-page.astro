---
import Headline from '@/components/headline.astro';
import NumberedSection from '@/components/numbered-section.astro';
import PageHero from '@/components/page-hero.astro';
import SiteFooter from '@/components/site-footer.astro';
import SiteHeader from '@/components/site-header.astro';
import StackGrid from '@/components/stack-grid.astro';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { aboutPage: page } = messages(locale);
---

<SiteHeader locale={locale} route="about" />
<main id="main" tabindex="-1">
  <PageHero label={page.label} lines={page.headline} intro={page.intro} />
  <NumberedSection
    id="rules"
    number={1}
    total={3}
    label={page.method.label}
    locale={locale}
    headingId="rules-title"
  >
    <div class="about-main">
      <Headline id="rules-title" lines={page.method.headline} />
      <ol class="rules">
        {page.method.rules.map((rule, index) => (
          <li class="rule">
            <span class="rule-number" aria-hidden="true">
              // {String(index + 1).padStart(3, '0')}
            </span>
            <h3 class="rule-title">{rule.title}</h3>
            <p class="rule-text">{rule.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </NumberedSection>
  <NumberedSection
    id="tools"
    number={2}
    total={3}
    label={page.stack.label}
    locale={locale}
    headingId="tools-title"
    band
  >
    <div class="about-main">
      <Headline id="tools-title" lines={page.stack.headline} />
      <StackGrid locale={locale} />
    </div>
  </NumberedSection>
  <NumberedSection
    id="languages"
    number={3}
    total={3}
    label={page.languages.label}
    locale={locale}
  >
    <dl class="languages">
      {page.languages.items.map((language) => (
        <div class="language">
          <dt>{language.name}</dt>
          <dd class="tag">{language.level}</dd>
        </div>
      ))}
    </dl>
  </NumberedSection>
</main>
<SiteFooter locale={locale} />

<style>
  .about-main {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  .rules {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .rule {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 1.5rem 3rem;
    align-items: baseline;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .rule-number {
    color: var(--accent);
    font-weight: 500;
  }
  .rule-title {
    margin: 0;
    font-size: var(--text-medium);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
  }
  .rule-text {
    margin: 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .languages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 16rem));
    gap: 0.5rem;
    margin: 0;
  }
  .language {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
  }
  .language dt {
    font-size: var(--text-large);
    line-height: var(--text-large--line-height);
    letter-spacing: var(--text-large--letter-spacing);
  }
  .language dd {
    margin: 0;
  }
  @media (width < 62rem) {
    .rule {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
  @media (width < 30rem) {
    .languages {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
