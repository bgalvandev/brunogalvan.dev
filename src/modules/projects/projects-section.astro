---
import PageSection from '@/components/page-section.astro';
import TagList from '@/components/tag-list.astro';
import type { Locale } from '@/i18n/locales';
import { messages } from '@/i18n/messages';
import { pagePath } from '@/i18n/routes';
import { projects } from './projects';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { projects: catalog } = messages(locale);
---

<PageSection id="projects" index="02" label={catalog.heading} shade>
  <p class="section-intro">{catalog.intro}</p>
  <div class="project-list">
    {projects.map((project) => (
      <article class="project">
        <div class="project-head">
          <h3 class="project-name">{project.name}</h3>
          <p class="project-kind">{catalog.kinds[project.kind]}</p>
        </div>
        <p class="project-summary">{catalog.items[project.id].summary}</p>
        <TagList items={project.technologies} />
        <p class="project-links">
          {project.caseStudy && (
            <a
              class="inline-link"
              href={pagePath('projects', locale, project.caseStudy)}
              aria-label={`${catalog.links.caseStudy} — ${project.name}`}
            >
              {catalog.links.caseStudy}
            </a>
          )}
          {project.repository ? (
            <a
              class="inline-link"
              href={project.repository}
              aria-label={`${catalog.links.repository} — ${project.name}`}
            >
              {catalog.links.repository}
            </a>
          ) : (
            <span class="project-unavailable">{catalog.links.private}</span>
          )}
          {project.demo && (
            <a
              class="inline-link"
              href={project.demo}
              aria-label={`${catalog.links.demo} — ${project.name}`}
            >
              {catalog.links.demo}
            </a>
          )}
        </p>
      </article>
    ))}
  </div>
</PageSection>

<script>
  // The pointer carries a light across a card. Coordinates land on custom
  // properties the stylesheet already reads; with no script the card is a
  // plain bordered panel.
  function bindSpotlight() {
    for (const card of document.querySelectorAll<HTMLElement>('.project')) {
      if (card.dataset.spotlight) continue;
      card.dataset.spotlight = 'on';
      card.addEventListener('pointermove', (event) => {
        const box = card.getBoundingClientRect();
        card.style.setProperty('--px', `${event.clientX - box.left}px`);
        card.style.setProperty('--py', `${event.clientY - box.top}px`);
      });
    }
  }
  bindSpotlight();
  document.addEventListener('astro:page-load', bindSpotlight);
</script>
