---
import CodeWindow from '@/components/code-window.astro';
import Headline from '@/components/headline.astro';
import NumberedSection from '@/components/numbered-section.astro';
import PageHero from '@/components/page-hero.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import SiteFooter from '@/components/site-footer.astro';
import SiteHeader from '@/components/site-header.astro';
import { projects } from '@/data/projects';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { pagePath } from '@/i18n/routes';
import { excerpts } from './excerpts';
export type CaseStudyId = keyof typeof excerpts;
interface Props {
  locale: Locale;
  id: CaseStudyId;
}
const { locale, id } = Astro.props;
const t = messages(locale);
const copy = t.caseStudies[id];
const labels = t.caseStudy;
// Matched by a destructured id, so TypeScript keeps the type of any project
// and a later case with a demo keeps its link.
const project = projects.find(({ id: candidate }) => candidate === id)!;
const excerpt = excerpts[id];
const file = excerpt.path.split('/').at(-1) ?? excerpt.path;
const caption =
  'lines' in excerpt
    ? labels.excerpt
        .replace('{file}', file)
        .replace('{from}', String(excerpt.lines[0]))
        .replace('{to}', String(excerpt.lines[1]))
    : labels.whole.replace('{file}', file);
// The case studies in record order, so each page can lead to the next; a
// single case leads only back.
const order = Object.keys(excerpts) as CaseStudyId[];
const next = order[(order.indexOf(id) + 1) % order.length]!;
const nextName = projects.find((candidate) => candidate.id === next)!.name;
const number = (index: number) => String(index + 1).padStart(3, '0');
// An address without its scheme, in the parts between its slashes, so a
// phone can wrap it after a slash rather than inside a name.
const parts = (url: string) => url.replace('https://', '').split('/');
---

<SiteHeader locale={locale} route="caseStudy" slug={id} />
<main id="main" tabindex="-1">
  <PageHero
    label={`${labels.label} · ${t.projects.kinds[project.kind]}`}
    lines={[project.name]}
    intro={copy.summary}
    fit
  >
    <dl class="case-facts">
      <div class="case-fact">
        <dt>{labels.facts.stack}</dt>
        <dd>
          <ul class="case-tags">
            {project.technologies.map((technology) => (
              <li class="tag">{technology}</li>
            ))}
          </ul>
        </dd>
      </div>
      {[
        {
          label: labels.facts.repository,
          url: project.repository,
          none: t.projects.private,
        },
        {
          label: labels.facts.demo,
          url: project.demo,
          none: labels.facts.noDemo,
        },
      ].map((fact) => (
        <div class="case-fact">
          <dt>{fact.label}</dt>
          <dd>
            {fact.url ? (
              <a class="case-link" href={fact.url}>
                {parts(fact.url).map((part, index) => (
                  <>
                    {index > 0 && (
                      <>
                        /<wbr />
                      </>
                    )}
                    {part}
                  </>
                ))}
                <PixelIcon name="arrow-up-right" class="case-link-icon" />
              </a>
            ) : (
              <span class="case-none">{fact.none}</span>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </PageHero>
  <NumberedSection
    id="context"
    number={1}
    total={4}
    label={labels.context}
    locale={locale}
    headingId="context-title"
  >
    <div class="case-context">
      <Headline id="context-title" lines={copy.headline} />
      <p class="case-context-text">{copy.context}</p>
    </div>
  </NumberedSection>
  <NumberedSection
    id="architecture"
    number={2}
    total={4}
    label={labels.architecture}
    locale={locale}
  >
    <ol class="case-cells">
      {copy.layers.map((layer, index) => (
        <li class="case-cell">
          <span class="case-number" aria-hidden="true">
            // {number(index)}
          </span>
          <h3 class="case-cell-title">{layer.name}</h3>
          <p class="case-cell-text">{layer.text}</p>
        </li>
      ))}
    </ol>
  </NumberedSection>
  <NumberedSection
    id="decisions"
    number={3}
    total={4}
    label={labels.decisions}
    locale={locale}
  >
    <ol class="case-rows">
      {copy.decisions.map((decision, index) => (
        <li class="case-row">
          <span class="case-number" aria-hidden="true">
            // {number(index)}
          </span>
          <h3 class="case-row-title">{decision.title}</h3>
          <p class="case-row-text">{decision.text}</p>
        </li>
      ))}
    </ol>
  </NumberedSection>
  <NumberedSection
    id="in-code"
    number={4}
    total={4}
    label={labels.code}
    locale={locale}
  >
    <figure class="case-code field-dotted">
      <CodeWindow
        code={excerpt.code}
        lang={excerpt.lang}
        repository={excerpt.repository}
        commit={excerpt.commit}
        path={excerpt.path}
        {...('lines' in excerpt ? { lines: excerpt.lines } : {})}
      />
      <figcaption class="case-code-caption">{caption}</figcaption>
    </figure>
  </NumberedSection>
  <nav class="measure case-nav" aria-label={labels.label}>
    <a class="case-nav-link" href={`${pagePath('home', locale)}#projects`}>
      <PixelIcon name="arrow-right" class="case-nav-back" />
      {labels.back}
    </a>
    {next !== id && (
      <a class="case-nav-link" href={pagePath('caseStudy', locale, next)}>
        {nextName}
        <PixelIcon name="arrow-right" class="case-nav-icon" />
      </a>
    )}
  </nav>
</main>
<SiteFooter locale={locale} />

<style>
  .case-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin: 1rem 0 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .case-fact {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .case-fact dt {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
  }
  .case-fact dd {
    margin: 0;
  }
  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    overflow-wrap: break-word;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .case-link:hover {
    color: var(--accent);
  }
  .case-fact :global(.case-link-icon) {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
  }
  .case-none {
    color: var(--faint);
  }
  .case-context {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .case-context-text {
    max-width: 48rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-medium);
    line-height: var(--text-medium--line-height);
    letter-spacing: var(--text-medium--letter-spacing);
  }
  .case-cells {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .case-cell {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 14rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
  }
  .case-number {
    color: var(--accent);
    font-weight: 500;
  }
  .case-cell-title,
  .case-row-title {
    margin: 0;
    font-size: var(--text-medium);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
  }
  .case-cell-text,
  .case-row-text {
    margin: 0;
    color: var(--muted);
  }
  .case-cell-title {
    margin-top: 3rem;
  }
  .case-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .case-row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 1rem 3rem;
    align-items: baseline;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .case-row-text {
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .case-code {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 3rem;
  }
  .case-code-caption {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
  }
  .case-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 3rem 5rem;
  }
  .case-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    transition: background-color 0.25s ease;
  }
  .case-nav-link:hover {
    background: var(--line);
  }
  .case-nav :global(.case-nav-icon),
  .case-nav :global(.case-nav-back) {
    width: 0.75rem;
    height: 0.75rem;
  }
  .case-nav :global(.case-nav-back) {
    transform: scaleX(-1);
  }
  @media (width < 62rem) {
    .case-cells {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .case-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
  @media (width < 48rem) {
    .case-facts,
    .case-cells {
      grid-template-columns: minmax(0, 1fr);
    }
    .case-code {
      padding: 0.75rem;
    }
    .case-nav {
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .case-nav-link {
      transition: none;
    }
  }
</style>
