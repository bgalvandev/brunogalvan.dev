---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import SeoHead from '@/components/seo-head.astro';
import ThemeInit from '@/components/theme-init.astro';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import type { RouteKey } from '@/i18n/routes';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  route?: RouteKey;
  slug?: string;
  noindex?: boolean;
}
const { locale, ...metadata } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-jetbrains" preload />
    <SeoHead locale={locale} {...metadata} />
    <ClientRouter />
    <ThemeInit />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {messages(locale).navigation.skip}
    </a>
    <div class="frame" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="site-shell">
      <slot />
    </div>
  </body>
</html>
