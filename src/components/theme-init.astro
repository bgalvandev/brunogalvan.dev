<!-- Apply a saved preference before paint; CSS handles system theme without JavaScript. -->
<script is:inline>
  try {
    const theme = localStorage.getItem('theme');
    if (theme === 'light' || theme === 'dark') {
      document.documentElement.dataset.theme = theme;
    }
  } catch {
    // Storage can be unavailable; the system theme remains usable.
  }
</script>
