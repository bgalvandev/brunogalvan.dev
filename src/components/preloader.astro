<!-- The first view of a session opens behind a sheet of accent that clears square by square. It exists only when the pre-paint script has marked the document .preloading (JavaScript, motion allowed, first view); the motion script breaks it into squares and removes it, and a CSS failsafe hides it even if that script never runs. -->
<div class="preloader" aria-hidden="true" data-preloader></div>

<style>
  .preloader {
    display: none;
  }
  :global(html.preloading) .preloader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    align-content: start;
    background: var(--accent);
    pointer-events: none;
    animation: preloader-failsafe 0s 2.5s forwards;
  }
  .preloader :global(span) {
    aspect-ratio: 1;
    background: var(--accent);
  }
  @keyframes preloader-failsafe {
    to {
      visibility: hidden;
    }
  }
</style>
