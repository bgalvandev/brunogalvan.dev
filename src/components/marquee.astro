---
import TechLogo from './tech-logo.astro';
// An infinite band of cells. The group is rendered twice so the track can
// loop at -50%; the whole band is decoration (the same items are listed where
// they carry meaning), hidden from assistive technology. It pauses on hover,
// stops under reduced motion and when the visitor pauses motion.
// `cells` is a band of bordered cells; `logos` the same band in the master's
// logo-row cells, each a grey mark and a name, in a closed box with no fade;
// `text` is a line of accent mono words, repeated so a short list still fills
// the widest screen.
// `reverse` runs the band the other way, as the master's lower band does.
interface Props {
  items: readonly string[];
  variant?: 'cells' | 'logos' | 'text';
  reverse?: boolean;
}
const { items, variant = 'cells', reverse = false } = Astro.props;
const run = variant === 'text' ? [items, items, items, items].flat() : items;
---

<div
  class:list={['marquee', `marquee-${variant}`, { 'marquee-reverse': reverse }]}
  aria-hidden="true"
>
  <div class="marquee-track">
    {[0, 1].map(() => (
      <ul class="marquee-group">
        {run.map((item) => (
          <li
            class:list={[
              'marquee-item',
              { 'marquee-join': item === '&', 'marquee-break': item === '//' },
            ]}
          >
            {variant === 'logos' ? <TechLogo name={item} /> : item}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    mask-image: linear-gradient(
      90deg,
      transparent,
      var(--ink) 8%,
      var(--ink) 92%,
      transparent
    );
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 120s linear infinite;
  }
  .marquee:hover .marquee-track,
  :global(html[data-motion='paused']) .marquee-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
  .marquee-group {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (width < 62rem) {
    .marquee-item {
      height: 7rem;
    }
  }
  .marquee-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 12.5rem;
    height: 8.25rem;
    border-right: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* The master's logo row: a closed box with no fade at its ends, its left
     edge on the box and every cell closing its own right, each cell the
     master's 201.6px by 132px, and below the desktop breakpoint, where the
     row runs edge to edge, three tenths of it (half on a phone) by 112px.
     About 60px a second. */
  .marquee-logos {
    container-type: inline-size;
    border-left: 1px solid var(--line);
    mask-image: none;
  }
  .marquee-logos .marquee-track {
    animation-duration: 97s;
  }
  .marquee-logos .marquee-item {
    width: 12.6rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    text-transform: none;
  }
  @media (width < 62rem) {
    .marquee-logos .marquee-item {
      width: 30cqw;
    }
  }
  @media (width < 48rem) {
    .marquee-logos .marquee-item {
      width: 50cqw;
    }
  }
  .marquee-text {
    border-block: none;
    padding-block: 1.5rem;
    background: var(--paper);
  }
  /* About 100px a second, the master's pace for its words. */
  .marquee-text .marquee-track {
    animation-duration: 21s;
  }
  .marquee-reverse .marquee-track {
    animation-direction: reverse;
  }
  /* The master's rhythm: 1rem either side of an "&", 5rem before a "//"
     and 2.5rem after it. */
  .marquee-text .marquee-item {
    width: auto;
    height: auto;
    border: none;
    color: var(--accent);
    letter-spacing: -0.05rem;
  }
  .marquee-text .marquee-join {
    margin-inline: 1rem;
  }
  .marquee-text .marquee-break {
    margin-inline: 5rem 2.5rem;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
