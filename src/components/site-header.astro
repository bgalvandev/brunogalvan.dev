---
import BrandMark from '@/components/brand-mark.astro';
import LanguageSwitcher from '@/components/language-switcher.astro';
import ThemeToggle from '@/components/theme-toggle.astro';
import { site } from '@/config/site';
import type { Locale } from '@/i18n/locales';
import { pagePath, type RouteKey } from '@/i18n/routes';
interface Props {
  locale: Locale;
  route: RouteKey;
  slug?: string | undefined;
}
const { locale, route, slug } = Astro.props;
---

<header class="site-header">
  <div class="measure site-header-inner">
    <a href={pagePath('home', locale)} class="site-name">
      <BrandMark size={20} />
      {site.name}
    </a>
    <div class="header-controls">
      <LanguageSwitcher locale={locale} route={route} slug={slug} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
