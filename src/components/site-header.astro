---
import LanguageSwitcher from '@/components/language-switcher.astro';
import Logo from '@/components/logo.astro';
import MotionToggle from '@/components/motion-toggle.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import ThemeToggle from '@/components/theme-toggle.astro';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { pagePath, type RouteKey } from '@/i18n/routes';
// Fixed boxed tabs hanging from the top edge, as in the design master: pages on
// the left, language, theme and contact on the right. Below the tablet
// breakpoint the bar is the master's: the name with its chip, and a menu
// behind three lines, a native disclosure that works without JavaScript,
// holding the pages, the contact button, the language and the toggles.
interface Props {
  locale: Locale;
  route: RouteKey;
  slug?: string | undefined;
}
const { locale, route, slug } = Astro.props;
const { navigation, identity } = messages(locale);
const pages = [
  { route: 'home', label: navigation.home },
  { route: 'experience', label: navigation.experience },
  { route: 'about', label: navigation.about },
] as const;
const contactHref = `${pagePath('home', locale)}#contact`;
---

<header class="site-header">
  <div class="measure site-header-bar">
    <a class="site-brand" href={pagePath('home', locale)}>
      <Logo class="site-brand-name" />
      <span class="site-brand-tag">{identity.location}</span>
    </a>
    <nav class="tabs site-pages" aria-label={navigation.main}>
      {pages.map((page) => (
        <a
          class="tab"
          href={pagePath(page.route, locale)}
          aria-current={page.route === route ? 'page' : undefined}
          data-scramble-hover
        >
          <span data-scramble-text>{page.label}</span>
        </a>
      ))}
    </nav>
    <div class="site-tools">
      <LanguageSwitcher locale={locale} route={route} slug={slug} />
      <div class="tabs">
        <ThemeToggle locale={locale} />
        <MotionToggle locale={locale} />
      </div>
      <a class="site-contact" href={contactHref} data-scramble-hover>
        <span class="site-contact-arrow" aria-hidden="true">
          <PixelIcon name="arrow-up-right" />
          <PixelIcon name="arrow-up-right" />
        </span>
        <span data-scramble-text>{navigation.contact}</span>
      </a>
    </div>
    <details class="site-menu">
      <summary class="site-menu-button">
        <span class="sr-only">{navigation.menu}</span>
        <span class="site-menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>
      <div class="site-menu-panel">
        <nav class="site-menu-pages" aria-label={navigation.main}>
          {pages.map((page) => (
            <a
              class="site-menu-link"
              href={pagePath(page.route, locale)}
              aria-current={page.route === route ? 'page' : undefined}
            >
              {page.label}
            </a>
          ))}
        </nav>
        <a class="site-contact site-menu-contact" href={contactHref}>
          <span class="site-contact-arrow" aria-hidden="true">
            <PixelIcon name="arrow-up-right" />
            <PixelIcon name="arrow-up-right" />
          </span>
          {navigation.contact}
        </a>
        <div class="site-menu-tools">
          <LanguageSwitcher locale={locale} route={route} slug={slug} />
          <div class="tabs">
            <ThemeToggle locale={locale} />
            <MotionToggle locale={locale} />
          </div>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 900;
    view-transition-name: site-header;
    pointer-events: none;
  }
  .site-header-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .site-header-bar > * {
    pointer-events: auto;
  }
  .site-brand {
    display: none;
  }
  .site-tools {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .site-contact {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    transition: color 0.3s var(--ease-power1-out);
  }
  .site-contact:hover,
  .site-contact:focus-visible {
    color: var(--accent);
  }
  /* The arrow steps out to the top right while its twin steps in from the
     bottom left. */
  .site-contact-arrow {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    overflow: hidden;
  }
  .site-contact-arrow :global(svg) {
    position: absolute;
    inset: 0.2rem;
    transition: transform 0.3s var(--ease-power1-out);
  }
  .site-contact-arrow :global(svg:last-child) {
    transform: translate(-150%, 150%);
  }
  .site-contact:hover .site-contact-arrow :global(svg:first-child),
  .site-contact:focus-visible .site-contact-arrow :global(svg:first-child) {
    transform: translate(150%, -150%);
  }
  .site-contact:hover .site-contact-arrow :global(svg:last-child),
  .site-contact:focus-visible .site-contact-arrow :global(svg:last-child) {
    transform: none;
  }
  .site-menu {
    display: none;
  }
  .site-menu summary {
    list-style: none;
  }
  .site-menu summary::-webkit-details-marker {
    display: none;
  }
  /* The master's three lines in a 40px box, 6px apart; open, the outer two
     cross and the middle one shrinks away. */
  .site-menu-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: -0.5rem;
    color: var(--ink);
    cursor: pointer;
  }
  .site-menu-icon {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 24px;
  }
  .site-menu-icon > span {
    height: 2px;
    background: currentColor;
    transition: transform 0.4s ease;
  }
  .site-menu[open] .site-menu-icon > span:first-child {
    transform: translateY(8px) rotate(45deg);
  }
  .site-menu[open] .site-menu-icon > span:nth-child(2) {
    transform: scale(0);
  }
  .site-menu[open] .site-menu-icon > span:last-child {
    transform: translateY(-8px) rotate(-45deg);
  }
  /* The master's panel: its pages in a column, the contact button under
     them, over the page dimmed by half. Here the language and the toggles
     follow, since the bar no longer has room for them. */
  .site-menu-panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem var(--gutter);
    border-top: 1px solid var(--line);
    background: var(--paper);
  }
  .site-menu-panel::after {
    content: '';
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    height: 100vh;
    background: var(--scrim);
    pointer-events: none;
  }
  .site-menu-pages {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .site-menu-link {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }
  .site-menu-link[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
  }
  .site-menu-link[aria-current='page']::before {
    content: '<' / '';
  }
  .site-menu-link[aria-current='page']::after {
    content: '>' / '';
  }
  .site-menu-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  @media (width < 62rem) {
    .site-menu {
      display: block;
    }
    .site-header {
      background: var(--paper);
      pointer-events: auto;
    }
    .site-header-bar {
      align-items: center;
      min-height: 4.5rem;
    }
    .site-pages,
    .site-tools {
      display: none;
    }
    /* The name and its chip, where the master sets its logo and version. */
    .site-brand {
      display: flex;
      align-items: flex-end;
      gap: 0.75rem;
    }
    /* Its capitals stand as tall as the master's logo letters. */
    .site-brand :global(.site-brand-name) {
      font-size: 1.75rem;
    }
    .site-brand-tag {
      padding: 0.1em 0.25em;
      background: var(--surface);
      color: var(--faint);
      font-family: var(--font-mono);
      font-size: var(--text-small);
      line-height: 1.3rem;
      letter-spacing: var(--text-small--letter-spacing);
      text-transform: uppercase;
    }
  }
  @media (width < 22.5rem) {
    .site-brand :global(.site-brand-name) {
      font-size: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-contact,
    .site-contact-arrow :global(svg),
    .site-menu-icon > span {
      transition: none;
    }
  }
</style>
