---
import LanguageSwitcher from '@/components/language-switcher.astro';
import ThemeToggle from '@/components/theme-toggle.astro';
import { site } from '@/config/site';
import type { Locale } from '@/i18n/locales';
import { pagePath, type RouteKey } from '@/i18n/routes';
interface Props {
  locale: Locale;
  route: RouteKey;
}
const { locale, route } = Astro.props;
---

<header class="site-header">
  <a href={pagePath('home', locale)} class="site-name">
    {site.name}
  </a>
  <div class="header-controls">
    <LanguageSwitcher locale={locale} route={route} />
    <ThemeToggle locale={locale} />
  </div>
</header>
