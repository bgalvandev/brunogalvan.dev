---
import LanguageSwitcher from '@/components/language-switcher.astro';
import MotionToggle from '@/components/motion-toggle.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import ThemeToggle from '@/components/theme-toggle.astro';
import { site } from '@/config/site';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { pagePath, type RouteKey } from '@/i18n/routes';
// Fixed boxed tabs hanging from the top edge, as in the design master: pages on
// the left, language, theme and contact on the right. Below the tablet
// breakpoint the page tabs fold into a menu, a native disclosure that works
// without JavaScript, and the name links home.
interface Props {
  locale: Locale;
  route: RouteKey;
  slug?: string | undefined;
}
const { locale, route, slug } = Astro.props;
const { navigation } = messages(locale);
const pages = [
  { route: 'home', label: navigation.home },
  { route: 'experience', label: navigation.experience },
  { route: 'about', label: navigation.about },
] as const;
const contactHref = `${pagePath('home', locale)}#contact`;
---

<header class="site-header">
  <div class="measure site-header-bar">
    <a class="site-brand tab" href={pagePath('home', locale)}>
      {site.name}
    </a>
    <nav class="tabs site-pages" aria-label={navigation.main}>
      {pages.map((page) => (
        <a
          class="tab"
          href={pagePath(page.route, locale)}
          aria-current={page.route === route ? 'page' : undefined}
          data-scramble-hover
        >
          <span data-scramble-text>{page.label}</span>
        </a>
      ))}
    </nav>
    <div class="site-tools">
      <LanguageSwitcher locale={locale} route={route} slug={slug} />
      <div class="tabs">
        <ThemeToggle locale={locale} />
        <MotionToggle locale={locale} />
      </div>
      <a class="site-contact" href={contactHref} data-scramble-hover>
        <span class="site-contact-arrow" aria-hidden="true">
          <PixelIcon name="arrow-up-right" />
          <PixelIcon name="arrow-up-right" />
        </span>
        <span class="site-contact-label" data-scramble-text>
          {navigation.contact}
        </span>
      </a>
      <details class="site-menu">
        <summary class="tab">{navigation.menu}</summary>
        <nav class="site-menu-panel" aria-label={navigation.main}>
          {pages.map((page) => (
            <a
              class="site-menu-link"
              href={pagePath(page.route, locale)}
              aria-current={page.route === route ? 'page' : undefined}
            >
              {page.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 900;
    pointer-events: none;
  }
  .site-header-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .site-header-bar > * {
    pointer-events: auto;
  }
  .site-brand {
    display: none;
  }
  .site-tools {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .site-contact {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
  }
  /* The arrow steps out to the top right while its twin steps in from the
     bottom left. */
  .site-contact-arrow {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    overflow: hidden;
  }
  .site-contact-arrow :global(svg) {
    position: absolute;
    inset: 0.2rem;
    transition: transform 0.2s ease;
  }
  .site-contact-arrow :global(svg:last-child) {
    transform: translate(-150%, 150%);
  }
  .site-contact:hover .site-contact-arrow :global(svg:first-child),
  .site-contact:focus-visible .site-contact-arrow :global(svg:first-child) {
    transform: translate(150%, -150%);
  }
  .site-contact:hover .site-contact-arrow :global(svg:last-child),
  .site-contact:focus-visible .site-contact-arrow :global(svg:last-child) {
    transform: none;
  }
  .site-menu {
    display: none;
  }
  .site-menu summary {
    list-style: none;
  }
  .site-menu summary::-webkit-details-marker {
    display: none;
  }
  .site-menu[open] summary {
    background: var(--ink);
    color: var(--paper);
  }
  .site-menu-panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    padding: 1rem 5%;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .site-menu-link {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
  }
  .site-menu-link[aria-current='page'] {
    color: var(--accent);
  }
  .site-menu-link[aria-current='page']::before {
    content: '<' / '';
  }
  .site-menu-link[aria-current='page']::after {
    content: '>' / '';
  }
  @media (width < 62rem) {
    .site-menu {
      display: block;
    }
    .site-header {
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      pointer-events: auto;
    }
    .site-header-bar {
      align-items: center;
      min-height: 3.5rem;
    }
    .site-pages {
      display: none;
    }
    .site-brand {
      display: flex;
      padding-inline: 0;
      border: none;
      background: none;
      font-weight: 600;
    }
    .site-contact {
      min-height: 1.75rem;
      padding: 0.25rem 0.5rem;
      font-size: var(--text-label);
    }
  }
  @media (width < 48rem) {
    .site-contact-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .site-contact {
      padding-inline: 0.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-contact-arrow :global(svg) {
      transition: none;
    }
  }
</style>
