---
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
interface Props {
  locale: Locale;
}
const { theme } = messages(Astro.props.locale);
---

<!-- A toggle button: the label names the option and aria-pressed says whether it is on, so the visible text never contradicts the state. Shown by CSS only once the pre-paint script has marked JavaScript as available. -->
<button type="button" class="control" data-theme-toggle aria-pressed="false">
  {theme.darkMode}
</button>
<script>
  const preference = window.matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;

  function isDark() {
    return root.dataset.theme
      ? root.dataset.theme === 'dark'
      : preference.matches;
  }
  function button() {
    return document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  }
  function update() {
    button()?.setAttribute('aria-pressed', String(isDark()));
  }
  // A client-side navigation swaps in a new button, so the handler is bound per
  // page rather than once per session.
  function bind() {
    const current = button();
    if (!current || current.dataset.bound) return;
    current.dataset.bound = 'true';
    current.addEventListener('click', () => {
      const theme = isDark() ? 'light' : 'dark';
      root.dataset.theme = theme;
      try {
        localStorage.setItem('theme', theme);
      } catch {
        /* Keep the current page usable. */
      }
      update();
    });
    update();
  }

  bind();
  document.addEventListener('astro:page-load', bind);
  preference.addEventListener('change', update);
</script>
