---
// A toggle button: the label names the option and aria-pressed says whether it
// is on, so the visible text never contradicts the state. Shown by CSS only
// once the pre-paint script has marked JavaScript as available.
import PixelIcon from '@/components/pixel-icon.astro';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
interface Props {
  locale: Locale;
}
const { theme } = messages(Astro.props.locale);
---

<button
  type="button"
  class="tab theme-toggle"
  data-theme-toggle
  aria-pressed="false"
>
  <PixelIcon name="contrast" class="theme-toggle-icon" />
  <span class="theme-toggle-label">{theme.darkMode}</span>
</button>
<script>
  const preference = window.matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(
    '[data-theme-toggle]',
  );
  function isDark() {
    return root.dataset.theme
      ? root.dataset.theme === 'dark'
      : preference.matches;
  }
  function update() {
    button?.setAttribute('aria-pressed', String(isDark()));
  }
  button?.addEventListener('click', () => {
    const theme = isDark() ? 'light' : 'dark';
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* Keep the current page usable. */
    }
    update();
  });
  preference.addEventListener('change', update);
  update();
</script>

<style>
  .theme-toggle :global(.theme-toggle-icon) {
    width: 0.75rem;
    height: 0.75rem;
    margin-right: 0.375rem;
  }
  @media (width < 48rem) {
    .theme-toggle :global(.theme-toggle-icon) {
      margin-right: 0;
    }
    .theme-toggle-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
