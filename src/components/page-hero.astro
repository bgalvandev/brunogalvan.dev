---
import Headline from '@/components/headline.astro';
import PixelField from '@/components/pixel-field.astro';
// The opening room of an extension page: the dark gridded band, a tag, the
// page's statement as its h1, and room for an intro or facts below. `fit`
// sets a one-word statement (a project's name) small enough on a phone that
// the word never runs past the room.
interface Props {
  label: string;
  lines: readonly string[];
  intro?: string;
  fit?: boolean;
}
const { label, lines, intro, fit = false } = Astro.props;
---

<section
  class:list={['section band page-hero', { 'page-hero-fit': fit }]}
  aria-labelledby="page-title"
>
  <PixelField rows={14} />
  <div class="measure page-hero-body">
    <p class="tag">{label}</p>
    <Headline id="page-title" level="h1" size="display" lines={lines} />
    {intro && <p class="page-hero-intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    container-type: inline-size;
    overflow: hidden;
    background: var(--paper);
  }
  .page-hero-fit :global(.headline) {
    font-size: min(var(--text-display), 11cqw);
  }
  .page-hero-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    padding-block: 9rem 5rem;
    pointer-events: none;
  }
  .page-hero-body > :global(*) {
    pointer-events: auto;
  }
  .page-hero-body .tag {
    margin: 0;
  }
  .page-hero-intro {
    max-width: 40rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-medium);
    line-height: var(--text-medium--line-height);
    letter-spacing: var(--text-medium--letter-spacing);
  }
  @media (width < 62rem) {
    .page-hero-body {
      padding-top: 7rem;
    }
  }
</style>
