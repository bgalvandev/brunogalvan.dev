---
import { alternatePages, type RouteKey } from '@/i18n/routes';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
interface Props {
  locale: Locale;
  route: RouteKey;
}
const { locale, route } = Astro.props;
---

<nav aria-label={messages(locale).navigation.language} class="flex gap-1">
  {alternatePages(route).map((alternative) => (
    <a
      class="control"
      href={alternative.path}
      lang={alternative.locale}
      hreflang={alternative.locale}
      aria-current={locale === alternative.locale ? 'page' : undefined}
      aria-label={alternative.locale === 'es' ? 'Español' : 'English'}
    >
      {alternative.locale.toUpperCase()}
    </a>
  ))}
</nav>
