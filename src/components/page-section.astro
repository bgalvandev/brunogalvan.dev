---
// A section header in the manner of a specification sheet: the number, a rule,
// the name, and a rule that runs to the edge. The content below it takes the
// full measure rather than a column beside the label.
interface Props {
  id: string;
  index: string;
  total?: string;
  label: string;
  shade?: boolean;
}
const { id, index, total = '06', label, shade = false } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  class:list={['section', shade && 'band-shade']}
  id={id}
  aria-labelledby={headingId}
>
  <div class="measure">
    <h2 class="section-head" id={headingId}>
      <span class="section-tag" aria-hidden="true">
        [N.{index}/{total}]
      </span>
      <span class="section-rule" aria-hidden="true"></span>
      <span class="section-name">
        <span aria-hidden="true">&gt;</span>
        {label}
      </span>
      <span class="section-rule section-rule-run" aria-hidden="true"></span>
    </h2>
    <div class="section-body reveal">
      <slot />
    </div>
  </div>
</section>
