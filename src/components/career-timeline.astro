---
import PixelIcon from '@/components/pixel-icon.astro';
import { roles, type Month } from '@/data/experience';
import { roleMonths } from '@/data/figures';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
// The career as a timeline: a centre line, each period sitting on it, a
// dashed leader past a marker to the entry. `detail` adds each role's
// length, what was built in it where the record says, and, where the record
// names them, its clients.
interface Props {
  locale: Locale;
  detail?: boolean;
}
const { locale, detail = false } = Astro.props;
const { experience, experiencePage } = messages(locale);
const monthFormat = new Intl.DateTimeFormat(locale, {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const format = (month: Month) => {
  const [year, index] = month.split('-').map(Number);
  return monthFormat.format(new Date(Date.UTC(year ?? 0, (index ?? 1) - 1)));
};
const { duration } = experiencePage;
const length = (months: number) => {
  const years = Math.floor(months / 12);
  const rest = months % 12;
  return [
    years && `${years} ${years === 1 ? duration.year : duration.years}`,
    rest && `${rest} ${rest === 1 ? duration.month : duration.months}`,
  ]
    .filter(Boolean)
    .join(' ');
};
const today = new Date();
const items = roles.map((role) => {
  const copy = experience.roles[role.id];
  return {
    ...role,
    ...copy,
    from: format(role.start),
    to: role.end ? format(role.end) : experience.present,
    length: length(roleMonths(role, today)),
    clients: 'clients' in role ? role.clients : [],
    highlights: 'highlights' in copy ? copy.highlights : [],
  };
});
// Each entry frames an icon. The current role shows code in progress and
// each past one a double check, in the same neutral ink: an accent beside the
// current one would read as an availability signal.
const icons = {
  current: ['..#...#..', '.#.....#.', '#.......#', '.#.....#.', '..#...#..'],
  past: [
    '......#...#',
    '.....#...#.',
    '#...#.#.#..',
    '.#.#...#...',
    '..#........',
  ],
};
---

<ol
  class:list={['experience-timeline', { 'experience-timeline-detail': detail }]}
>
  {items.map((item) => {
    const period = (
      <>
        <time datetime={item.start}>{item.from}</time> —{' '}
        {item.end ? <time datetime={item.end}>{item.to}</time> : item.to}
      </>
    );
    return (
      <li class="experience-item">
        <div class="experience-row">
          <div class="experience-content experience-top">
            <p class="experience-date experience-date-inline">{period}</p>
            <h3 class="experience-company">{item.company}</h3>
          </div>
        </div>
        <div class="experience-row experience-mark">
          <p class="experience-date experience-date-line">{period}</p>
          <span class="experience-marker" aria-hidden="true">
            <PixelIcon rows={item.end ? icons.past : icons.current} />
          </span>
          <span class="experience-dash" aria-hidden="true" />
        </div>
        <div class="experience-row">
          <div class="experience-content">
            <p class="experience-role">{item.role}</p>
            <p class="experience-line">{item.line}</p>
            {detail && item.highlights.length > 0 && (
              <div class="experience-highlights">
                <p class="experience-highlights-label">
                  {experiencePage.highlights}
                </p>
                <ul class="experience-highlights-list">
                  {item.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </div>
            )}
            {detail && (
              <dl class="experience-facts">
                <div>
                  <dt class="sr-only">{experiencePage.durationLabel}</dt>
                  <dd class="tag">{item.length}</dd>
                </div>
                {item.clients.length > 0 && (
                  <div>
                    <dt>{experiencePage.clients}</dt>
                    <dd>{item.clients.join(' · ')}</dd>
                  </div>
                )}
              </dl>
            )}
          </div>
        </div>
      </li>
    );
  })}
</ol>

<style>
  /* The timeline spans a 7rem centre strip and the column after it (see
     .changelog in global.css). Its centre line runs down the strip's middle,
     from above the room's first entry to the rule under the room. Each entry
     is three rows: its name, a 1rem row where its period sits on the line and
     a dashed leader runs past a marker, and its role and line. The text keeps
     to the last 60% of the width, 20rem at most. */
  .experience-timeline {
    --center: 7rem;
    --content: 60%;
    --marker: 3.5rem;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin: 0;
    padding: 0.75rem 0 0;
    list-style: none;
  }
  .experience-timeline::before {
    content: '';
    position: absolute;
    top: -2.125rem;
    bottom: -2.5rem;
    left: calc(var(--center) / 2);
    z-index: -1;
    width: 1px;
    background: var(--line);
  }
  .experience-item {
    display: flex;
    flex-direction: column;
  }
  .experience-row {
    position: relative;
    display: grid;
    grid-template-columns: var(--center) minmax(0, 1fr) var(--content);
  }
  .experience-content {
    grid-column: 3;
    display: flex;
    flex-direction: column;
    max-width: 20rem;
  }
  /* With the full record, the text takes the whole of its column. */
  .experience-timeline-detail .experience-content {
    max-width: none;
  }
  .experience-mark {
    height: 1rem;
  }
  .experience-date {
    margin: 0;
    padding: 0.2em 0;
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .experience-date-inline {
    display: none;
  }
  .experience-date-line {
    position: absolute;
    top: 50%;
    left: calc(var(--center) / 2);
    z-index: 2;
    transform: translate(-50%, -50%);
  }
  .experience-dash {
    position: absolute;
    top: 50%;
    right: 0;
    left: calc(var(--center) / 2);
    z-index: -1;
    border-top: 1px dashed var(--line);
  }
  .experience-marker {
    position: absolute;
    top: 50%;
    left: calc(100% - var(--content) - var(--marker));
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--muted);
    transform: translateY(-50%);
  }
  .experience-marker :global(svg) {
    width: 1rem;
  }
  .experience-company {
    margin: 0;
    font-size: var(--text-medium);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: var(--text-medium--letter-spacing);
  }
  .experience-role {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }
  .experience-line {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-label);
  }
  .experience-facts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    font-size: var(--text-label);
  }
  .experience-facts div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .experience-facts dt {
    color: var(--faint);
  }
  .experience-facts dd {
    margin: 0;
    color: var(--muted);
  }
  .experience-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .experience-highlights-label {
    margin: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-transform: uppercase;
  }
  .experience-highlights-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Each item hangs from a small square, the site's bullet. */
  .experience-highlights-list li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--muted);
    font-size: var(--text-label);
  }
  .experience-highlights-list li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.375rem;
    height: 0.375rem;
    background: var(--faint);
  }
  @media (width < 62rem) {
    .experience-company {
      font-size: 1.25rem;
    }
  }
  @media (width < 48rem) {
    .experience-timeline::before {
      top: 0;
    }
  }
  /* On a narrow phone the strip narrows to 2rem, the text takes the rest
     of the row and the period moves above the name. */
  @media (width < 30rem) {
    .experience-timeline {
      --center: 2rem;
      --content: calc(100% - 3rem);
      --marker: 3rem;
      gap: 3rem;
    }
    .experience-row {
      column-gap: 1rem;
      grid-template-columns: var(--center) minmax(0, 1fr);
    }
    .experience-content {
      grid-column: 2;
      max-width: none;
    }
    .experience-top {
      align-items: flex-start;
      gap: 0.5rem;
    }
    .experience-mark {
      height: 0.5rem;
    }
    .experience-date-inline {
      display: block;
    }
    .experience-date-line {
      display: none;
    }
    .experience-company {
      font-size: 1.125rem;
    }
  }
</style>
