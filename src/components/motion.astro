<!-- The site's motion, all of it gated on prefers-reduced-motion: with reduce, nothing is split, scrambled or typed and the page is its static HTML. gsap.matchMedia reverts every split and tween if the preference changes mid-visit. -->
<script>
  import { gsap } from 'gsap';
  import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText, ScrambleTextPlugin);

  // The design master's own values: characters open 0.04s apart, each one
  // widens over a quarter of its duration while it scrambles for the whole of
  // it, settling on the real glyph.
  const SCRAMBLE = '!<>-_\\/[]{}—=+*^?#______';
  const STAGGER = 0.04;
  const DURATION = 0.4;

  // Headings keep their name on the element (aria-label) and hide the visual
  // copy, so splitting it into characters never reaches assistive technology.
  // When the reveal ends the split is reverted, restoring kerning, and any
  // fragment inside is typed.
  function reveal(element: HTMLElement): SplitText {
    const duration = Number(element.dataset.revealDuration ?? DURATION);
    // Closed characters have no width, so the heading would lose its lines;
    // holding its height keeps everything below it still.
    const box = element.closest<HTMLElement>('h1, h2, h3') ?? element;
    box.style.minHeight = `${box.getBoundingClientRect().height}px`;
    const split = SplitText.create(element, {
      type: 'words,chars',
      tag: 'span',
      wordsClass: 'reveal-word',
      charsClass: 'reveal-char',
      aria: 'none',
      ignore: '[data-reveal-skip]',
    });
    const timeline = gsap.timeline({
      paused: true,
      onComplete: () => {
        box.style.minHeight = '';
        split.revert();
        element
          .querySelectorAll<HTMLElement>('[data-typewriter]')
          .forEach((fragment) => type(fragment));
      },
    });
    split.chars.forEach((char, index) => {
      const at = index * STAGGER;
      timeline.from(
        char,
        {
          width: 0,
          opacity: 0,
          duration: duration * 0.25,
          ease: 'power2.out',
          clearProps: 'width,opacity',
        },
        at,
      );
      const glyph = char.textContent ?? '';
      if (glyph.trim()) {
        timeline.to(
          char,
          {
            duration,
            scrambleText: { text: glyph, chars: SCRAMBLE, speed: 0.5 },
          },
          at,
        );
      }
    });
    ScrollTrigger.create({
      trigger: box,
      start: 'top 80%',
      once: true,
      onEnter: () => timeline.play(),
    });
    // A heading already scrolled past (a reload mid-page) is shown at once.
    if (box.getBoundingClientRect().bottom < 0) timeline.progress(1);
    return split;
  }

  // Types a fragment's text, which waits in data-typewriter-text; the cursor
  // is CSS. A fragment outside any reveal starts on its own.
  function type(element: HTMLElement) {
    const text = element.dataset.typewriterText ?? '';
    const state = { length: 0 };
    gsap.to(state, {
      length: text.length,
      duration: text.length * 0.05,
      ease: `steps(${text.length})`,
      onUpdate: () => {
        element.textContent = text.slice(0, Math.round(state.length));
      },
    });
  }
  function holdForTyping(element: HTMLElement) {
    element.dataset.typewriterText = element.textContent ?? '';
    element.textContent = '';
    if (!element.closest('[data-reveal]')) type(element);
  }

  // Links and buttons cycle through noise on pointer hover and settle back.
  // The name is pinned first, so it never reads as noise.
  function scrambleOnHover(link: HTMLElement) {
    const target =
      link.querySelector<HTMLElement>('[data-scramble-text]') ?? link;
    const label = (target.textContent ?? '').trim();
    const pinned = !link.hasAttribute('aria-label');
    if (pinned) link.setAttribute('aria-label', label);
    target.setAttribute('aria-hidden', 'true');
    const tween = gsap.to(target, {
      duration: 0.8,
      paused: true,
      scrambleText: {
        text: '{original}',
        chars: SCRAMBLE.slice(0, 18),
        speed: 0.5,
      },
    });
    const play = () => tween.play(0);
    link.addEventListener('pointerenter', play);
    return () => {
      link.removeEventListener('pointerenter', play);
      if (pinned) link.removeAttribute('aria-label');
      target.removeAttribute('aria-hidden');
    };
  }

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    document
      .querySelectorAll<HTMLElement>('[data-typewriter]')
      .forEach(holdForTyping);
    const unhovers = [
      ...document.querySelectorAll<HTMLElement>('[data-scramble-hover]'),
    ].map(scrambleOnHover);
    const splits = [
      ...document.querySelectorAll<HTMLElement>('[data-reveal]'),
    ].map(reveal);
    // Motion switched off mid-visit: put every piece of text back. Splits go
    // first, since a split restores the markup it found.
    return () => {
      splits.forEach((split) => split.revert());
      document
        .querySelectorAll<HTMLElement>('[data-typewriter-text]')
        .forEach((element) => {
          element.textContent = element.dataset.typewriterText ?? '';
          delete element.dataset.typewriterText;
        });
      unhovers.forEach((unhover) => unhover());
    };
  });
</script>
