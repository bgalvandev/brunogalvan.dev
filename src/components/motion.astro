---
// The site's motion. It runs only while motion is allowed: no reduced-motion
// preference and not paused from the header. Everything is created in one
// gsap.context, so turning motion off reverts every split, tween and trigger
// and restores the static HTML.
---

<script>
  import { gsap } from 'gsap';
  import Lenis from 'lenis';
  import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText, ScrambleTextPlugin);

  // Characters open 0.04s apart, each one widens over a quarter of its
  // duration while it scrambles for the whole of it, settling on the real
  // glyph.
  const SCRAMBLE = '!<>-_\\/[]{}—=+*^?#______';
  const STAGGER = 0.04;
  const DURATION = 0.4;

  // Headings keep their name on the element (aria-label) and hide the visual
  // copy, so splitting it into characters never reaches assistive technology.
  // When the reveal ends the split is reverted, which moves nothing since
  // revealed text sets no kerning, and any fragment inside is typed.
  function reveal(element: HTMLElement) {
    const duration = Number(element.dataset.revealDuration ?? DURATION);
    // Closed characters have no width, so the block would lose its lines;
    // holding its height keeps everything below it still.
    const box = element.closest<HTMLElement>('h1, h2, h3, p') ?? element;
    box.style.minHeight = `${box.getBoundingClientRect().height}px`;
    const split = SplitText.create(element, {
      type: 'words,chars',
      tag: 'span',
      wordsClass: 'reveal-word',
      charsClass: 'reveal-char',
      aria: 'none',
      ignore: '[data-reveal-skip]',
    });
    const timeline = gsap.timeline({
      paused: true,
      onComplete: () => {
        box.style.minHeight = '';
        split.revert();
        element
          .querySelectorAll<HTMLElement>(
            '[data-typewriter]:not([data-typewriter-words])',
          )
          .forEach((fragment) => type(fragment));
      },
    });
    split.chars.forEach((char, index) => {
      const at = index * STAGGER;
      timeline.from(
        char,
        {
          width: 0,
          opacity: 0,
          duration: duration * 0.25,
          ease: 'power2.out',
          clearProps: 'width,opacity',
        },
        at,
      );
      const glyph = char.textContent ?? '';
      if (glyph.trim()) {
        timeline.to(
          char,
          {
            duration,
            scrambleText: { text: glyph, chars: SCRAMBLE, speed: 0.5 },
          },
          at,
        );
      }
    });
    ScrollTrigger.create({
      trigger: box,
      start: 'top 80%',
      once: true,
      onEnter: () => timeline.play(),
    });
    // A heading already scrolled past (a reload mid-page) is shown at once.
    if (box.getBoundingClientRect().bottom < 0) timeline.progress(1);
  }

  // Types a fragment's text, which waits in data-typewriter-text; the cursor
  // is CSS. A fragment with a list of words cycles through them: each word
  // types at 50ms a letter under a cursor that covers the newest one, holds
  // 0.8s, the cursor blinks off and on twice, the word clears at once and the
  // next one follows 0.2s later, round and round. The pause control stops
  // it; without motion the first word stands. A fragment outside any reveal
  // starts on its own.
  const TYPE = 0.05;
  const HOLD = 0.8;
  const BLINK = 0.4;
  const GAP = 0.2;
  function type(fragment: HTMLElement) {
    const words = fragment.dataset.typewriterWords?.split('|') ?? [
      fragment.dataset.typewriterText ?? '',
    ];
    // A heading that finishes opening restores its markup, which replaces
    // the fragment's node; the cycle follows it to the node on the page.
    let element = fragment;
    const live = () => {
      if (!element.isConnected) {
        element =
          document.querySelector<HTMLElement>(
            `[data-typewriter-key="${fragment.dataset.typewriterKey}"]`,
          ) ?? element;
      }
      return element;
    };
    const cycling = words.length > 1;
    const timeline = gsap.timeline({
      repeat: cycling ? -1 : 0,
      delay: Number(fragment.dataset.typewriterDelay ?? 0),
    });
    const cursor = (state: string) => () => {
      live().dataset.cursor = state;
    };
    // A line that holds its words unseen shows the one about to be typed,
    // so it takes that word's height before the first letter.
    const begin = (index: number) => () => {
      cursor('typing')();
      live()
        .closest('[data-typewriter-line]')
        ?.querySelectorAll<HTMLElement>('[data-typewriter-ghost]')
        .forEach((ghost, at) => (ghost.hidden = at !== index));
    };
    for (const [index, word] of words.entries()) {
      const state = { length: 0 };
      timeline.call(begin(index)).to(state, {
        length: word.length,
        duration: word.length * TYPE,
        ease: `steps(${word.length})`,
        onUpdate: () => {
          live().textContent = word.slice(0, Math.round(state.length));
        },
      });
      timeline.call(cursor('on'));
      if (!cycling) continue;
      timeline
        .call(cursor('off'), [], `+=${HOLD}`)
        .call(cursor('on'), [], `+=${BLINK}`)
        .call(cursor('off'), [], `+=${BLINK}`)
        .call(cursor('on'), [], `+=${BLINK}`)
        .call(
          () => {
            live().textContent = '';
          },
          [],
          `+=${BLINK}`,
        )
        .to({}, { duration: GAP });
    }
  }
  // A cycling fragment starts with the page, after its own delay, so it is
  // already moving when the visitor scrolls to it; a fragment typed once waits
  // for its heading to open.
  function holdForTyping(element: HTMLElement, index: number) {
    element.dataset.typewriterKey = String(index);
    element.dataset.typewriterText = element.textContent ?? '';
    element.textContent = '';
    if (element.dataset.typewriterWords || !element.closest('[data-reveal]')) {
      type(element);
    }
  }

  // Links and buttons cycle through noise on pointer hover and settle back.
  // The name is pinned first, so it never reads as noise.
  function scrambleOnHover(link: HTMLElement) {
    const target =
      link.querySelector<HTMLElement>('[data-scramble-text]') ?? link;
    const label = (target.textContent ?? '').trim();
    const pinned = !link.hasAttribute('aria-label');
    if (pinned) link.setAttribute('aria-label', label);
    target.setAttribute('aria-hidden', 'true');
    const tween = gsap.to(target, {
      duration: 0.8,
      paused: true,
      scrambleText: {
        text: '{original}',
        chars: SCRAMBLE.slice(0, 18),
        speed: 0.5,
      },
    });
    const play = () => tween.play(0);
    link.addEventListener('pointerenter', play);
    return () => {
      link.removeEventListener('pointerenter', play);
      if (pinned) link.removeAttribute('aria-label');
      target.removeAttribute('aria-hidden');
    };
  }

  // The pixel field lights the cells the pointer crosses, in the accent: a
  // cell rises over a fifth of a second, stays lit half a second after the
  // pointer leaves it, then fades over a fifth; the cell under a resting
  // pointer stays lit. Below the desktop breakpoint the field also flickers on
  // its own: each cell rises to a fifth of the accent over a second and goes
  // dark at once, the cells starting in a random order spread over three
  // seconds and the whole field starting again every four, so about a third
  // of it glows at any moment and never all of it. One canvas under the grid
  // lines, so a lit cell keeps its edges, drawn only while a cell glows or the
  // flickering field is on screen.
  function pixelField(field: HTMLElement) {
    const lines = field.querySelector<HTMLElement>('.pixel-field-lines');
    const host = field.parentElement;
    const canvas = document.createElement('canvas');
    const context = canvas.getContext('2d');
    if (!lines || !host || !context) return () => {};
    lines.before(canvas);
    const RISE = 200;
    const HOLD = 500;
    const FADE = 200;
    const CYCLE = 4000;
    const SPREAD = 3000;
    const SWELL = 1000;
    const AMBIENT = 0.2;
    const ambient = window.matchMedia('(width < 62rem)');
    // A cell's width and a row's height (a line taller), and where the first
    // cell starts, left of or at the field's edge, as the grid lines lie.
    let cell = 1;
    let pitch = 2;
    let left = 0;
    let top = 0;
    let columns = 0;
    // When each cell lit and when it was last under the pointer, in ms, and
    // when it starts to swell in the flickering field.
    let lit = new Float64Array(0);
    let touched = new Float64Array(0);
    let delays = new Float64Array(0);
    let current = -1;
    let last: { x: number; y: number } | undefined;
    let frame = 0;
    let visible = false;
    let started = performance.now();
    const flickering = () => visible && ambient.matches;
    function measure() {
      const ratio = window.devicePixelRatio || 1;
      const style = getComputedStyle(lines!);
      const width = field.clientWidth;
      const height = field.clientHeight;
      cell = parseFloat(style.getPropertyValue('--cell'));
      pitch = cell + 1;
      const shift = parseFloat(style.getPropertyValue('--row-shift')) || 0;
      const edge = (start: number, size: number) =>
        (((start % size) + size) % size) - size;
      left = edge(width / 2 - 15 * cell, cell);
      top = edge(height / 2 - shift * pitch, pitch);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context!.setTransform(ratio, 0, 0, ratio, 0, 0);
      columns = Math.ceil((width - left) / cell);
      touched = new Float64Array(
        columns * Math.ceil((height - top) / pitch),
      ).fill(-Infinity);
      lit = new Float64Array(touched.length);
      if (delays.length !== touched.length) {
        delays = Float64Array.from(touched, () => Math.random() * SPREAD);
      }
      wake();
    }
    function draw(now: number) {
      context!.clearRect(0, 0, field.clientWidth, field.clientHeight);
      context!.fillStyle = getComputedStyle(field).color;
      if (current >= 0) touched[current] = now;
      // A frame's time can precede the moment the field came into view.
      const cycle = flickering() ? Math.max(0, now - started) % CYCLE : -1;
      let glowing = cycle >= 0;
      touched.forEach((at, index) => {
        const since = now - at;
        let alpha = 0;
        if (since < HOLD + FADE) {
          const rise = Math.min(1, (now - lit[index]!) / RISE);
          const fall =
            since <= HOLD ? 1 : Math.max(0, 1 - (since - HOLD) / FADE);
          alpha = Math.min(rise, fall);
          glowing = true;
        }
        // A cell that has swelled for its second goes dark at once rather
        // than fading.
        const swell = (cycle - delays[index]!) / SWELL;
        if (cycle >= 0 && swell >= 0 && swell < 1) {
          alpha = Math.max(alpha, AMBIENT * swell);
        }
        if (alpha <= 0) return;
        context!.globalAlpha = alpha;
        context!.fillRect(
          left + (index % columns) * cell,
          top + Math.floor(index / columns) * pitch,
          cell,
          pitch,
        );
      });
      frame = glowing ? requestAnimationFrame(draw) : 0;
    }
    function wake() {
      if (!frame) frame = requestAnimationFrame(draw);
    }
    // The flickering starts dark each time the field comes into view.
    const seen = new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
      started = performance.now();
      wake();
    });
    seen.observe(field);
    ambient.addEventListener('change', wake);
    // A cell that had gone dark lights afresh, rising over a fifth of a
    // second; one still glowing just stays lit.
    function touch(index: number, now: number) {
      if (now - touched[index]! >= HOLD + FADE) lit[index] = now;
      touched[index] = now;
    }
    function indexAt(x: number, y: number) {
      const column = Math.floor((x - left) / cell);
      const index = Math.floor((y - top) / pitch) * columns + column;
      return column >= 0 &&
        column < columns &&
        index >= 0 &&
        index < touched.length
        ? index
        : -1;
    }
    function move(event: PointerEvent) {
      const bounds = field.getBoundingClientRect();
      const point = {
        x: event.clientX - bounds.left,
        y: event.clientY - bounds.top,
      };
      // Step between samples so a fast pointer leaves an unbroken trail.
      const from = last ?? point;
      const steps = Math.max(
        1,
        Math.ceil(Math.hypot(point.x - from.x, point.y - from.y) / (cell / 2)),
      );
      const now = performance.now();
      for (let step = 1; step <= steps; step += 1) {
        const index = indexAt(
          from.x + ((point.x - from.x) * step) / steps,
          from.y + ((point.y - from.y) * step) / steps,
        );
        if (index >= 0) touch(index, now);
      }
      current = indexAt(point.x, point.y);
      last = point;
      wake();
    }
    const leave = () => {
      last = undefined;
      current = -1;
    };
    const resize = new ResizeObserver(measure);
    resize.observe(field);
    measure();
    host.addEventListener('pointermove', move);
    host.addEventListener('pointerleave', leave);
    return () => {
      resize.disconnect();
      seen.disconnect();
      ambient.removeEventListener('change', wake);
      host.removeEventListener('pointermove', move);
      host.removeEventListener('pointerleave', leave);
      cancelAnimationFrame(frame);
      canvas.remove();
    };
  }

  // The first view of a session: the accent sheet breaks into squares, one
  // tenth of the width each, that clear in random order.
  function clearPreloader() {
    const sheet = document.querySelector<HTMLElement>('[data-preloader]');
    if (!sheet || !root.classList.contains('preloading')) return;
    sheet.style.animation = 'none';
    const size = window.innerWidth / 10;
    const squares = Array.from(
      { length: 10 * Math.ceil(window.innerHeight / size) },
      () => document.createElement('span'),
    );
    sheet.append(...squares);
    sheet.style.background = 'transparent';
    // Each square holds almost to the end of its 0.3s, then snaps off
    // (expo.in), one every hundredth of a second in random order.
    gsap.to(squares, {
      opacity: 0,
      duration: 0.3,
      ease: 'expo.in',
      stagger: { each: 0.01, from: 'random' },
      onComplete: () => root.classList.remove('preloading'),
    });
  }

  // A numbered process driven by the scroll: the room grows tall, its
  // content sticks, and each step's line is drawn in turn while the steps
  // reached so far are marked active. Only where the steps sit in one row;
  // stacked steps would not fit a sticky frame.
  function steps(section: HTMLElement) {
    const cards = [...section.querySelectorAll<HTMLElement>('[data-step]')];
    const lines = cards.flatMap(
      (card) => card.querySelector<HTMLElement>('[data-step-line]') ?? [],
    );
    gsap.matchMedia().add('(min-width: 62rem)', () => {
      section.dataset.scrubbing = '';
      const mark = (progress: number) =>
        cards.forEach((card, index) =>
          card.classList.toggle(
            'is-active',
            index === 0 || progress * cards.length > index,
          ),
        );
      mark(0);
      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.8,
          onUpdate: (trigger) => mark(trigger.progress),
        },
      });
      lines.forEach((line) =>
        timeline.fromTo(line, { width: '0%' }, { width: '100%', ease: 'none' }),
      );
      return () => {
        delete section.dataset.scrubbing;
        cards.forEach((card) => card.classList.remove('is-active'));
      };
    });
  }

  // The phone slider for the value cards: one card at a time, the next every
  // three and a half seconds (half a second of it to cross), and a swipe or a
  // dash choosing one, which restarts the wait.
  function slider(root: HTMLElement) {
    const cards = [...root.querySelectorAll<HTMLElement>('.value-card')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-slide]')];
    const nav = root.querySelector<HTMLElement>('.value-slider-nav');
    if (!nav || cards.length < 2) return;
    gsap.matchMedia().add('(width < 48rem)', () => {
      let current = 0;
      const show = (index: number) => {
        current = (index + cards.length) % cards.length;
        cards.forEach((card, at) =>
          card.classList.toggle('is-current', at === current),
        );
        dots.forEach((dot, at) =>
          dot.setAttribute('aria-current', String(at === current)),
        );
      };
      const timer = gsap.to(
        {},
        { duration: 3.5, repeat: -1, onRepeat: () => show(current + 1) },
      );
      const choose = (index: number) => {
        show(index);
        timer.restart();
      };
      let start: number | undefined;
      const down = (event: PointerEvent) => {
        start = event.clientX;
      };
      const up = (event: PointerEvent) => {
        const distance = event.clientX - (start ?? event.clientX);
        start = undefined;
        if (Math.abs(distance) > 40) choose(current + (distance < 0 ? 1 : -1));
      };
      const click = (event: Event) => {
        const dot = (event.target as HTMLElement).closest<HTMLElement>(
          '[data-slide]',
        );
        if (dot) choose(Number(dot.dataset.slide));
      };
      root.dataset.sliding = '';
      nav.hidden = false;
      show(0);
      root.addEventListener('pointerdown', down);
      root.addEventListener('pointerup', up);
      nav.addEventListener('click', click);
      return () => {
        delete root.dataset.sliding;
        nav.hidden = true;
        cards.forEach((card) => card.classList.remove('is-current'));
        root.removeEventListener('pointerdown', down);
        root.removeEventListener('pointerup', up);
        nav.removeEventListener('click', click);
      };
    });
  }

  // The phone slider for the method: once the box comes into view, each
  // card's line fills over five seconds and the next card takes its place,
  // round and round, while the numbers mark the card shown.
  function methodSlider(section: HTMLElement) {
    const cards = [...section.querySelectorAll<HTMLElement>('[data-step]')];
    const numbers = [...section.querySelectorAll<HTMLElement>('.method-step')];
    const box = section.querySelector<HTMLElement>('.method-slider');
    if (!box || cards.length < 2) return;
    gsap.matchMedia().add('(width < 48rem)', () => {
      const STEP = 5;
      let current = -1;
      const show = (index: number) => {
        if (index === current) return;
        current = index;
        [cards, numbers].forEach((items) =>
          items.forEach((item, at) =>
            item.classList.toggle('is-current', at === index),
          ),
        );
      };
      section.dataset.sliding = '';
      show(0);
      const timeline = gsap.timeline({
        paused: true,
        repeat: -1,
        onUpdate: () =>
          show(Math.min(cards.length - 1, Math.floor(timeline.time() / STEP))),
      });
      cards.forEach((card) => {
        const line = card.querySelector('[data-step-line]');
        if (line) {
          timeline.fromTo(
            line,
            { width: '0%' },
            { width: '100%', duration: STEP, ease: 'none' },
          );
        }
      });
      ScrollTrigger.create({
        trigger: box,
        start: 'top bottom',
        once: true,
        onEnter: () => timeline.play(),
      });
      return () => {
        delete section.dataset.sliding;
        [cards, numbers].forEach((items) =>
          items.forEach((item) => item.classList.remove('is-current')),
        );
      };
    });
  }

  // The code room, where the scroll checks each file in turn: the first at
  // the top, the second a third of the way through, the third at two thirds,
  // while the rail's line grows over those two thirds. A file chosen by hand
  // scrolls the room to its own stretch, so the page and the choice never
  // disagree.
  function codeSteps(section: HTMLElement) {
    const radios = [
      ...section.querySelectorAll<HTMLInputElement>('input[type="radio"]'),
    ];
    const line = section.querySelector<HTMLElement>('[data-code-line]');
    if (!line || radios.length === 0) return;
    gsap.matchMedia().add('(min-width: 62rem)', () => {
      section.dataset.scrubbing = '';
      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.8,
        },
        onUpdate: () => {
          const index = Math.min(
            radios.length - 1,
            Math.floor(timeline.progress() * radios.length),
          );
          const radio = radios[index];
          if (radio && !radio.checked) radio.checked = true;
        },
      });
      timeline
        .fromTo(
          line,
          { height: '0%' },
          { height: '100%', ease: 'none', duration: radios.length - 1 },
        )
        .to({}, { duration: 1 });
      const choose = (event: Event) => {
        const trigger = timeline.scrollTrigger;
        const index = radios.indexOf(event.target as HTMLInputElement);
        if (!trigger || index < 0) return;
        window.scrollTo({
          top:
            trigger.start +
            ((index + 0.5) / radios.length) * (trigger.end - trigger.start),
        });
      };
      radios.forEach((radio) => radio.addEventListener('change', choose));
      return () => {
        delete section.dataset.scrubbing;
        radios.forEach((radio) => radio.removeEventListener('change', choose));
      };
    });
  }

  // Inertial wheel scrolling, driven by GSAP's ticker so ScrollTrigger reads
  // the same position the page shows. Anchors keep their native jump, so the
  // skip link still moves focus; keyboard and touch scrolling stay native, and
  // a code window scrolls on its own.
  function smoothScroll() {
    const lenis = new Lenis({
      autoRaf: false,
      anchors: false,
      prevent: (node) => node.closest('pre') !== null,
    });
    lenis.on('scroll', ScrollTrigger.update);
    const tick = (time: number) => lenis.raf(time * 1000);
    gsap.ticker.add(tick);
    gsap.ticker.lagSmoothing(0);
    return () => {
      gsap.ticker.remove(tick);
      gsap.ticker.lagSmoothing(500, 33);
      lenis.destroy();
    };
  }

  function start() {
    document
      .querySelectorAll<HTMLElement>('[data-typewriter]')
      .forEach(holdForTyping);
    const cleanups = [
      ...document.querySelectorAll<HTMLElement>('[data-scramble-hover]'),
    ]
      .map(scrambleOnHover)
      .concat(smoothScroll())
      .concat(
        [...document.querySelectorAll<HTMLElement>('[data-pixel-field]')].map(
          pixelField,
        ),
      );
    // Steps first: they make their rooms taller, which moves every trigger
    // below them.
    document.querySelectorAll<HTMLElement>('[data-steps]').forEach(steps);
    document
      .querySelectorAll<HTMLElement>('[data-steps]')
      .forEach(methodSlider);
    document.querySelectorAll<HTMLElement>('[data-slider]').forEach(slider);
    document
      .querySelectorAll<HTMLElement>('[data-code-steps]')
      .forEach(codeSteps);
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach(reveal);
    ScrollTrigger.refresh();
    clearPreloader();
    // Motion switched off mid-visit. GSAP has already reverted every split and
    // tween by the time this runs, so the markup is back; restore the typed
    // fragments, lift the preloader and undo the listeners.
    return () => {
      document
        .querySelectorAll<HTMLElement>('[data-typewriter-text]')
        .forEach((element) => {
          element.textContent = element.dataset.typewriterText ?? '';
          delete element.dataset.typewriterText;
          delete element.dataset.typewriterKey;
          delete element.dataset.cursor;
        });
      document
        .querySelectorAll('[data-typewriter-line]')
        .forEach((line) =>
          line
            .querySelectorAll<HTMLElement>('[data-typewriter-ghost]')
            .forEach((ghost, at) => (ghost.hidden = at > 0)),
        );
      root.classList.remove('preloading');
      document.querySelector('[data-preloader]')?.replaceChildren();
      cleanups.forEach((cleanup) => cleanup());
    };
  }

  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let motion: gsap.Context | undefined;
  function sync() {
    const allowed = !reduce.matches && root.dataset.motion !== 'paused';
    if (allowed && !motion) motion = gsap.context(start);
    if (!allowed && motion) {
      motion.revert();
      motion = undefined;
    }
  }
  reduce.addEventListener('change', sync);
  new MutationObserver(sync).observe(root, {
    attributes: true,
    attributeFilter: ['data-motion'],
  });
  sync();
</script>
