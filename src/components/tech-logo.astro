---
import { markId, marks } from './tech-marks';
// A technology as its own mark and name, the way the master sets partner
// logos. A mark keeps its brand colour as a fill attribute, which the CSP
// allows where a style attribute would not; a brand colour too dark or too
// light to read on both papers falls back to the text colour. A technology
// with no published mark shows its name alone. The mark points at the page's
// sprite (tech-sprite.astro), which the page renders once.
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
const mark = marks.get(name);
const luminance = (hex: string) => {
  const [r = 0, g = 0, b = 0] = [0, 2, 4].map(
    (at) => parseInt(hex.slice(at, at + 2), 16) / 255,
  );
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const brand =
  mark && luminance(mark.hex) > 0.12 && luminance(mark.hex) < 0.8
    ? `#${mark.hex}`
    : undefined;
---

<span class:list={['tech-logo', className]}>
  {mark && (
    <svg
      class="tech-logo-mark"
      viewBox="0 0 24 24"
      fill={brand ?? 'currentColor'}
      aria-hidden="true"
      focusable="false"
    >
      <use href={`#${markId(name)}`} />
    </svg>
  )}
  <span class="tech-logo-name">{name}</span>
</span>

<style>
  .tech-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 500;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .tech-logo-mark {
    flex: none;
    width: 1.4em;
    height: 1.4em;
  }
</style>
