---
import PixelIcon, { type IconName } from '@/components/pixel-icon.astro';
// Two forms, whose hovers run 0.3s from a slow start.
// `solid`: a sharp ink rectangle with a square bullet; on hover the accent
// slides in behind, the bullet turns half a turn, the label steps left and
// the arrow appears. `line`: a bottom rule; on hover a 1px accent frame
// closes around it, its accent underline grows and the icon and label step
// in from the edges.
interface Props {
  href: string;
  label: string;
  variant?: 'solid' | 'line';
  icon?: IconName;
  rel?: string;
}
const {
  href,
  label,
  variant = 'solid',
  icon = 'arrow-right',
  rel,
} = Astro.props;
---

{variant === 'solid' ? (
  <a class="button" href={href} rel={rel} data-scramble-hover>
    <span class="button-dot" aria-hidden="true" />
    <span class="button-text-wrap">
      <span class="button-text" data-scramble-text>
        {label}
      </span>
      <PixelIcon name={icon} class="button-icon" />
    </span>
    <span class="button-bg" aria-hidden="true" />
  </a>
) : (
  <a class="button-line" href={href} rel={rel} data-scramble-hover>
    <PixelIcon name={icon} class="button-line-icon" />
    <span class="button-line-text" data-scramble-text>
      {label}
    </span>
    <span class="button-line-frame" aria-hidden="true" />
    <span class="button-line-bar" aria-hidden="true" />
  </a>
)}

<style>
  .button,
  .button-line {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    overflow: hidden;
  }
  .button {
    gap: 1rem;
    min-width: 10rem;
    padding: 0.5rem 1rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    transition: color 0.3s var(--ease-power1-in);
  }
  .button-dot {
    flex: none;
    width: 0.5rem;
    aspect-ratio: 1;
    background: currentColor;
    transition: transform 0.3s var(--ease-power1-in);
  }
  .button:hover .button-dot,
  .button:focus-visible .button-dot {
    transform: rotate(-180deg);
  }
  .button-text-wrap {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .button-text {
    position: relative;
    right: -1.5rem;
    transition: right 0.3s var(--ease-power1-in);
  }
  .button :global(.button-icon) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    padding: 0.2rem;
    opacity: 0;
    transition: opacity 0.3s var(--ease-power1-in);
  }
  .button-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: translateX(-100%);
    transition: transform 0.3s var(--ease-power1-in);
  }
  .button:hover,
  .button:focus-visible {
    color: var(--accent-contrast);
  }
  .button:hover .button-bg,
  .button:focus-visible .button-bg {
    transform: none;
  }
  .button:hover .button-text,
  .button:focus-visible .button-text {
    right: 0;
  }
  .button:hover :global(.button-icon),
  .button:focus-visible :global(.button-icon) {
    opacity: 1;
  }

  .button-line {
    gap: 2rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    font-weight: 500;
    overflow: visible;
    transition: color 0.3s var(--ease-power1-in);
  }
  .button-line :global(.button-line-icon),
  .button-line-text {
    transition: transform 0.3s var(--ease-power1-in);
  }
  /* The line button's icon sits in a 24px box. */
  .button-line :global(.button-line-icon) {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0.25rem;
  }
  .button-line-frame {
    position: absolute;
    inset: 0 0 -1px;
    border: 1px solid var(--accent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-power1-in);
  }
  .button-line:hover .button-line-frame,
  .button-line:focus-visible .button-line-frame {
    opacity: 1;
  }
  .button-line:hover :global(.button-line-icon),
  .button-line:focus-visible :global(.button-line-icon) {
    transform: translateX(0.5rem);
  }
  .button-line:hover .button-line-text,
  .button-line:focus-visible .button-line-text {
    transform: translateX(-0.5rem);
  }
  .button-line-bar {
    position: absolute;
    inset: auto auto -1px 0;
    width: 0;
    height: 4px;
    background: var(--accent);
    transition: width 0.3s var(--ease-power1-in);
  }
  .button-line:hover,
  .button-line:focus-visible {
    color: var(--accent);
  }
  .button-line:hover .button-line-bar,
  .button-line:focus-visible .button-line-bar {
    width: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .button,
    .button-dot,
    .button-text,
    .button :global(.button-icon),
    .button-bg,
    .button-line,
    .button-line :global(.button-line-icon),
    .button-line-text,
    .button-line-frame,
    .button-line-bar {
      transition: none;
    }
  }
</style>
