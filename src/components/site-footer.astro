---
import Logo from '@/components/logo.astro';
import PixelIcon from '@/components/pixel-icon.astro';
import { siGithub } from 'simple-icons';
import { site } from '@/config/site';
import { messages } from '@/i18n/messages';
import type { Locale } from '@/i18n/locales';
import { pagePath } from '@/i18n/routes';
// The footer grid: the first column opens with the role and the place and
// closes with the name, as wide as the column allows; the cards stand beside
// it, two over one. It holds no form, since a static site has nothing to post
// one to. Under it, a row of four: the copyright across two, the source link
// and the colophon.
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { footer, navigation, identity } = messages(locale);
const year = new Date().getFullYear();
const pages = [
  { href: pagePath('home', locale), label: navigation.home },
  { href: pagePath('experience', locale), label: navigation.experience },
  { href: pagePath('about', locale), label: navigation.about },
];
// Each profile leads with its mark: GitHub's from Simple Icons, LinkedIn's
// "in" drawn here, since Simple Icons does not carry it.
const profiles = [
  { label: 'GitHub', href: site.github, mark: siGithub.path },
  {
    label: 'LinkedIn',
    href: site.linkedin,
    mark: 'M0 0h24v24H0zM5 4.5v3.2h3.2V4.5zM5 9.5V19h3.2V9.5zm5.2 0V19h3.2v-4.9c0-1.3.5-2.3 1.9-2.3s1.6 1.1 1.6 2.3V19h3.2v-5.4c0-2.6-.9-4.4-3.8-4.4-1.5 0-2.8.7-3.4 1.7V9.5z',
  },
] as const;
---

<footer class="site-footer">
  <div class="measure">
    <div class="site-footer-grid">
      <div class="site-footer-name">
        <div class="site-footer-intro">
          <p class="site-footer-role">{identity.role}</p>
          <p class="site-footer-place">{identity.location}</p>
        </div>
        <p class="site-footer-wordmark">
          <Logo stacked />
        </p>
      </div>
      <div class="site-footer-cards">
        <nav class="site-footer-card" aria-label={footer.pages}>
          <p class="site-footer-title">{footer.pages}</p>
          <ul class="site-footer-list">
            {pages.map((page) => (
              <li>
                <a
                  class="site-footer-link"
                  href={page.href}
                  data-scramble-hover
                >
                  <span data-scramble-text>{page.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="site-footer-card">
          <p class="site-footer-title">{footer.profiles}</p>
          <ul class="site-footer-list">
            {profiles.map((profile) => (
              <li>
                <a
                  class="site-footer-profile"
                  href={profile.href}
                  rel="me"
                  data-scramble-hover
                >
                  <svg
                    class="site-footer-mark"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d={profile.mark} fill-rule="evenodd" />
                  </svg>
                  <span class="site-footer-dash" aria-hidden="true" />
                  <span data-scramble-text>{profile.label}</span>
                  <span class="site-footer-arrow" aria-hidden="true">
                    <PixelIcon name="arrow-up-right" />
                    <PixelIcon name="arrow-up-right" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="site-footer-card site-footer-contact">
          <p class="site-footer-title">{footer.contact}</p>
          <div class="site-footer-lines">
            <a class="site-footer-link" href={`mailto:${site.email}`}>
              {site.email}
            </a>
            <p class="site-footer-info">{identity.location}</p>
          </div>
        </div>
      </div>
    </div>
    <div class="site-footer-bottom">
      <p class="site-footer-copyright">
        © {year} {site.name}
      </p>
      <p class="site-footer-links">
        <a class="site-footer-source" href={site.repository}>
          {footer.source}
        </a>
      </p>
      <p class="site-footer-colophon">{footer.colophon}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
  }
  .site-footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .site-footer-name {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding: 2.5rem;
    border: 1px solid var(--line);
    border-top: none;
    container-type: inline-size;
  }
  .site-footer-intro {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .site-footer-role,
  .site-footer-place {
    margin: 0;
  }
  .site-footer-role {
    font-size: var(--text-medium);
    font-weight: 500;
    line-height: 1.3;
  }
  .site-footer-place {
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.3;
  }
  /* The name fills the column up to 32.5rem. */
  .site-footer-wordmark {
    width: 100%;
    max-width: 32.5rem;
    margin: 0;
    font-size: min(24cqi, 7.8rem);
  }
  /* The right column: its cards stand 8px apart, each drawing the rule on
     its own side, so every junction reads as a double hairline. */
  .site-footer-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .site-footer-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.5rem;
  }
  .site-footer-card:first-child {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .site-footer-card:nth-child(2) {
    border-bottom: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .site-footer-contact {
    grid-column: span 2;
    border-top: 1px solid var(--line);
  }
  .site-footer-lines {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .site-footer-title {
    margin: 0;
    font-size: var(--text-label);
    font-weight: 600;
    line-height: 1.25;
    text-transform: uppercase;
  }
  .site-footer-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer-link,
  .site-footer-profile {
    color: var(--muted);
    overflow-wrap: anywhere;
    transition: color 0.3s var(--ease-power1-out);
  }
  .site-footer-link:hover,
  .site-footer-profile:hover {
    color: var(--accent);
  }
  .site-footer-profile {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .site-footer-dash {
    flex: 1;
    border-bottom: 1px dashed var(--line);
  }
  .site-footer-mark {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    padding: 0.0625rem;
    fill: currentColor;
  }
  /* The twin arrow: on hover one steps out to the top right while its copy
     steps in from the bottom left. */
  .site-footer-arrow {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-left: -0.5rem;
    overflow: hidden;
  }
  .site-footer-arrow :global(svg) {
    position: absolute;
    inset: 0.3rem;
    transition: transform 0.3s var(--ease-power1-out);
  }
  .site-footer-arrow :global(svg:last-child) {
    transform: translate(-150%, 150%);
  }
  .site-footer-profile:hover .site-footer-arrow :global(svg:first-child),
  .site-footer-profile:focus-visible
    .site-footer-arrow
    :global(svg:first-child) {
    transform: translate(150%, -150%);
  }
  .site-footer-profile:hover .site-footer-arrow :global(svg:last-child),
  .site-footer-profile:focus-visible
    .site-footer-arrow
    :global(svg:last-child) {
    transform: none;
  }
  .site-footer-info {
    margin: 0;
    color: var(--muted);
  }
  /* The bottom row: four columns, the copyright across the first two, the
     source link in the third and the colophon at the end of the fourth. */
  .site-footer-bottom {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-block: 6.5rem 3rem;
    color: var(--faint);
    font-size: var(--text-label);
    line-height: 1.3;
  }
  .site-footer-bottom p {
    margin: 0;
  }
  .site-footer-copyright {
    grid-column: span 2;
  }
  .site-footer-colophon {
    justify-self: end;
    text-align: right;
  }
  .site-footer-source {
    color: var(--faint);
    white-space: nowrap;
    text-decoration: underline;
  }
  .site-footer-source:hover {
    color: var(--accent);
  }
  @media (width < 62rem) {
    .site-footer-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .site-footer-cards {
      border-left: 1px solid var(--line);
    }
    .site-footer-bottom {
      grid-template-columns: 1fr 1fr;
      row-gap: 2rem;
      padding-top: 4rem;
    }
    .site-footer-colophon {
      justify-self: auto;
      text-align: left;
    }
  }
  /* On a phone the cards close up, one hairline between each, and the
     bottom row stacks with the source link first. */
  @media (width < 48rem) {
    .site-footer-cards {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .site-footer-card {
      padding: 1.5rem;
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
    .site-footer-card:first-child {
      border-right: none;
    }
    .site-footer-card:nth-child(2) {
      border-bottom: none;
      border-left: none;
    }
    .site-footer-contact {
      grid-column: auto;
      border-top: 1px solid var(--line);
      border-bottom: none;
    }
    .site-footer-name {
      padding: 1.5rem;
    }
    .site-footer-role {
      font-size: 1.25rem;
    }
    .site-footer-place {
      font-size: var(--text-body);
    }
    .site-footer-wordmark {
      width: 80%;
      font-size: min(19cqi, 7.8rem);
    }
    .site-footer-bottom {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .site-footer-links {
      order: -1;
    }
  }
  @media (width < 30rem) {
    .site-footer-card,
    .site-footer-name {
      padding-inline: 1rem;
    }
    .site-footer-bottom {
      gap: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer-link,
    .site-footer-profile,
    .site-footer-arrow :global(svg) {
      transition: none;
    }
  }
</style>
