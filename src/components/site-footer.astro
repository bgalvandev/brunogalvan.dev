---
import BrandMark from '@/components/brand-mark.astro';
import { site } from '@/config/site';
import type { Locale } from '@/i18n/locales';
import { messages } from '@/i18n/messages';
interface Props {
  locale: Locale;
}
const { contact } = messages(Astro.props.locale);
const year = new Date().getFullYear();
---

<footer class="section" id="contact" aria-labelledby="contact-heading">
  <div class="measure">
    <h2 class="section-head" id="contact-heading">
      <span class="section-tag" aria-hidden="true">
        [N.07/07]
      </span>
      <span class="section-rule" aria-hidden="true"></span>
      <span class="section-name">
        <span aria-hidden="true">&gt;</span>
        {contact.heading}
      </span>
      <span class="section-rule section-rule-run" aria-hidden="true"></span>
    </h2>
    <div class="section-body">
      <p class="section-intro">{contact.intro}</p>
      <div class="contact-links">
        <a
          class="action action-primary contact-link"
          href={`mailto:${site.email}`}
        >
          <span class="action-bullet" aria-hidden="true"></span>
          {site.email}
        </a>
        <a class="action" href={site.github} rel="me">
          {contact.github}
        </a>
        <a class="action" href={site.linkedin} rel="me">
          {contact.linkedin}
        </a>
      </div>
      <div class="colophon">
        <span class="site-name">
          <BrandMark size={14} />© {year} {site.name}
        </span>
        <a class="inline-link" href={site.repository}>
          {contact.source}
        </a>
      </div>
    </div>
  </div>
</footer>
