---
// Runs before paint. Marks JavaScript as available (CSS shows the toggles from
// that flag), restores a valid saved theme and a paused-motion choice, and
// decides whether this is the first view of the session, the only one that
// opens behind the preloader. Without JavaScript none of this exists: the
// system theme applies and nothing covers the page.
---

<script is:inline>
  // A block keeps these names out of the page's global scope.
  {
    const root = document.documentElement;
    root.classList.add('js');
    try {
      const theme = localStorage.getItem('theme');
      if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
      if (localStorage.getItem('motion') === 'paused')
        root.dataset.motion = 'paused';
      const still =
        root.dataset.motion === 'paused' ||
        matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!still && !sessionStorage.getItem('preloaded')) {
        root.classList.add('preloading');
        sessionStorage.setItem('preloaded', '1');
      }
    } catch {
      // Storage can be unavailable; the system theme and a plain page remain.
    }
  }
</script>
